{
  "name": "marina-lsp",
  "displayName": "Marina Language Support",
  "description": "marina (.tsm) language support: syntax highlighting, wave file icons, live diagnostics, autocomplete and class/ghost-class hover via the marina-lsp language server",
  "version": "0.3.1",
  "publisher": "marina",
  "license": "MIT",
  "icon": "./wave-logo.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:marina"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "marina",
        "aliases": [
          "marina",
          "tsm"
        ],
        "extensions": [
          ".tsm"
        ],
        "icon": {
          "light": "./fileicons/icons/wave.svg",
          "dark": "./fileicons/icons/wave.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "marina",
        "scopeName": "source.marina",
        "path": "./syntaxes/marina.tmLanguage.json"
      }
    ],
    "iconThemes": [
      {
        "id": "marina-wave",
        "label": "Marina Wave",
        "path": "./fileicons/marina-wave-icon-theme.json"
      }
    ],
    "configuration": {
      "title": "marina",
      "properties": {
        "marina.serverPath": {
          "type": "string",
          "default": "marina-lsp",
          "description": "Path to the marina-lsp server binary (build from source: cmake -B build && cmake --build build --target marina-lsp)"
        }
      }
    }
  }
}