// parse-diff driver: lexes + parses a file with the self-hosted front-end
// (malex + mpars) and prints mast.dumpProgram (identical to Rust astdump).
use mast
use malex
use mpars
use fs

async function main() {
    let a = fs.args()
    if (a.length < 2) {
        console.log("usage: parsetest <file.tsm>")
        return
    }
    let src = await fs.readFile(a[1])
    let lr = malex.lex(src)
    if (!lr.ok) {
        console.log(`LEXERR ${lr.msg} @${lr.line}:${lr.col}`)
        return
    }
    let r = mpars.parse(lr.toks)
    if (!r.ok) {
        console.log(`PARSEERR ${r.msg} @${r.line}:${r.col}`)
        return
    }
    console.log(mast.dumpProgram(r.prog))
}
