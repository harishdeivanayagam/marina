// check-diff driver placeholder
use mast
use mpars
use malex
use mchek
use fs

async function main() {
    let a = fs.args()
    if (a.length < 2) {
        console.log("usage: chektest <file.tsm>")
        return
    }
    let src = await fs.readFile(a[1])
    let lr = malex.lex(src)
    if (!lr.ok) {
        console.log(`LEXERR ${lr.msg} @${lr.line}:${lr.col}`)
        return
    }
    let pr = mpars.parse(lr.toks)
    if (!pr.ok) {
        console.log(`PARSEERR ${pr.msg} @${pr.line}:${pr.col}`)
        return
    }
    let r = mchek.ckCheck(pr.prog)
    if (!r.ok) {
        let i = 0
        while (i < r.msgs.length) {
            console.log(`DIAG ${r.msgs[i]} @${r.dlines[i]}:${r.dcols[i]}`)
            i = i + 1
        }
        return
    }
    console.log(`OK fns=${r.fns.length} lams=${r.lambdas.length} classes=${r.classes.length}`)
}
