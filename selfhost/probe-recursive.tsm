// probe: recursive + mutually-referential class types (needed for the AST)
class Stmt {
    kind: Int32
    value: Expr
    body: Array<Stmt>
    name: string
    line: Int32
    col: Int32
}

class TPart {
    isExpr: bool
    text: string
    expr: Expr
}

class Expr {
    kind: Int32
    ival: Int32
    fval: Float64
    bval: bool
    sval: string
    op: Int32
    kids: Array<Expr>
    parts: Array<TPart>
    names: Array<string>
    line: Int32
    col: Int32
}

const K_INT = 1
const K_BIN = 2
const OP_ADD = 3

function mkInt(v: Int32, line: Int32, col: Int32): Expr {
    let e = new Expr()
    e.kind = K_INT
    e.ival = v
    e.line = line
    e.col = col
    return e
}

function mkBin(op: Int32, l: Expr, r: Expr, line: Int32, col: Int32): Expr {
    let e = new Expr()
    e.kind = K_BIN
    e.op = op
    e.kids = [l, r]
    e.line = line
    e.col = col
    return e
}

function dumpExpr(e: Expr): string {
    if (e.kind == K_INT) {
        return `Int(${e.ival})`
    }
    if (e.kind == K_BIN) {
        let l = e.kids[0]
        let r = e.kids[1]
        return `Bin(${dumpExpr(l)}, ${dumpExpr(r)})`
    }
    return "?"
}

function main() {
    let sum = mkBin(OP_ADD, mkInt(1, 1, 1), mkInt(2, 1, 5), 1, 3)
    console.log(dumpExpr(sum))

    let f = 1.5
    console.log(`f=${f} neg=${0.25}`)

    let st = new Stmt()
    st.kind = 7
    st.value = sum
    st.name = "top"
    console.log(`stmt=${st.name} inner=${dumpExpr(st.value)}`)
}