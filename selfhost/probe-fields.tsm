class Point {
    x: Int32
    y: Int32
}

class Wrap {
    label: string
    p: Point
    ps: Array<Point>
    n: Int32
}

function main() {
    let w = new Wrap()
    w.label = "w"
    let p0 = new Point()
    p0.x = 1
    w.p = p0
    let list: Array<Point> = []
    list.push(p0)
    w.ps = list
    let p1 = w.ps[0]
    p1.y = 5
    console.log(`px=${w.p.x}`)
    let py = w.ps[0].y
    console.log(`py=${py}`)
    console.log(`label=${w.label} n=${w.n}`)
}