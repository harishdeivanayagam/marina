// mgen — LLVM IR code generator for the self-hosted marina compiler
// (port of crates/marina/src/codegen.rs).
//
// Emits textual LLVM IR (.ll). Every `async` function is lowered to:
//   * `@fn.<name>`           — entry: allocates a frame + promise, runs state 0
//   * `@fn.<name>.resume`    — state machine: one block per continuation
//
// Rust enums become kind-tag Int32 constants; HashMaps become parallel
// arrays with linear scans; multi-value returns become small result classes.

use mast
use malex
use mchek

// ---------------------------------------------------------------------------
// CgTy
// ---------------------------------------------------------------------------

function cgVoid(): Int32 { return 0 }
function cgInt(): Int32 { return 1 }
function cgFloat(): Int32 { return 2 }
function cgBool(): Int32 { return 3 }
function cgStr(): Int32 { return 4 }
function cgPromise(): Int32 { return 5 }
function cgResolver(): Int32 { return 6 }
function cgArray(): Int32 { return 7 }
function cgObject(): Int32 { return 8 }
function cgStream(): Int32 { return 9 }

function cgIrOf(k: Int32): string {
    if (k == cgVoid()) { return "void" }
    if (k == cgInt()) { return "i32" }
    if (k == cgFloat()) { return "double" }
    if (k == cgBool()) { return "i1" }
    if (k == cgStream()) { return "i64" }
    return "ptr"
}

// Type used for memory slots (allocas / frame / env fields).
function cgMemOf(k: Int32): string {
    if (k == cgBool()) { return "i8" }
    return cgIrOf(k)
}

function cgIsPtr(k: Int32): bool {
    return k == cgStr() || k == cgPromise() || k == cgResolver() || k == cgArray() || k == cgObject()
}

// CgTy of a checked type.
function cgTyOfTy(t: Ty): Int32 {
    if (t.k == mchek.tvVoid()) { return cgVoid() }
    if (t.k == mchek.tvInt()) { return cgInt() }
    if (t.k == mchek.tvFloat()) { return cgFloat() }
    if (t.k == mchek.tvBool()) { return cgBool() }
    if (t.k == mchek.tvStr()) { return cgStr() }
    if (t.k == mchek.tvPromise()) { return cgPromise() }
    if (t.k == mchek.tvResolver()) { return cgResolver() }
    if (t.k == mchek.tvArray()) { return cgArray() }
    if (t.k == mchek.tvObject()) { return cgObject() }
    if (t.k == mchek.tvIface()) { return cgObject() }
    return cgStream()
}

// MValue tag for a checked type (used when creating arrays / map results).
function cgMvTagOfTy(t: Ty): Int32 {
    let k = cgTyOfTy(t)
    if (k == cgInt()) { return 1 }
    if (k == cgFloat()) { return 2 }
    if (k == cgStr()) { return 3 }
    if (k == cgBool()) { return 4 }
    if (k == cgArray()) { return 5 }
    if (k == cgObject()) { return 6 }
    if (k == cgStream()) { return 7 }
    return 1
}

function cgDefaultValue(k: Int32): string {
    if (k == cgInt()) { return "0" }
    if (k == cgFloat()) { return "0.0" }
    if (k == cgBool()) { return "false" }
    if (k == cgStream()) { return "0" }
    if (k == cgVoid()) { return "void" }
    return "null"
}

// ---------------------------------------------------------------------------
// Float formatting: reproduce Rust `{:?}` (Debug) for f64.
//
// Doubles are dyadic rationals. We recover the EXACT decimal digits:
//   value = M * 2^k'  (M a 53-bit integer)
//   k' >= 0: digits of N = M * 2^k' (an exact integer)
//   k' <  0: digits of N = M * 5^(-k'); value = N / 10^(-k')
// Bignums are little-endian base-1000 limb arrays (Int32 arithmetic stays
// well below 2^31). Shortest-round-trip digits are found by trying d = 1..17
// and parsing the candidate back with the same hand parser malex uses for
// literals, so `parse(fmt(f)) == f` is self-consistent with the checker.
// ---------------------------------------------------------------------------

// floor(x) for x in [lo, hi+1) with lo/hi Int32, via binary search
function mgFloorRange(x: Float64, lo: Int32, hi: Int32): Int32 {
    let a = lo
    let b = hi
    while (a < b) {
        let mid = (a + b + 1) / 2
        if (x >= mid * 1.0) {
            a = mid
        } else {
            b = mid - 1
        }
    }
    return a
}

// bignum: little-endian base-1000 limbs
function mgBnNew(): Array<Int32> {
    let a: Array<Int32> = []
    a.push(0)
    return a
}

// in-place: a = a * m + add   (m < 2^21, add < 2^21; base 1000 keeps
// limb*mul + carry <= 999*2097152 + 2097151 < 2^31)
function mgBnMulAdd(a: Array<Int32>, m: Int32, add: Int32): void {
    let carry = add
    let i = 0
    while (i < a.length) {
        let t = a[i] * m + carry
        a[i] = t % 1000
        carry = t / 1000
        i++
    }
    while (carry > 0) {
        a.push(carry % 1000)
        carry = carry / 1000
    }
    // strip top zero limbs
    let top = a.length - 1
    while (top > 0) {
        if (a[top] == 0) {
            a.pop()
            top = top - 1
        } else {
            top = 0
        }
    }
}

// in-place: a = a * small  (small = 2 or 5)
function mgBnMulSmall(a: Array<Int32>, small: Int32): void {
    mgBnMulAdd(a, small, 0)
}

function mgBnToString(a: Array<Int32>): string {
    let out = `${a[a.length - 1]}`
    let i = a.length - 2
    while (i >= 0) {
        let d = a[i]
        if (d < 10) {
            out = `${out}00${d}`
        } else if (d < 100) {
            out = `${out}0${d}`
        } else {
            out = `${out}${d}`
        }
        i = i - 1
    }
    return out
}

class MgdCand {
    s: string
    e: Int32
}

function mgNewCand(s: string, e: Int32): MgdCand {
    let c = new MgdCand()
    c.s = s
    c.e = e
    return c
}

// digits of |f|: significant decimal digits (no leading zeros) and exponent
// e, such that the value is d1.d2..dn x 10^e
class MgdDigits {
    digits: string
    e: Int32
}

function mgNewDigits(): MgdDigits {
    let d = new MgdDigits()
    d.digits = ""
    d.e = 0
    return d
}

function mgDigitsOf(a: Float64): MgdDigits {
    let res = mgNewDigits()
    // normalize: a = m * 2^k with m in [1, 2)
    let k = 0
    let m = a
    while (m >= 2.0) {
        m = m / 2.0
        k = k + 1
    }
    while (m < 1.0) {
        m = m * 2.0
        k = k - 1
    }
    // M = m * 2^52 (exact double), so a = M * 2^(k-52)
    let bigM = m * 4503599627370496.0
    // decompose M into Int32 chunks of 21 bits: M = hi*2^42 + mid*2^21 + lo
    let hi = mgFloorRange(bigM / 4398046511104.0, 1024, 2047)
    let rem1 = bigM - hi * 4398046511104.0
    let mid = mgFloorRange(rem1 / 2097152.0, 0, 2097151)
    let lo = mgFloorRange(rem1 - mid * 2097152.0, 0, 2097151)
    let bn = mgBnNew()
    mgBnMulAdd(bn, 2097152, hi)
    mgBnMulAdd(bn, 2097152, mid)
    mgBnMulAdd(bn, 2097152, lo)
    let kp = k - 52
    let shift = 0
    if (kp >= 0) {
        let i = 0
        while (i < kp) {
            mgBnMulSmall(bn, 2)
            i++
        }
    } else {
        shift = -kp
        let i = 0
        while (i < shift) {
            mgBnMulSmall(bn, 5)
            i++
        }
    }
    let full = mgBnToString(bn)
    // value = full / 10^shift (no leading zeros: M >= 2^52)
    res.digits = full
    res.e = full.length - shift - 1
    return res
}

// Render digits + exponent in Rust Debug style.
function mgDebugText(s: string, e: Int32): string {
    if (e >= -4 && e <= 15) {
        if (e >= 0) {
            let intLen = e + 1
            let intPart = ""
            let frac = ""
            if (s.length >= intLen) {
                intPart = s.substring(0, intLen)
                frac = s.substring(intLen, s.length)
            } else {
                intPart = s
                let z = intLen - s.length
                let i = 0
                while (i < z) {
                    intPart = `${intPart}0`
                    i++
                }
            }
            if (frac.length == 0) {
                frac = "0"
            }
            return `${intPart}.${frac}`
        }
        let zeros = -e - 1
        let zstr = ""
        let i = 0
        while (i < zeros) {
            zstr = `${zstr}0`
            i++
        }
        return `0.${zstr}${s}`
    }
    let fracPart = ""
    if (s.length > 1) {
        fracPart = `.${s.substring(1, s.length)}`
    }
    return `${s.substring(0, 1)}${fracPart}e${e}`
}

// round the digit string up at position d (keep d digits): "1999" d=1 -> "2"
// (with exponent bumped when all kept digits carry over)
function mgRoundUp(full: string, d: Int32, e: Int32): MgdCand {
    let ds = full.substring(0, d)
    let bytes: Array<Int32> = []
    let i = 0
    while (i < ds.length) {
        bytes.push(ds.charAt(i))
        i++
    }
    let pos = d - 1
    let carry = 1
    while (pos >= 0 && carry > 0) {
        let v = bytes[pos] - 48 + 1
        if (v >= 10) {
            bytes[pos] = 48
            pos = pos - 1
        } else {
            bytes[pos] = 48 + v
            carry = 0
        }
    }
    let s = ""
    if (carry > 0) {
        s = "1"
        let j = 0
        while (j < d) {
            s = `${s}0`
            j++
        }
        return mgNewCand(s, e + 1)
    }
    let j2 = 0
    while (j2 < bytes.length) {
        s = `${s}${mgDigit(bytes[j2])}`
        j2++
    }
    return mgNewCand(s, e)
}

// shortest-round-trip Debug representation of a non-negative, finite,
// non-zero double a (digits = its exact decimal digit string)
function mgShortest(a: Float64, digits: MgdDigits): string {
    let full = digits.digits
    let e = digits.e
    let found = false
    let result = ""
    let d = 1
    while (d <= 17 && d <= full.length && !found) {
        // candidate rounding UP (only when the next digit is >= 5)
        if (d < full.length) {
            if (full.charAt(d) >= 53) {
                let up = mgRoundUp(full, d, e)
                let txt = mgDebugText(up.s, up.e)
                if (malex.parseFloatHand(txt) == a) {
                    result = txt
                    found = true
                }
            }
        }
        if (!found) {
            let down = full.substring(0, d)
            let txt2 = mgDebugText(down, e)
            if (malex.parseFloatHand(txt2) == a) {
                result = txt2
                found = true
            }
        }
        d = d + 1
    }
    if (!found) {
        // last resort: keep 17 digits
        let n = full.length
        if (n > 17) {
            n = 17
        }
        result = mgDebugText(full.substring(0, n), e)
    }
    return result
}

// Rust `{:?}` for f64
function mgFmtFloat(f: Float64): string {
    if (f != f) {
        return "NaN"
    }
    if (f == 1.0 / 0.0) {
        return "inf"
    }
    if (f == -1.0 / 0.0) {
        return "-inf"
    }
    if (f == 0.0) {
        let inv = 1.0 / f
        if (inv < 0.0) {
            return "-0.0"
        }
        return "0.0"
    }
    let neg = false
    let a = f
    if (f < 0.0) {
        neg = true
        a = -f
    }
    let txt = mgShortest(a, mgDigitsOf(a))
    if (neg) {
        return `-${txt}`
    }
    return txt
}

// ---------------------------------------------------------------------------
// escape_ir_string (byte-oriented; marina strings are byte-indexed)
// ---------------------------------------------------------------------------

function mgHexTable(): string {
    return "0123456789ABCDEF"
}

function mgAsciiTable(): string {
    return " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
}

function mgDigitsTable(): string {
    return "0123456789"
}

function mgHex2(b: Int32): string {
    let hi = b / 16
    let lo = b % 16
        let hex = mgHexTable()
    return `\\${hex.substring(hi, hi + 1)}${hex.substring(lo, lo + 1)}`
}

function mgChr(b: Int32): string {
    let ascii = mgAsciiTable()
    return ascii.substring(b - 32, b - 31)
}

function mgDigit(b: Int32): string {
    let digits = mgDigitsTable()
    return digits.substring(b - 48, b - 47)
}

function mgEscapeIrString(s: string): string {
    let out = ""
    let i = 0
    while (i < s.length) {
        let b = s.charAt(i)
        if (b >= 32 && b <= 126 && b != 34 && b != 92) {
            out = `${out}${s.substring(i, i + 1)}`
        } else {
            out = `${out}${mgHex2(b)}`
        }
        i = i + 1
    }
    return out
}

// escape a byte array (class metadata: name + NUL + field names + NUL)
function mgEscapeBytes(arr: Array<Int32>): string {
    let out = ""
    let i = 0
    while (i < arr.length) {
        let b = arr[i]
        if (b >= 32 && b <= 126 && b != 34 && b != 92) {
            out = `${out}${mgChr(b)}`
        } else {
            out = `${out}${mgHex2(b)}`
        }
        i = i + 1
    }
    return out
}

// ---------------------------------------------------------------------------
// Codegen types
// ---------------------------------------------------------------------------

class CgVal {
    ty: Int32
    ir: string
    owned: bool
}

function mgNewVal(ty: Int32, ir: string, owned: bool): CgVal {
    let v = new CgVal()
    v.ty = ty
    v.ir = ir
    v.owned = owned
    return v
}

// access kinds
function accAlloca(): Int32 { return 0 }
function accFrame(): Int32 { return 1 }
function accEnv(): Int32 { return 2 }
function accGlobal(): Int32 { return 3 }

class Access {
    kind: Int32
    p: string     // alloca/global name
    idx: Int32    // frame/env slot
    ty: Int32
}

function mgNewAccess(kind: Int32, p: string, idx: Int32, ty: Int32): Access {
    let a = new Access()
    a.kind = kind
    a.p = p
    a.idx = idx
    a.ty = ty
    return a
}

class LamSlot {
    id: Int32
    ty: Ty
}

// insertion-ordered id -> Access map (release order must be deterministic)
class ScopeMap {
    ids: Array<Int32>
    accs: Array<Access>
}

function mgNewScopeMap(): ScopeMap {
    let s = new ScopeMap()
    s.ids = mast.emptyInts()
    let accs0: Array<Access> = []
    s.accs = accs0
    return s
}

function mgScopeInsert(sc: ScopeMap, id: Int32, a: Access): void {
    let i = 0
    while (i < sc.ids.length) {
        if (sc.ids[i] == id) {
            let accs = sc.accs
            accs[i] = a
            return
        }
        i = i + 1
    }
    sc.ids.push(id)
    sc.accs.push(a)
}

class AccRes {
    has: bool
    a: Access
}

function mgNewAccRes(): AccRes {
    let r = new AccRes()
    r.has = false
    return r
}

function mgScopeGet(sc: ScopeMap, id: Int32, res: AccRes): void {
    let i = 0
    while (i < sc.ids.length) {
        if (sc.ids[i] == id) {
            res.has = true
            res.a = sc.accs[i]
            return
        }
        i = i + 1
    }
}

class IrBlock {
    label: string
    lines: Array<string>
    term: string
    hasTerm: bool
}

function mgNewIrBlock(label: string): IrBlock {
    let b = new IrBlock()
    b.label = label
    let lines0: Array<string> = []
    b.lines = lines0
    b.term = ""
    b.hasTerm = false
    return b
}

class IrFn {
    name: string
    ret: string
    params: Array<string>
    allocas: Array<string>
    blocks: Array<IrBlock>
    hasFrame: bool
    frameTy: string
}

function mgNewIrFn(name: string, ret: string, params: Array<string>): IrFn {
    let f = new IrFn()
    f.name = name
    f.ret = ret
    f.params = params
    let allocas0: Array<string> = []
    f.allocas = allocas0
    f.blocks = [mgNewIrBlock("entry")]
    f.hasFrame = false
    f.frameTy = ""
    return f
}

// FrameInfo: slot 0 is the promise; gep field index == slot index
class FrameInfo {
    ty: string
    slots: Array<Int32>
    ids: Array<Int32>
    idxs: Array<Int32>
}

function mgNewFrameInfo(ty: string): FrameInfo {
    let f = new FrameInfo()
    f.ty = ty
    let slots0: Array<Int32> = []
    f.slots = slots0
    f.ids = mast.emptyInts()
    f.idxs = mast.emptyInts()
    return f
}

class EnvInfo {
    ty: string
    slotTys: Array<Int32>
    ids: Array<Int32>
    idxs: Array<Int32>
}

function mgNewEnvInfo(ty: string): EnvInfo {
    let e = new EnvInfo()
    e.ty = ty
    let slotTys0: Array<Int32> = []
    e.slotTys = slotTys0
    e.ids = mast.emptyInts()
    e.idxs = mast.emptyInts()
    return e
}

// SegEnd kinds
function seAwait(): Int32 { return 1 }
function seRetExpr(): Int32 { return 2 }
function seRetVoid(): Int32 { return 3 }
function seResolve(): Int32 { return 4 }

class Segment {
    stmts: Array<CSt>
    endKind: Int32
    endExpr: CEx
    hasTarget: bool
    targetId: Int32
    targetTy: Ty
    next: Int32
}

class Sig2 {
    ret: Int32
    ptys: Array<Int32>
    isAsync: bool
}

class Gen {
    c: ChkResult
    typeDefs: Array<string>
    envTypesDone: Array<bool>
    globals: Array<string>
    litKeys: Array<string>
    litNames: Array<string>
    sigNames: Array<string>
    sigs: Array<Sig2>
    fns: Array<IrFn>
    cur: Int32
    block: Int32
    scopes: Array<ScopeMap>
    pending: Array<string>
    hasFrame: bool
    frame: FrameInfo
    hasEnv: bool
    env: EnvInfo
    curRet: Int32
    tmp: Int32
    lbl: Int32
    lit: Int32
    varTmp: Int32
    hasLambdaOut: bool
    lambdaOut: string
    hasLambdaExit: bool
    lambdaExit: Int32
    hasLambdaRet: bool
    lambdaRet: Int32
    toplevelGen: bool
    topGIds: Array<Int32>
    topGAccs: Array<Access>
}

function mgNewGen(c: ChkResult): Gen {
    let g = new Gen()
    g.c = c
    let typeDefs0: Array<string> = []
    g.typeDefs = typeDefs0
    let envTypes0: Array<bool> = []
    g.envTypesDone = envTypes0
    let globals0: Array<string> = []
    g.globals = globals0
    g.litKeys = mast.emptyStrs()
    g.litNames = mast.emptyStrs()
    g.sigNames = mast.emptyStrs()
    let sigs0: Array<Sig2> = []
    g.sigs = sigs0
    let fns0: Array<IrFn> = []
    g.fns = fns0
    g.cur = 0
    g.block = 0
    let sc0: Array<ScopeMap> = []
    sc0.push(mgNewScopeMap())
    g.scopes = sc0
    let pending0: Array<string> = []
    g.pending = pending0
    g.hasFrame = false
    g.frame = mgNewFrameInfo("")
    g.hasEnv = false
    g.env = mgNewEnvInfo("")
    g.curRet = cgVoid()
    g.tmp = 0
    g.lbl = 0
    g.lit = 0
    g.varTmp = 1000000
    g.hasLambdaOut = false
    g.lambdaOut = ""
    g.hasLambdaExit = false
    g.lambdaExit = 0
    g.hasLambdaRet = false
    g.lambdaRet = cgVoid()
    g.toplevelGen = false
    g.topGIds = mast.emptyInts()
    let topGAccs0: Array<Access> = []
    g.topGAccs = topGAccs0
    return g
}

function mgInsertSig(g: Gen, name: string, s: Sig2): void {
    let i = 0
    while (i < g.sigNames.length) {
        if (g.sigNames[i] == name) {
            let sigs = g.sigs
            sigs[i] = s
            return
        }
        i = i + 1
    }
    g.sigNames.push(name)
    g.sigs.push(s)
}

function mgSigOf(g: Gen, name: string): Sig2 {
    let i = 0
    while (i < g.sigNames.length) {
        if (g.sigNames[i] == name) {
            return g.sigs[i]
        }
        i = i + 1
    }
    let none = new Sig2()
    none.ret = cgVoid()
    let nonePtys0: Array<Int32> = []
    none.ptys = nonePtys0
    none.isAsync = false
    return none
}

// ---------------------------------------------------------------------------
// IR building primitives
// ---------------------------------------------------------------------------

function mgFresh(g: Gen, hint: string): string {
    g.tmp = g.tmp + 1
    return `%${hint}.${g.tmp}`
}

function mgFreshVarId(g: Gen): Int32 {
    g.varTmp = g.varTmp + 1
    return g.varTmp
}

function mgPushFn(g: Gen, f: IrFn): void {
    g.fns.push(f)
    g.cur = g.fns.length - 1
    g.block = 0
    let sc0: Array<ScopeMap> = []
    sc0.push(mgNewScopeMap())
    g.scopes = sc0
    let pend: Array<string> = []
    g.pending = pend
}

function mgEmit(g: Gen, line: string): void {
    let fns = g.fns
    let fn = fns[g.cur]
    let blocks = fn.blocks
    let b = blocks[g.block]
    let lines = b.lines
    lines.push(line)
}

function mgTerm(g: Gen, line: string): void {
    let fns = g.fns
    let fn = fns[g.cur]
    let blocks = fn.blocks
    let b = blocks[g.block]
    if (!b.hasTerm) {
        b.term = line
        b.hasTerm = true
    }
}

function mgTerminated(g: Gen): bool {
    let fns = g.fns
    let fn = fns[g.cur]
    let blocks = fn.blocks
    let b = blocks[g.block]
    return b.hasTerm
}

function mgAlloca(g: Gen, ty: string): string {
    let name = mgFresh(g, "v")
    let fns = g.fns
    let fn = fns[g.cur]
    fn.allocas.push(`${name} = alloca ${ty}`)
    return name
}

function mgNewBlock(g: Gen, hint: string): Int32 {
    g.lbl = g.lbl + 1
    let fns = g.fns
    let fn = fns[g.cur]
    fn.blocks.push(mgNewIrBlock(`${hint}.${g.lbl}`))
    return fn.blocks.length - 1
}

function mgNewBlockFixed(g: Gen, label: string): Int32 {
    let fns = g.fns
    let fn = fns[g.cur]
    fn.blocks.push(mgNewIrBlock(label))
    return fn.blocks.length - 1
}

function mgSwitchBlock(g: Gen, idx: Int32): void {
    g.block = idx
}

function mgLabelOf(g: Gen, idx: Int32): string {
    let fns = g.fns
    let fn = fns[g.cur]
    let blocks = fn.blocks
    return blocks[idx].label
}

function mgBranchTo(g: Gen, idx: Int32): void {
    if (!mgTerminated(g)) {
        let label = mgLabelOf(g, idx)
        mgTerm(g, `br label %${label}`)
    }
}

function mgFlushPending(g: Gen): void {
    let names = g.pending
    let pend: Array<string> = []
    g.pending = pend
    let i = 0
    while (i < names.length) {
        mgEmit(g, `call void @marina_release(ptr ${names[i]})`)
        i = i + 1
    }
}

// ---------------------------------------------------------------------------
// Memory access
// ---------------------------------------------------------------------------

function mgSlotFor(g: Gen, id: Int32, ty: Int32): Int32 {
    let fr = g.frame
    let i = 0
    while (i < fr.ids.length) {
        if (fr.ids[i] == id) {
            return fr.idxs[i]
        }
        i = i + 1
    }
    let idx = fr.slots.length
    fr.slots.push(ty)
    fr.ids.push(id)
    fr.idxs.push(idx)
    return idx
}

function mgTopGInsert(g: Gen, id: Int32, a: Access): void {
    let i = 0
    while (i < g.topGIds.length) {
        if (g.topGIds[i] == id) {
            let accs = g.topGAccs
            accs[i] = a
            return
        }
        i = i + 1
    }
    g.topGIds.push(id)
    g.topGAccs.push(a)
}

function mgTopGGet(g: Gen, id: Int32, res: AccRes): void {
    let i = 0
    while (i < g.topGIds.length) {
        if (g.topGIds[i] == id) {
            res.has = true
            res.a = g.topGAccs[i]
            return
        }
        i = i + 1
    }
}

function mgDeclareAccess(g: Gen, id: Int32, ty: Int32): Access {
    if (g.toplevelGen) {
        // top-level variables become module globals so any function
        // (and any lambda capturing them) can read them
        let name = `@.g.${g.lit}`
        g.lit = g.lit + 1
        g.globals.push(`${name} = global ${cgMemOf(ty)} zeroinitializer`)
        let a = mgNewAccess(accGlobal(), name, 0, ty)
        mgTopGInsert(g, id, a)
        return a
    }
    if (g.hasFrame) {
        let idx = mgSlotFor(g, id, ty)
        return mgNewAccess(accFrame(), "", idx, ty)
    }
    let p = mgAlloca(g, cgMemOf(ty))
    return mgNewAccess(accAlloca(), p, 0, ty)
}

function mgAccessFor(g: Gen, id: Int32, res: AccRes): void {
    res.has = false
    // top-level variables live in globals: lambdas reading or assigning
    // them share program state instead of a by-value capture
    mgTopGGet(g, id, res)
    if (res.has) {
        return
    }
    let i = g.scopes.length - 1
    while (i >= 0) {
        let sc = g.scopes[i]
        mgScopeGet(sc, id, res)
        if (res.has) {
            return
        }
        i = i - 1
    }
    if (g.hasFrame) {
        let fr = g.frame
        let j = 0
        while (j < fr.ids.length) {
            if (fr.ids[j] == id) {
                let idx = fr.idxs[j]
                res.has = true
                res.a = mgNewAccess(accFrame(), "", idx, fr.slots[idx])
                return
            }
            j = j + 1
        }
    }
    if (g.hasEnv) {
        let en = g.env
        let j = 0
        while (j < en.ids.length) {
            if (en.ids[j] == id) {
                let idx = en.idxs[j]
                res.has = true
                res.a = mgNewAccess(accEnv(), "", idx, en.slotTys[idx])
                return
            }
            j = j + 1
        }
    }
    mgTopGGet(g, id, res)
}

// Emit a GEP instruction for an access and return its SSA name.
function mgGepSsa(g: Gen, a: Access): string {
    if (a.kind == accAlloca()) {
        return a.p
    }
    if (a.kind == accGlobal()) {
        return a.p
    }
    if (a.kind == accFrame()) {
        let fty = g.frame.ty
        let name = mgFresh(g, "gp")
        mgEmit(g, `${name} = getelementptr inbounds ${fty}, ptr %fr, i64 0, i32 ${a.idx}`)
        return name
    }
    let ety = g.env.ty
    let name = mgFresh(g, "gp")
    mgEmit(g, `${name} = getelementptr inbounds ${ety}, ptr %env, i64 0, i32 ${a.idx}`)
    return name
}

// Emit a GEP instruction addressing field `field` of an %mv value.
function mgMvField(g: Gen, a: string, field: Int32): string {
    let name = mgFresh(g, "mv")
    mgEmit(g, `${name} = getelementptr inbounds %mv, ptr ${a}, i64 0, i32 ${field}`)
    return name
}

// load an access; result in the returned CgVal (owned field unused)
function mgLoadAccess(g: Gen, a: Access): CgVal {
    let ty = a.ty
    let gep = mgGepSsa(g, a)
    let v = mgFresh(g, "ld")
    if (ty == cgBool()) {
        mgEmit(g, `${v} = load i8, ptr ${gep}`)
        let b = mgFresh(g, "bb")
        mgEmit(g, `${b} = trunc i8 ${v} to i1`)
        return mgNewVal(ty, b, false)
    }
    mgEmit(g, `${v} = load ${cgIrOf(ty)}, ptr ${gep}`)
    return mgNewVal(ty, v, false)
}

function mgStoreAccess(g: Gen, a: Access, val: string, ty: Int32): void {
    let gep = mgGepSsa(g, a)
    if (ty == cgBool()) {
        let z = mgFresh(g, "zz")
        mgEmit(g, `${z} = zext i1 ${val} to i8`)
        mgEmit(g, `store i8 ${z}, ptr ${gep}`)
        return
    }
    mgEmit(g, `store ${cgIrOf(ty)} ${val}, ptr ${gep}`)
}

// ---------------------------------------------------------------------------
// ARC helpers
// ---------------------------------------------------------------------------

function mgToOwned(g: Gen, v: CgVal): CgVal {
    if (v.owned || !cgIsPtr(v.ty)) {
        return v
    }
    let r = mgFresh(g, "rn")
    mgEmit(g, `${r} = call ptr @marina_retain(ptr ${v.ir})`)
    return mgNewVal(v.ty, r, true)
}

// Borrow for a runtime call that only reads the value. Consumes an owned
// value exactly once (the queued release) and marks it unowned, so a
// later `discard` of the same value cannot double-release it.
function mgBorrow(g: Gen, v: CgVal): string {
    if (v.owned && cgIsPtr(v.ty)) {
        g.pending.push(v.ir)
        v.owned = false
    }
    return v.ir
}

// Consume an expression whose value is discarded: release if owned.
function mgDiscard(g: Gen, v: CgVal): void {
    if (v.owned && cgIsPtr(v.ty)) {
        g.pending.push(v.ir)
    }
}

// ---------------------------------------------------------------------------
// Conversions / helpers
// ---------------------------------------------------------------------------

function mgCoerceVal(g: Gen, v: CgVal, to: Int32): CgVal {
    if (v.ty == cgInt() && to == cgFloat()) {
        let r = mgFresh(g, "cf")
        mgEmit(g, `${r} = sitofp i32 ${v.ir} to double`)
        return mgNewVal(cgFloat(), r, v.owned)
    }
    return v
}

function mgSextI64(g: Gen, v: CgVal): string {
    let r = mgFresh(g, "w")
    mgEmit(g, `${r} = sext i32 ${v.ir} to i64`)
    return r
}

function mgStringLit(g: Gen, s: string): CgVal {
    let name = ""
    let i = 0
    while (i < g.litKeys.length) {
        if (g.litKeys[i] == s) {
            name = g.litNames[i]
            i = g.litKeys.length
        } else {
            i = i + 1
        }
    }
    if (name == "") {
        name = `@.bytes.${g.lit}`
        g.lit = g.lit + 1
        let bytes = mgEscapeIrString(s)
        g.globals.push(`${name} = private constant [${s.length} x i8] c"${bytes}"`)
        g.litKeys.push(s)
        g.litNames.push(name)
    }
    let v = mgFresh(g, "st")
    mgEmit(g, `${v} = call ptr @marina_string_literal(ptr ${name}, i64 ${s.length})`)
    return mgNewVal(cgStr(), v, true)
}

// Build an %mv value on the stack from a typed value (borrows it).
function mgBuildMv(g: Gen, v: CgVal): string {
    let a = mgAlloca(g, "%mv")
    let tag = 0
    if (v.ty == cgVoid()) { tag = 0 }
    else if (v.ty == cgInt()) { tag = 1 }
    else if (v.ty == cgFloat()) { tag = 2 }
    else if (v.ty == cgStr()) { tag = 3 }
    else if (v.ty == cgBool()) { tag = 4 }
    else if (v.ty == cgArray()) { tag = 5 }
    else if (v.ty == cgObject()) { tag = 6 }
    else if (v.ty == cgStream()) { tag = 7 }
    mgEmit(g, `store i32 ${tag}, ptr ${a}`)
    let g1 = mgMvField(g, a, 1)
    mgEmit(g, `store i32 0, ptr ${g1}`)
    if (v.ty == cgInt()) {
        let x = mgSextI64(g, v)
        let g2 = mgMvField(g, a, 2)
        mgEmit(g, `store i64 ${x}, ptr ${g2}`)
    } else if (v.ty == cgStream()) {
        let g2 = mgMvField(g, a, 2)
        mgEmit(g, `store i64 ${v.ir}, ptr ${g2}`)
    } else if (v.ty == cgFloat()) {
        let g3 = mgMvField(g, a, 3)
        mgEmit(g, `store double ${v.ir}, ptr ${g3}`)
    } else if (v.ty == cgBool()) {
        let x = mgFresh(g, "bw")
        mgEmit(g, `${x} = zext i1 ${v.ir} to i64`)
        let g2 = mgMvField(g, a, 2)
        mgEmit(g, `store i64 ${x}, ptr ${g2}`)
    } else if (v.ty == cgStr()) {
        let g4 = mgMvField(g, a, 4)
        mgEmit(g, `store ptr ${v.ir}, ptr ${g4}`)
    } else if (v.ty == cgArray() || v.ty == cgObject()) {
        let g4 = mgMvField(g, a, 4)
        mgEmit(g, `store ptr ${v.ir}, ptr ${g4}`)
    }
    return a
}

// Load a typed value out of an MValue struct (alloca'd).
function mgMvLoad(g: Gen, a: string, ct: Int32): CgVal {
    if (ct == cgInt()) {
        let g2 = mgMvField(g, a, 2)
        let l = mgFresh(g, "ml")
        mgEmit(g, `${l} = load i64, ptr ${g2}`)
        let t = mgFresh(g, "mt")
        mgEmit(g, `${t} = trunc i64 ${l} to i32`)
        return mgNewVal(cgInt(), t, false)
    }
    if (ct == cgFloat()) {
        let g3 = mgMvField(g, a, 3)
        let l = mgFresh(g, "ml")
        mgEmit(g, `${l} = load double, ptr ${g3}`)
        return mgNewVal(cgFloat(), l, false)
    }
    if (ct == cgBool()) {
        let g2 = mgMvField(g, a, 2)
        let l = mgFresh(g, "ml")
        mgEmit(g, `${l} = load i64, ptr ${g2}`)
        let t = mgFresh(g, "mt")
        mgEmit(g, `${t} = trunc i64 ${l} to i1`)
        return mgNewVal(cgBool(), t, false)
    }
    if (ct == cgStream()) {
        let g2 = mgMvField(g, a, 2)
        let l = mgFresh(g, "ml")
        mgEmit(g, `${l} = load i64, ptr ${g2}`)
        return mgNewVal(cgStream(), l, false)
    }
    if (ct == cgStr() || ct == cgArray() || ct == cgObject()) {
        let g4 = mgMvField(g, a, 4)
        let l = mgFresh(g, "ml")
        mgEmit(g, `${l} = load ptr, ptr ${g4}`)
        return mgNewVal(ct, l, true)
    }
    return mgNewVal(cgVoid(), "", false)
}

// Store a typed value into an MValue struct pointed to by `dst`.
function mgWriteMvFields(g: Gen, dst: string, v: CgVal): void {
    let tag = 0
    if (v.ty == cgVoid()) { tag = 0 }
    else if (v.ty == cgInt()) { tag = 1 }
    else if (v.ty == cgFloat()) { tag = 2 }
    else if (v.ty == cgStr()) { tag = 3 }
    else if (v.ty == cgBool()) { tag = 4 }
    else if (v.ty == cgArray()) { tag = 5 }
    else if (v.ty == cgObject()) { tag = 6 }
    else if (v.ty == cgStream()) { tag = 7 }
    mgEmit(g, `store i32 ${tag}, ptr ${dst}`)
    let g1 = mgMvField(g, dst, 1)
    mgEmit(g, `store i32 0, ptr ${g1}`)
    if (v.ty == cgInt()) {
        let x = mgSextI64(g, v)
        let g2 = mgMvField(g, dst, 2)
        mgEmit(g, `store i64 ${x}, ptr ${g2}`)
    } else if (v.ty == cgStream()) {
        let g2 = mgMvField(g, dst, 2)
        mgEmit(g, `store i64 ${v.ir}, ptr ${g2}`)
    } else if (v.ty == cgFloat()) {
        let g3 = mgMvField(g, dst, 3)
        mgEmit(g, `store double ${v.ir}, ptr ${g3}`)
    } else if (v.ty == cgBool()) {
        let x = mgFresh(g, "bw")
        mgEmit(g, `${x} = zext i1 ${v.ir} to i64`)
        let g2 = mgMvField(g, dst, 2)
        mgEmit(g, `store i64 ${x}, ptr ${g2}`)
    } else if (v.ty == cgStr()) {
        let g4 = mgMvField(g, dst, 4)
        mgEmit(g, `store ptr ${v.ir}, ptr ${g4}`)
    } else if (v.ty == cgArray() || v.ty == cgObject()) {
        let g4 = mgMvField(g, dst, 4)
        mgEmit(g, `store ptr ${v.ir}, ptr ${g4}`)
    }
}

// Unpack an MValue argument (from the runtime) into a typed alloca.
function mgStoreFromMv(g: Gen, src: string, ct: Int32, dst: string): void {
    let v = ""
    if (ct == cgInt() || ct == cgBool() || ct == cgStream()) {
        let g2 = mgMvField(g, src, 2)
        let l = mgFresh(g, "pm")
        mgEmit(g, `${l} = load i64, ptr ${g2}`)
        v = l
    } else if (ct == cgFloat()) {
        let g3 = mgMvField(g, src, 3)
        let l = mgFresh(g, "pm")
        mgEmit(g, `${l} = load double, ptr ${g3}`)
        v = l
    } else if (ct == cgStr() || ct == cgArray() || ct == cgObject()) {
        let g4 = mgMvField(g, src, 4)
        let l = mgFresh(g, "pm")
        mgEmit(g, `${l} = load ptr, ptr ${g4}`)
        v = l
    }
    if (ct == cgInt()) {
        let t = mgFresh(g, "pt")
        mgEmit(g, `${t} = trunc i64 ${v} to i32`)
        mgEmit(g, `store i32 ${t}, ptr ${dst}`)
    } else if (ct == cgBool()) {
        let t = mgFresh(g, "pt")
        mgEmit(g, `${t} = trunc i64 ${v} to i1`)
        let z = mgFresh(g, "pz")
        mgEmit(g, `${z} = zext i1 ${t} to i8`)
        mgEmit(g, `store i8 ${z}, ptr ${dst}`)
    } else {
        mgEmit(g, `store ${cgIrOf(ct)} ${v}, ptr ${dst}`)
    }
}// ---------------------------------------------------------------------------
// Statements
// ---------------------------------------------------------------------------

function mgReleaseScopeVars(g: Gen): void {
    // Release every live local variable across all scopes (skips closure env
    // slots, which the generated drop function owns). Scopes iterate in
    // reverse order; accesses within a scope keep insertion order.
    let accesses: Array<Access> = []
    let i = g.scopes.length - 1
    while (i >= 0) {
        let sc = g.scopes[i]
        let j = 0
        while (j < sc.accs.length) {
            let a = sc.accs[j]
            if (a.kind != accEnv()) {
                accesses.push(a)
            }
            j = j + 1
        }
        i = i - 1
    }
    let k = 0
    while (k < accesses.length) {
        let a = accesses[k]
        // globals outlive the function — never release them
        if (a.kind != accGlobal()) {
            if (cgIsPtr(a.ty)) {
                let old = mgLoadAccess(g, a)
                mgEmit(g, `call void @marina_release(ptr ${old.ir})`)
            }
        }
        k = k + 1
    }
}

function mgPopScope(g: Gen): void {
    let sc = g.scopes[g.scopes.length - 1]
    g.scopes.pop()
    if (mgTerminated(g)) {
        return // releases were emitted by the return epilogue
    }
    let i = 0
    while (i < sc.accs.length) {
        let a = sc.accs[i]
        // globals outlive the function — never release them
        if (a.kind != accGlobal()) {
            if (cgIsPtr(a.ty)) {
                let v = mgLoadAccess(g, a)
                mgEmit(g, `call void @marina_release(ptr ${v.ir})`)
            }
        }
        i = i + 1
    }
}

// Releases every live variable of the current (sync) function, then ret.
function mgDummyEx(): CEx {
    return mchek.newCEx(mchek.ceInt())
}

function mgVoidVal(): CgVal {
    return mgNewVal(cgVoid(), "", false)
}

function mgSyncEpilogue(g: Gen, hasVal: bool, val: CgVal): void {
    mgReleaseScopeVars(g)
    mgFlushPending(g)
    if (hasVal) {
        if (val.ty == cgVoid()) {
            mgTerm(g, "ret void")
        } else {
            mgTerm(g, `ret ${cgIrOf(val.ty)} ${val.ir}`)
        }
    } else {
        if (g.curRet == cgVoid()) {
            mgTerm(g, "ret void")
        } else {
            mgTerm(g, `ret ${cgIrOf(g.curRet)} ${cgDefaultValue(g.curRet)}`)
        }
    }
}

// Terminate an async continuation: resolve this function's promise,
// release every frame slot, free the frame.
function mgFinishAsync(g: Gen, hasVal: bool, val: CgVal): void {
    let mv = ""
    if (hasVal) {
        let borrowed = mgBorrow(g, val)
        mv = mgAlloca(g, "%mv")
        mgCopyMv(g, borrowed, val.ty, mv)
    } else {
        mv = mgAlloca(g, "%mv")
        mgEmit(g, `store i32 0, ptr ${mv}`)
        let g1 = mgMvField(g, mv, 1)
        mgEmit(g, `store i32 0, ptr ${g1}`)
    }
    let fracc = mgNewAccess(accFrame(), "", 0, cgPromise())
    let pr = mgLoadAccess(g, fracc)
    mgEmit(g, `call void @marina_promise_resolve(ptr ${pr.ir}, ptr ${mv})`)
    mgFlushPending(g)
    mgReleaseAllFrameSlots(g)
    mgEmit(g, "call void @marina_frame_free(ptr %fr)")
    mgTerm(g, "ret void")
}

function mgCopyMv(g: Gen, val: string, ty: Int32, a: string): void {
    if (ty == cgInt()) {
        let iv = mgNewVal(cgInt(), val, false)
        let x = mgSextI64(g, iv)
        let g2 = mgMvField(g, a, 2)
        mgEmit(g, `store i64 ${x}, ptr ${g2}`)
        mgEmit(g, `store i32 1, ptr ${a}`)
    } else if (ty == cgFloat()) {
        let g3 = mgMvField(g, a, 3)
        mgEmit(g, `store double ${val}, ptr ${g3}`)
        mgEmit(g, `store i32 2, ptr ${a}`)
    } else if (ty == cgBool()) {
        let x = mgFresh(g, "bw")
        mgEmit(g, `${x} = zext i1 ${val} to i64`)
        let g2 = mgMvField(g, a, 2)
        mgEmit(g, `store i64 ${x}, ptr ${g2}`)
        mgEmit(g, `store i32 4, ptr ${a}`)
    } else if (ty == cgStr()) {
        let g4 = mgMvField(g, a, 4)
        mgEmit(g, `store ptr ${val}, ptr ${g4}`)
        mgEmit(g, `store i32 3, ptr ${a}`)
    } else {
        mgEmit(g, `store i32 0, ptr ${a}`)
    }
}

function mgReleaseAllFrameSlots(g: Gen): void {
    let slots = g.frame.slots
    let i = 0
    while (i < slots.length) {
        let ty = slots[i]
        if (cgIsPtr(ty)) {
            let a = mgNewAccess(accFrame(), "", i, ty)
            let v = mgLoadAccess(g, a)
            mgEmit(g, `call void @marina_release(ptr ${v.ir})`)
        }
        i = i + 1
    }
}

function mgCgStmt(g: Gen, s: CSt): void {
    if (s.k == mchek.csLet()) {
        let cg = cgTyOfTy(s.ty)
        let v = mgCgExpr(g, s.e1)
        v = mgCoerceVal(g, v, cg)
        v = mgToOwned(g, v)
        let a = mgDeclareAccess(g, s.id, cg)
        mgStoreAccess(g, a, v.ir, cg)
        let last = g.scopes[g.scopes.length - 1]
        mgScopeInsert(last, s.id, a)
    } else if (s.k == mchek.csAssign()) {
        let ar = mgNewAccRes()
        mgAccessFor(g, s.id, ar)
        let a = ar.a
        let ty = a.ty
        let v = mgCgExpr(g, s.e1)
        v = mgCoerceVal(g, v, ty)
        v = mgToOwned(g, v)
        if (cgIsPtr(ty)) {
            let old = mgLoadAccess(g, a)
            mgEmit(g, `call void @marina_release(ptr ${old.ir})`)
        }
        mgStoreAccess(g, a, v.ir, ty)
    } else if (s.k == mchek.csIndexSet()) {
        let ar = mgNewAccRes()
        mgAccessFor(g, s.id, ar)
        let a = ar.a
        let arr = mgLoadAccess(g, a)
        let iv = mgCgExpr(g, s.e1)
        let i = mgSextI64(g, iv)
        let vv = mgCgExpr(g, s.e2)
        vv = mgCoerceVal(g, vv, cgTyOfTy(s.ty))
        vv = mgToOwned(g, vv)
        let mv = mgBuildMv(g, vv)
        mgEmit(g, `call void @marina_array_set(ptr ${arr.ir}, i64 ${i}, ptr ${mv})`)
        mgDiscard(g, vv)
    } else if (s.k == mchek.csFieldSet()) {
        let ar = mgNewAccRes()
        mgAccessFor(g, s.id, ar)
        let a = ar.a
        let obj = mgLoadAccess(g, a)
        let vv = mgCgExpr(g, s.e1)
        vv = mgCoerceVal(g, vv, cgTyOfTy(s.ty))
        vv = mgToOwned(g, vv)
        let mv = mgBuildMv(g, vv)
        mgEmit(g, `call void @marina_object_set(ptr ${obj.ir}, i64 ${s.retKind}, ptr ${mv})`)
        mgDiscard(g, vv)
    } else if (s.k == mchek.csIfaceSet()) {
        // interface-typed values resolve fields by name at runtime
        let ar = mgNewAccRes()
        mgAccessFor(g, s.id, ar)
        let a = ar.a
        let obj = mgLoadAccess(g, a)
        let vv = mgCgExpr(g, s.e1)
        vv = mgCoerceVal(g, vv, cgTyOfTy(s.ty))
        vv = mgToOwned(g, vv)
        let sv = mgStringLit(g, s.fname)
        let nmv = mgBuildMv(g, sv)
        let mv = mgBuildMv(g, vv)
        mgEmit(g, `call void @marina_object_set_field(ptr ${obj.ir}, ptr ${nmv}, ptr ${mv})`)
        mgDiscard(g, vv)
        mgDiscard(g, sv)
    } else if (s.k == mchek.csIf()) {
        let c = mgCgExpr(g, s.e1)
        let thenB = mgNewBlock(g, "if.then")
        let elseB = mgNewBlock(g, "if.else")
        let endB = mgNewBlock(g, "if.end")
        let tl = mgLabelOf(g, thenB)
        let el = mgLabelOf(g, elseB)
        mgTerm(g, `br i1 ${c.ir}, label %${tl}, label %${el}`)
        mgSwitchBlock(g, thenB)
        g.scopes.push(mgNewScopeMap())
        mgCgBody(g, s.body)
        mgPopScope(g)
        mgBranchTo(g, endB)
        mgSwitchBlock(g, elseB)
        g.scopes.push(mgNewScopeMap())
        if (s.els.length > 0) {
            mgCgBody(g, s.els)
        }
        mgPopScope(g)
        mgBranchTo(g, endB)
        mgSwitchBlock(g, endB)
    } else if (s.k == mchek.csWhile()) {
        let condB = mgNewBlock(g, "while.cond")
        let bodyB = mgNewBlock(g, "while.body")
        let endB = mgNewBlock(g, "while.end")
        mgBranchTo(g, condB)
        mgSwitchBlock(g, condB)
        let c = mgCgExpr(g, s.e1)
        let bl = mgLabelOf(g, bodyB)
        let el = mgLabelOf(g, endB)
        mgTerm(g, `br i1 ${c.ir}, label %${bl}, label %${el}`)
        mgSwitchBlock(g, bodyB)
        g.scopes.push(mgNewScopeMap())
        mgCgBody(g, s.body)
        mgPopScope(g)
        mgBranchTo(g, condB)
        mgSwitchBlock(g, endB)
    } else if (s.k == mchek.csFor()) {
        // scope holding the init variable(s)
        g.scopes.push(mgNewScopeMap())
        if (s.hasS1) {
            let initArr: Array<CSt> = []
            initArr.push(s.s1)
            mgCgBody(g, initArr)
        }
        let condB = mgNewBlock(g, "for.cond")
        let bodyB = mgNewBlock(g, "for.body")
        let endB = mgNewBlock(g, "for.end")
        mgBranchTo(g, condB)
        mgSwitchBlock(g, condB)
        let c = mgCgExpr(g, s.e1)
        let bl = mgLabelOf(g, bodyB)
        let el = mgLabelOf(g, endB)
        mgTerm(g, `br i1 ${c.ir}, label %${bl}, label %${el}`)
        mgSwitchBlock(g, bodyB)
        g.scopes.push(mgNewScopeMap())
        mgCgBody(g, s.body)
        mgPopScope(g)
        if (s.hasS2) {
            let updArr: Array<CSt> = []
            updArr.push(s.s2)
            mgCgBody(g, updArr)
        }
        mgBranchTo(g, condB)
        mgSwitchBlock(g, endB)
        mgPopScope(g)
    } else if (s.k == mchek.csReturn()) {
        // callback-lambda `return`: write result into the %out MValue
        // param (or a void tag) and jump to the lambda exit block
        if (g.hasLambdaOut) {
            let out = g.lambdaOut
            let rt = cgVoid()
            if (g.hasLambdaRet) {
                rt = g.lambdaRet
            }
            if (s.hasE1) {
                let v = mgCgExpr(g, s.e1)
                v = mgCoerceVal(g, v, rt)
                mgWriteMvFields(g, out, v)
                mgDiscard(g, v)
            } else {
                let voidVal = mgNewVal(cgVoid(), "null", false)
                mgWriteMvFields(g, out, voidVal)
            }
            mgFlushPending(g)
            mgReleaseScopeVars(g)
            let exitLbl = mgLabelOf(g, g.lambdaExit)
            mgTerm(g, `br label %${exitLbl}`)
            return
        }
        let isAsync = g.hasFrame
        if (s.hasE1) {
            if (s.retKind == mchek.rkFlatten()) {
                // FlattenPromise at nested depth is rejected by the
                // checker; treat defensively as a plain value.
                let v = mgCgExpr(g, s.e1)
                if (isAsync) {
                    mgFinishAsync(g, true, v)
                }
            } else {
                let v = mgCgExpr(g, s.e1)
                v = mgCoerceVal(g, v, g.curRet)
                if (isAsync) {
                    mgFinishAsync(g, true, v)
                } else if (g.curRet == cgVoid()) {
                    mgDiscard(g, v)
                    mgSyncEpilogue(g, false, v)
                } else {
                    v = mgToOwned(g, v)
                    mgSyncEpilogue(g, true, v)
                }
            }
        } else {
            if (isAsync) {
                mgFinishAsync(g, false, mgVoidVal())
            } else {
                mgSyncEpilogue(g, false, mgVoidVal())
            }
        }
    } else if (s.k == mchek.csExpr()) {
        let v = mgCgExpr(g, s.e1)
        mgDiscard(g, v)
    }
    mgFlushPending(g)
}

function mgCgBody(g: Gen, stmts: Array<CSt>): void {
    let i = 0
    while (i < stmts.length) {
        if (mgTerminated(g)) {
            // unreachable statements after return
            i = stmts.length
        } else {
            mgCgStmt(g, stmts[i])
            i = i + 1
        }
    }
}

// ---------------------------------------------------------------------------
// Expressions
// ---------------------------------------------------------------------------

// best-effort static type of a checked expression, used to find the element
// type of an array expression (push/unshift)
class MgdElem {
    has: bool
    ty: Ty
}

function mgNewElem(): MgdElem {
    let e = new MgdElem()
    e.has = false
    e.ty = mchek.mkTy(mchek.tvVoid())
    return e
}

function mgCexprElem(arr: CEx): MgdElem {
    let res = mgNewElem()
    let k = arr.k
    if (k == mchek.ceIdent() || k == mchek.ceUnary() || k == mchek.ceBinary() || k == mchek.ceCallFn() || k == mchek.ceCallResolver() || k == mchek.ceAwait() || k == mchek.ceIndex() || k == mchek.ceArrayOp() || k == mchek.ceArrayHof()) {
        res.has = true
        res.ty = arr.ty
    } else if (k == mchek.ceArrayLit()) {
        res.has = true
        res.ty = mchek.mkArrayTy(arr.ty)
    }
    // unwrap one Array level (matches the Rust option+match)
    if (res.has) {
        if (res.ty.k == mchek.tvArray()) {
            res.ty = res.ty.elem
        }
    }
    return res
}

function mgCgExpr(g: Gen, e: CEx): CgVal {
    let k = e.k
    if (k == mchek.ceInt()) {
        return mgNewVal(cgInt(), `${e.ival}`, false)
    }
    if (k == mchek.ceFloat()) {
        return mgNewVal(cgFloat(), mgFmtFloat(e.fval), false)
    }
    if (k == mchek.ceBool()) {
        let b = "0"
        if (e.bval) {
            b = "1"
        }
        return mgNewVal(cgBool(), b, false)
    }
    if (k == mchek.ceStr()) {
        return mgStringLit(g, e.sval)
    }
    if (k == mchek.ceIdent()) {
        let ar = mgNewAccRes()
        mgAccessFor(g, e.id, ar)
        let a = ar.a
        let v = mgLoadAccess(g, a)
        return mgNewVal(cgTyOfTy(e.ty), v.ir, false)
    }
    if (k == mchek.ceTemplate()) {
        let acc = mgStringLit(g, "")
        let i = 0
        while (i < e.parts.length) {
            let p = e.parts[i]
            let s = mgNewVal(cgStr(), "", true)
            if (!p.isExpr) {
                s = mgStringLit(g, p.t)
            } else {
                let v = mgCgExpr(g, p.e)
                let mv = mgBuildMv(g, v)
                let sv = mgFresh(g, "ts")
                mgEmit(g, `${sv} = call ptr @marina_to_string(ptr ${mv})`)
                s = mgNewVal(cgStr(), sv, true)
            }
            let a = mgBorrow(g, acc)
            let b = mgBorrow(g, s)
            let t = mgFresh(g, "cc")
            mgEmit(g, `${t} = call ptr @marina_string_concat(ptr ${a}, ptr ${b})`)
            acc = mgNewVal(cgStr(), t, true)
            i = i + 1
        }
        return acc
    }
    if (k == mchek.ceUnary()) {
        let v = mgCgExpr(g, e.kids[0])
        let r = mgFresh(g, "un")
        let ct = cgTyOfTy(e.ty)
        if (e.opv == mchek.ucNeg() && ct == cgInt()) {
            mgEmit(g, `${r} = sub i32 0, ${v.ir}`)
            return mgNewVal(cgInt(), r, false)
        }
        if (e.opv == mchek.ucNeg() && ct == cgFloat()) {
            mgEmit(g, `${r} = fneg double ${v.ir}`)
            return mgNewVal(cgFloat(), r, false)
        }
        // Not
        mgEmit(g, `${r} = xor i1 ${v.ir}, true`)
        return mgNewVal(cgBool(), r, false)
    }
    if (k == mchek.ceBinary()) {
        return mgCgBinary(g, e)
    }
    if (k == mchek.ceCallFn()) {
        return mgCgCallFn(g, e)
    }
    if (k == mchek.ceCallResolver()) {
        let ar = mgNewAccRes()
        mgAccessFor(g, e.id, ar)
        let a = ar.a
        let p = mgLoadAccess(g, a)
        let v = mgCgExpr(g, e.kids[0])
        v = mgCoerceVal(g, v, cgTyOfTy(e.ty))
        let mv = mgBuildMv(g, v)
        mgEmit(g, `call void @marina_promise_resolve(ptr ${p.ir}, ptr ${mv})`)
        return mgNewVal(cgVoid(), "", false)
    }
    if (k == mchek.ceNewPromise()) {
        let pr = mgFresh(g, "pn")
        mgEmit(g, `${pr} = call ptr @marina_promise_create()`)
        let env = mgBuildEnv(g, e.id, true, pr)
        let own = mgFresh(g, "po")
        mgEmit(g, `${own} = call ptr @marina_promise_run_executor(ptr ${pr}, ptr @lambda.${e.id}, ptr ${env}, ptr @lambda.${e.id}.drop)`)
        return mgNewVal(cgPromise(), own, true)
    }
    if (k == mchek.ceConsoleLog()) {
        let v = mgCgExpr(g, e.kids[0])
        let mv = mgBuildMv(g, v)
        mgEmit(g, `call void @marina_print(ptr ${mv})`)
        return mgNewVal(cgVoid(), "", false)
    }
    if (k == mchek.ceSetTimeout()) {
        let env = mgBuildEnv(g, e.id, false, "")
        let m = mgCgExpr(g, e.kids[0])
        let m64 = mgSextI64(g, m)
        mgEmit(g, `call void @marina_set_timeout(ptr @lambda.${e.id}, ptr ${env}, ptr @lambda.${e.id}.drop, i64 ${m64})`)
        return mgNewVal(cgVoid(), "", false)
    }
    if (k == mchek.ceArrayLit()) {
        let tag = cgMvTagOfTy(e.ty)
        let arr = mgFresh(g, "arr")
        mgEmit(g, `${arr} = call ptr @marina_array_new(i32 ${tag})`)
        let ect = cgTyOfTy(e.ty)
        let i = 0
        while (i < e.args.length) {
            let v = mgCgExpr(g, e.args[i])
            v = mgCoerceVal(g, v, ect)
            v = mgToOwned(g, v)
            let mv = mgBuildMv(g, v)
            mgEmit(g, `call i64 @marina_array_push(ptr ${arr}, ptr ${mv})`)
            mgDiscard(g, v)
            i = i + 1
        }
        return mgNewVal(cgArray(), arr, true)
    }
    if (k == mchek.ceIndex()) {
        let o = mgCgExpr(g, e.kids[0])
        let p = mgBorrow(g, o)
        let iv = mgCgExpr(g, e.kids[1])
        let i = mgSextI64(g, iv)
        let out = mgAlloca(g, "%mv")
        mgEmit(g, `call void @marina_array_get(ptr ${p}, i64 ${i}, ptr ${out})`)
        let v = mgMvLoad(g, out, cgTyOfTy(e.ty))
        mgDiscard(g, o)
        return v
    }
    if (k == mchek.ceArrayOp()) {
        return mgCgArrayOp(g, e)
    }
    if (k == mchek.ceArrayHof()) {
        return mgCgArrayHof(g, e)
    }
    if (k == mchek.ceStrLen()) {
        let s = mgCgExpr(g, e.kids[0])
        let p = mgBorrow(g, s)
        let n = mgFresh(g, "sl")
        mgEmit(g, `${n} = call i64 @marina_string_len(ptr ${p})`)
        let t = mgFresh(g, "slt")
        mgEmit(g, `${t} = trunc i64 ${n} to i32`)
        mgDiscard(g, s)
        return mgNewVal(cgInt(), t, false)
    }
    if (k == mchek.ceStrMethod()) {
        let s = mgCgExpr(g, e.kids[0])
        let p = mgBorrow(g, s)
        let v = mgNewVal(cgInt(), "", false)
        if (e.opv == mchek.smCharAt()) {
            let iv = mgCgExpr(g, e.args[0])
            let i = mgSextI64(g, iv)
            let n = mgFresh(g, "sc")
            mgEmit(g, `${n} = call i64 @marina_string_charcode_at(ptr ${p}, i64 ${i})`)
            let t = mgFresh(g, "sct")
            mgEmit(g, `${t} = trunc i64 ${n} to i32`)
            v = mgNewVal(cgInt(), t, false)
        } else {
            let av = mgCgExpr(g, e.args[0])
            let a = mgSextI64(g, av)
            let bv = mgCgExpr(g, e.args[1])
            let b = mgSextI64(g, bv)
            let r = mgFresh(g, "ss")
            mgEmit(g, `${r} = call ptr @marina_string_substring(ptr ${p}, i64 ${a}, i64 ${b})`)
            v = mgNewVal(cgStr(), r, true)
        }
        // borrow already queued the string's single release
        return v
    }
    if (k == mchek.ceFsArgs()) {
        let r = mgFresh(g, "arg")
        mgEmit(g, `${r} = call ptr @marina_args()`)
        return mgNewVal(cgArray(), r, true)
    }
    if (k == mchek.ceObjectLit()) {
        let cid = e.id
        let def = g.c.classes[cid]
        let n = def.fnames.length
        let obj = mgFresh(g, "obj")
        mgEmit(g, `${obj} = call ptr @marina_object_new(i32 ${cid}, i64 ${n})`)
        let i = 0
        while (i < e.args.length) {
            let idx = e.iidx[i]
            let fty = def.ftys[idx]
            let v = mgCgExpr(g, e.args[i])
            v = mgCoerceVal(g, v, cgTyOfTy(fty))
            v = mgToOwned(g, v)
            let mv = mgBuildMv(g, v)
            mgEmit(g, `call void @marina_object_set(ptr ${obj}, i64 ${idx}, ptr ${mv})`)
            mgDiscard(g, v)
            i = i + 1
        }
        return mgNewVal(cgObject(), obj, true)
    }
    if (k == mchek.ceNewClass()) {
        let cid = e.id
        let def = g.c.classes[cid]
        let n = def.fnames.length
        let obj = mgFresh(g, "obj")
        mgEmit(g, `${obj} = call ptr @marina_object_new(i32 ${cid}, i64 ${n})`)
        return mgNewVal(cgObject(), obj, true)
    }
    if (k == mchek.ceFieldGet()) {
        let o = mgCgExpr(g, e.kids[0])
        let p = mgBorrow(g, o)
        let out = mgAlloca(g, "%mv")
        mgEmit(g, `call void @marina_object_get(ptr ${p}, i64 ${e.id}, ptr ${out})`)
        let v = mgMvLoad(g, out, cgTyOfTy(e.ty))
        mgDiscard(g, o)
        return v
    }
    if (k == mchek.ceIfaceGet()) {
        // interface-typed values resolve fields by name at runtime
        let o = mgCgExpr(g, e.kids[0])
        let p = mgBorrow(g, o)
        let sv = mgStringLit(g, e.sval)
        let nmv = mgBuildMv(g, sv)
        let out = mgAlloca(g, "%mv")
        mgEmit(g, `call void @marina_object_get_field(ptr ${p}, ptr ${nmv}, ptr ${out})`)
        let v = mgMvLoad(g, out, cgTyOfTy(e.ty))
        mgDiscard(g, sv)
        mgDiscard(g, o)
        return v
    }
    if (k == mchek.ceFsReadFile()) {
        let p = mgCgExpr(g, e.kids[0])
        let pmv = mgBuildMv(g, p)
        let pr = mgFresh(g, "pr")
        mgEmit(g, `${pr} = call ptr @marina_fs_read_file_async(ptr ${pmv})`)
        return mgNewVal(cgPromise(), pr, true)
    }
    if (k == mchek.ceFsWriteFile()) {
        let p = mgCgExpr(g, e.kids[0])
        let pmv = mgBuildMv(g, p)
        let d = mgCgExpr(g, e.kids[1])
        let dmv = mgBuildMv(g, d)
        let pr = mgFresh(g, "pr")
        mgEmit(g, `${pr} = call ptr @marina_fs_write_file_async(ptr ${pmv}, ptr ${dmv})`)
        mgDiscard(g, d)
        return mgNewVal(cgPromise(), pr, true)
    }
    if (k == mchek.ceFsExists()) {
        let p = mgCgExpr(g, e.kids[0])
        let pmv = mgBuildMv(g, p)
        let pr = mgFresh(g, "pr")
        mgEmit(g, `${pr} = call ptr @marina_fs_exists_async(ptr ${pmv})`)
        return mgNewVal(cgPromise(), pr, true)
    }
    if (k == mchek.ceFsReadDir()) {
        let p = mgCgExpr(g, e.kids[0])
        let pmv = mgBuildMv(g, p)
        let pr = mgFresh(g, "pr")
        mgEmit(g, `${pr} = call ptr @marina_fs_read_dir_async(ptr ${pmv})`)
        return mgNewVal(cgPromise(), pr, true)
    }
    if (k == mchek.ceFsMkdir()) {
        let p = mgCgExpr(g, e.kids[0])
        let pmv = mgBuildMv(g, p)
        let pr = mgFresh(g, "pr")
        mgEmit(g, `${pr} = call ptr @marina_fs_mkdir_async(ptr ${pmv})`)
        return mgNewVal(cgPromise(), pr, true)
    }
    if (k == mchek.ceFsRemove()) {
        let p = mgCgExpr(g, e.kids[0])
        let pmv = mgBuildMv(g, p)
        let pr = mgFresh(g, "pr")
        mgEmit(g, `${pr} = call ptr @marina_fs_remove_async(ptr ${pmv})`)
        return mgNewVal(cgPromise(), pr, true)
    }
    if (k == mchek.ceCryptoSha256()) {
        let d = mgCgExpr(g, e.kids[0])
        let dmv = mgBuildMv(g, d)
        let out = mgAlloca(g, "%mv")
        mgEmit(g, `call void @marina_crypto_sha256(ptr ${dmv}, ptr ${out})`)
        mgDiscard(g, d)
        return mgMvLoad(g, out, cgStr())
    }
    if (k == mchek.ceCryptoBase64()) {
        let d = mgCgExpr(g, e.kids[0])
        let dmv = mgBuildMv(g, d)
        let out = mgAlloca(g, "%mv")
        let flag = "false"
        if (e.ex) {
            flag = "true"
        }
        mgEmit(g, `call void @marina_crypto_base64(i1 ${flag}, ptr ${dmv}, ptr ${out})`)
        mgDiscard(g, d)
        return mgMvLoad(g, out, cgStr())
    }
    if (k == mchek.ceCryptoRandomHex()) {
        let b = mgCgExpr(g, e.kids[0])
        let n = mgFresh(g, "nb")
        mgEmit(g, `${n} = sext i32 ${b.ir} to i64`)
        let out = mgAlloca(g, "%mv")
        mgEmit(g, `call void @marina_crypto_random_hex(i64 ${n}, ptr ${out})`)
        mgDiscard(g, b)
        return mgMvLoad(g, out, cgStr())
    }
    if (k == mchek.ceCryptoUuid()) {
        let out = mgAlloca(g, "%mv")
        mgEmit(g, `call void @marina_crypto_uuid(ptr ${out})`)
        return mgMvLoad(g, out, cgStr())
    }
    if (k == mchek.ceIfaceSet()) {
        // never generated (interface writes are statements)
        return mgNewVal(cgVoid(), "", false)
    }
    if (k == mchek.ceAwait()) {
        // await is handled by the segment transform
        return mgNewVal(cgVoid(), "", false)
    }
    if (k == mchek.ceLambdaVal()) {
        // lambda values are consumed by call sites
        return mgNewVal(cgVoid(), "", false)
    }
    return mgNewVal(cgVoid(), "", false)
}

function mgCgBinary(g: Gen, e: CEx): CgVal {
    let res = cgTyOfTy(e.ty)
    let l = e.kids[0]
    let r = e.kids[1]
    let lv = mgCgExpr(g, l)
    let rv = mgCgExpr(g, r)
    let op = e.opv
    // string equality/inequality goes through the runtime helper
    if ((op == mchek.bcEq() || op == mchek.bcNeq()) && lv.ty == cgStr() && rv.ty == cgStr()) {
        let amv = mgBuildMv(g, lv)
        let bmv = mgBuildMv(g, rv)
        let out = mgFresh(g, "bc")
        mgEmit(g, `${out} = call i1 @marina_str_eq(ptr ${amv}, ptr ${bmv})`)
        if (op == mchek.bcNeq()) {
            let nx = mgFresh(g, "bc")
            mgEmit(g, `${nx} = xor i1 ${out}, 1`)
            return mgNewVal(cgBool(), nx, false)
        }
        return mgNewVal(cgBool(), out, false)
    }
    lv = mgCoerceVal(g, lv, res)
    rv = mgCoerceVal(g, rv, res)
    if (op == mchek.bcAnd()) {
        let out = mgFresh(g, "bd")
        mgEmit(g, `${out} = and i1 ${lv.ir}, ${rv.ir}`)
        return mgNewVal(cgBool(), out, false)
    }
    if (op == mchek.bcOr()) {
        let out = mgFresh(g, "bd")
        mgEmit(g, `${out} = or i1 ${lv.ir}, ${rv.ir}`)
        return mgNewVal(cgBool(), out, false)
    }
    if (op == mchek.bcLt() || op == mchek.bcGt() || op == mchek.bcLe() || op == mchek.bcGe() || op == mchek.bcEq() || op == mchek.bcNeq()) {
        // operands must share a numeric type: widen Int to Float when either
        // side is Float (the comparison's own CgTy is Bool)
        let cmpCg = cgInt()
        if (lv.ty == cgFloat() || rv.ty == cgFloat()) {
            cmpCg = cgFloat()
        }
        lv = mgCoerceVal(g, lv, cmpCg)
        rv = mgCoerceVal(g, rv, cmpCg)
        let cmpTy = "i32"
        if (cmpCg == cgFloat()) {
            cmpTy = "double"
        }
        let pred = ""
        if (op == mchek.bcLt() && cmpTy == "i32") { pred = "slt" }
        else if (op == mchek.bcLt()) { pred = "olt" }
        else if (op == mchek.bcGt() && cmpTy == "i32") { pred = "sgt" }
        else if (op == mchek.bcGt()) { pred = "ogt" }
        else if (op == mchek.bcLe() && cmpTy == "i32") { pred = "sle" }
        else if (op == mchek.bcLe()) { pred = "ole" }
        else if (op == mchek.bcGe() && cmpTy == "i32") { pred = "sge" }
        else if (op == mchek.bcGe()) { pred = "oge" }
        else if (op == mchek.bcEq() && cmpTy == "i32") { pred = "eq" }
        else if (op == mchek.bcEq()) { pred = "oeq" }
        else if (op == mchek.bcNeq() && cmpTy == "i32") { pred = "ne" }
        else { pred = "one" }
        let out = mgFresh(g, "bc")
        let mnemonic = "icmp"
        if (cmpTy == "double") {
            mnemonic = "fcmp"
        }
        mgEmit(g, `${out} = ${mnemonic} ${pred} ${cmpTy} ${lv.ir}, ${rv.ir}`)
        return mgNewVal(cgBool(), out, false)
    }
    let out = mgFresh(g, "ba")
    if (res == cgInt() && op == mchek.bcAdd()) { mgEmit(g, `${out} = add i32 ${lv.ir}, ${rv.ir}`) }
    else if (res == cgInt() && op == mchek.bcSub()) { mgEmit(g, `${out} = sub i32 ${lv.ir}, ${rv.ir}`) }
    else if (res == cgInt() && op == mchek.bcMul()) { mgEmit(g, `${out} = mul i32 ${lv.ir}, ${rv.ir}`) }
    else if (res == cgInt() && op == mchek.bcDiv()) { mgEmit(g, `${out} = sdiv i32 ${lv.ir}, ${rv.ir}`) }
    else if (res == cgInt() && op == mchek.bcMod()) { mgEmit(g, `${out} = srem i32 ${lv.ir}, ${rv.ir}`) }
    else if (res == cgFloat() && op == mchek.bcAdd()) { mgEmit(g, `${out} = fadd double ${lv.ir}, ${rv.ir}`) }
    else if (res == cgFloat() && op == mchek.bcSub()) { mgEmit(g, `${out} = fsub double ${lv.ir}, ${rv.ir}`) }
    else if (res == cgFloat() && op == mchek.bcMul()) { mgEmit(g, `${out} = fmul double ${lv.ir}, ${rv.ir}`) }
    else if (res == cgFloat() && op == mchek.bcDiv()) { mgEmit(g, `${out} = fdiv double ${lv.ir}, ${rv.ir}`) }
    return mgNewVal(res, out, false)
}

function mgCgCallFn(g: Gen, e: CEx): CgVal {
    let sig = mgSigOf(g, e.sval)
    let retCt = cgTyOfTy(e.ty)
    let callArgs = ""
    let i = 0
    while (i < e.args.length) {
        let v = mgCgExpr(g, e.args[i])
        let pt = retCt
        if (i < sig.ptys.length) {
            pt = sig.ptys[i]
        }
        v = mgCoerceVal(g, v, pt)
        v = mgToOwned(g, v)
        if (i > 0) {
            callArgs = `${callArgs}, `
        }
        callArgs = `${callArgs}${cgIrOf(pt)} ${v.ir}`
        i = i + 1
    }
    let rty = retCt
    if (e.ex) {
        rty = cgPromise()
    }
    let fname = `fn.${e.sval}`
    if (rty == cgVoid()) {
        mgEmit(g, `call void @${fname}(${callArgs})`)
        return mgNewVal(cgVoid(), "", false)
    }
    let r = mgFresh(g, "cl")
    mgEmit(g, `${r} = call ${cgIrOf(rty)} @${fname}(${callArgs})`)
    return mgNewVal(rty, r, true)
}

function mgCgArrayOp(g: Gen, e: CEx): CgVal {
    let a = mgCgExpr(g, e.kids[0])
    let p = mgBorrow(g, a)
    let op = e.opv
    let v = mgNewVal(cgVoid(), "", false)
    if (op == mchek.aoLen()) {
        let n = mgFresh(g, "an")
        mgEmit(g, `${n} = call i64 @marina_array_len(ptr ${p})`)
        let t = mgFresh(g, "al")
        mgEmit(g, `${t} = trunc i64 ${n} to i32`)
        v = mgNewVal(cgInt(), t, false)
    } else if (op == mchek.aoPush() || op == mchek.aoUnshift()) {
        // element type comes from the array expression
        let elem = mgCexprElem(e.kids[0])
        let av = mgCgExpr(g, e.args[0])
        if (elem.has) {
            av = mgCoerceVal(g, av, cgTyOfTy(elem.ty))
        }
        av = mgToOwned(g, av)
        let mv = mgBuildMv(g, av)
        let f = "marina_array_push"
        if (op == mchek.aoUnshift()) {
            f = "marina_array_unshift"
        }
        let n = mgFresh(g, "an")
        mgEmit(g, `${n} = call i64 @${f}(ptr ${p}, ptr ${mv})`)
        let t = mgFresh(g, "al")
        mgEmit(g, `${t} = trunc i64 ${n} to i32`)
        mgDiscard(g, av)
        v = mgNewVal(cgInt(), t, false)
    } else if (op == mchek.aoPop() || op == mchek.aoShift()) {
        let out = mgAlloca(g, "%mv")
        let f = "marina_array_pop"
        if (op == mchek.aoShift()) {
            f = "marina_array_shift"
        }
        mgEmit(g, `call void @${f}(ptr ${p}, ptr ${out})`)
        v = mgMvLoad(g, out, cgTyOfTy(e.ty))
    } else if (op == mchek.aoSplice() || op == mchek.aoSlice()) {
        let s = mgCgExpr(g, e.args[0])
        let s64 = mgSextI64(g, s)
        let en = mgCgExpr(g, e.args[1])
        let e64 = mgSextI64(g, en)
        let f = "marina_array_splice"
        if (op == mchek.aoSlice()) {
            f = "marina_array_slice"
        }
        let r = mgFresh(g, "ar")
        mgEmit(g, `${r} = call ptr @${f}(ptr ${p}, i64 ${s64}, i64 ${e64})`)
        v = mgNewVal(cgArray(), r, true)
    } else if (op == mchek.aoConcat()) {
        let b = mgCgExpr(g, e.args[0])
        let r = mgFresh(g, "ar")
        mgEmit(g, `${r} = call ptr @marina_array_concat(ptr ${p}, ptr ${b.ir})`)
        mgDiscard(g, b)
        v = mgNewVal(cgArray(), r, true)
    } else if (op == mchek.aoJoin()) {
        let s = mgCgExpr(g, e.args[0])
        let r = mgFresh(g, "js")
        mgEmit(g, `${r} = call ptr @marina_array_join(ptr ${p}, ptr ${s.ir})`)
        mgDiscard(g, s)
        v = mgNewVal(cgStr(), r, true)
    } else {
        // reverse / sort
        let f = "marina_array_reverse"
        if (op == mchek.aoSort()) {
            f = "marina_array_sort"
        }
        let r = mgFresh(g, "ar")
        mgEmit(g, `${r} = call ptr @${f}(ptr ${p})`)
        v = mgNewVal(cgArray(), r, true)
    }
    mgDiscard(g, a)
    return v
}

function mgCgArrayHof(g: Gen, e: CEx): CgVal {
    let a = mgCgExpr(g, e.kids[0])
    let p = mgBorrow(g, a)
    let cb = e.kids[1]
    let li = cb.id
    let env = mgBuildEnv(g, li, false, "")
    let op = e.opv
    let v = mgNewVal(cgVoid(), "", false)
    if (op == mchek.hofForEach()) {
        mgEmit(g, `call void @marina_array_foreach(ptr ${p}, ptr @lambda.${li}, ptr ${env}, ptr @lambda.${li}.drop)`)
        v = mgNewVal(cgVoid(), "", false)
    } else if (op == mchek.hofMap()) {
        let outTag = cgMvTagOfTy(e.ty.elem)
        let r = mgFresh(g, "ar")
        mgEmit(g, `${r} = call ptr @marina_array_map(ptr ${p}, ptr @lambda.${li}, ptr ${env}, ptr @lambda.${li}.drop, i32 ${outTag})`)
        v = mgNewVal(cgArray(), r, true)
    } else if (op == mchek.hofFilter()) {
        let r = mgFresh(g, "ar")
        mgEmit(g, `${r} = call ptr @marina_array_filter(ptr ${p}, ptr @lambda.${li}, ptr ${env}, ptr @lambda.${li}.drop)`)
        v = mgNewVal(cgArray(), r, true)
    } else {
        // reduce
        let rt = cgTyOfTy(e.ty)
        let init = mgCgExpr(g, e.args[0])
        init = mgCoerceVal(g, init, rt)
        init = mgToOwned(g, init)
        let imv = mgBuildMv(g, init)
        let out = mgAlloca(g, "%mv")
        mgEmit(g, `call void @marina_array_reduce(ptr ${p}, ptr @lambda.${li}, ptr ${env}, ptr @lambda.${li}.drop, ptr ${imv}, ptr ${out})`)
        let rv = mgMvLoad(g, out, rt)
        mgDiscard(g, init)
        v = rv
    }
    mgDiscard(g, a)
    return v
}// ---------------------------------------------------------------------------
// Lambdas
// ---------------------------------------------------------------------------

// Lambda layout: executor params first (Plain ABI only), then captured
// variables. Callback lambdas take their parameters as IR arguments, so
// only captures occupy env slots.
function mgLambdaSlots(g: Gen, li: Int32): Array<LamSlot> {
    let lam = g.c.lambdas[li]
    let slots: Array<LamSlot> = []
    if (lam.abi == mchek.abPlain()) {
        let i = 0
        while (i < lam.pids.length) {
            let s = new LamSlot()
            s.id = lam.pids[i]
            s.ty = lam.ptys[i]
            slots.push(s)
            i = i + 1
        }
    }
    let j = 0
    while (j < lam.cids.length) {
        let s = new LamSlot()
        s.id = lam.cids[j]
        s.ty = lam.ctys[j]
        slots.push(s)
        j = j + 1
    }
    return slots
}

function mgEnvTypeDef(g: Gen, li: Int32): string {
    let ty = `%env.${li}`
    let done = false
    if (li < g.envTypesDone.length) {
        done = g.envTypesDone[li]
    }
    if (!done) {
        while (g.envTypesDone.length <= li) {
            g.envTypesDone.push(false)
        }
        let etd = g.envTypesDone
        etd[li] = true
        let slots = mgLambdaSlots(g, li)
        let tys: Array<string> = []
        let i = 0
        while (i < slots.length) {
            tys.push(cgMemOf(cgTyOfTy(slots[i].ty)))
            i = i + 1
        }
        let joined = ""
        let j = 0
        while (j < tys.length) {
            if (j > 0) {
                joined = `${joined}, `
            }
            joined = `${joined}${tys[j]}`
            j = j + 1
        }
        g.typeDefs.push(`${ty} = type { ${joined} }`)
    }
    return ty
}

// Class id of a builtin std-module class (http_Server, ...).
function mgBuiltinClass(g: Gen, name: string): Int32 {
    let i = 0
    while (i < g.c.classes.length) {
        if (g.c.classes[i].name == name) {
            return i
        }
        i = i + 1
    }
    return -1
}

// Allocate + populate a closure environment for lambda `li`.
// hasPreset/preset fills env slot 0 directly (the executor's promise).
function mgBuildEnv(g: Gen, li: Int32, hasPreset: bool, preset: string): string {
    let slots = mgLambdaSlots(g, li)
    let ty = mgEnvTypeDef(g, li)
    let sz = ""
    if (slots.length == 0) {
        sz = "i64 8"
    } else {
        sz = `i64 ptrtoint (ptr getelementptr inbounds (${ty}, ptr null, i64 1) to i64)`
    }
    let envp = mgFresh(g, "en")
    mgEmit(g, `${envp} = call ptr @marina_closure_alloc(${sz})`)
    let i = 0
    while (i < slots.length) {
        let id = slots[i].id
        let t = slots[i].ty
        let ct = cgTyOfTy(t)
        // address this env directly (g.env is not set in the enclosing
        // function, so we can't use gep_ssa here)
        let gep = mgFresh(g, "eg")
        mgEmit(g, `${gep} = getelementptr inbounds ${ty}, ptr ${envp}, i64 0, i32 ${i}`)
        let isPreset = false
        if (i == 0) {
            if (hasPreset) {
                isPreset = true
            }
        }
        if (isPreset) {
            // env slots own their refs: retain the preset promise
            let r = mgFresh(g, "ep")
            mgEmit(g, `${r} = call ptr @marina_retain(ptr ${preset})`)
            mgEmit(g, `store ptr ${r}, ptr ${gep}`)
        } else {
            let ar = mgNewAccRes()
            mgAccessFor(g, id, ar)
            let a = ar.a
            let v = mgLoadAccess(g, a)
            if (cgIsPtr(ct)) {
                let r = mgFresh(g, "cp")
                mgEmit(g, `${r} = call ptr @marina_retain(ptr ${v.ir})`)
                mgEmit(g, `store ptr ${r}, ptr ${gep}`)
            } else {
                mgEmit(g, `store ${cgIrOf(ct)} ${v.ir}, ptr ${gep}`)
            }
        }
        i = i + 1
    }
    return envp
}

function mgGenLambda(g: Gen, li: Int32): void {
    let lam = g.c.lambdas[li]
    if (lam.isAsync && lam.abi == mchek.abListen()) {
        // async route handler: shim + promise state machine
        mgGenAsyncListenLambda(g, li)
        return
    }
    let abi = lam.abi
    let lret = lam.ret
    let slots = mgLambdaSlots(g, li)
    let body = lam.body
    let ty = mgEnvTypeDef(g, li)

    // ---- lambda body ----
    // IR signature depends on the callback ABI; extra params are raw
    // pointers to MValues passed by the runtime.
    let irParams: Array<string> = []
    irParams.push("ptr %env")
    if (abi == mchek.abForEach()) {
        irParams.push("ptr %item")
    } else if (abi == mchek.abMapFilter()) {
        irParams.push("ptr %item")
        irParams.push("ptr %out")
    } else if (abi == mchek.abReduce()) {
        irParams.push("ptr %acc")
        irParams.push("ptr %item")
        irParams.push("ptr %out")
    } else if (abi == mchek.abListen()) {
        irParams.push("ptr %req")
        irParams.push("ptr %res")
    }
    mgPushFn(g, mgNewIrFn(`lambda.${li}`, "void", irParams))
    g.curRet = cgVoid()
    let exitB = mgNewBlockFixed(g, "exit")
    g.hasLambdaExit = true
    g.lambdaExit = exitB
    g.hasEnv = true
    g.env = mgNewEnvInfo(ty)
    let i = 0
    while (i < slots.length) {
        g.env.slotTys.push(cgTyOfTy(slots[i].ty))
        g.env.ids.push(slots[i].id)
        g.env.idxs.push(i)
        i = i + 1
    }
    i = 0
    while (i < slots.length) {
        mgScopeInsert(g.scopes[0], slots[i].id, mgNewAccess(accEnv(), "", i, cgTyOfTy(slots[i].ty)))
        i = i + 1
    }
    // Callback parameters arrive as MValue pointers; unpack them into
    // allocas owned by the lambda body. The runtime retains string/array
    // payloads before the call, so these start out owned.
    if (abi != mchek.abPlain()) {
        let lamParams = lam.pids
        let lamPtys = lam.ptys
        let i2 = 0
        while (i2 < lamParams.length) {
            let ct = cgTyOfTy(lamPtys[i2])
            let a = mgAlloca(g, cgMemOf(ct))
            let src = "%item"
            if (abi == mchek.abForEach()) {
                src = "%item"
            } else if (abi == mchek.abMapFilter()) {
                src = "%item"
            } else if (abi == mchek.abReduce()) {
                if (i2 == 0) {
                    src = "%acc"
                } else {
                    src = "%item"
                }
            } else if (abi == mchek.abListen()) {
                if (i2 == 0) {
                    src = "%req"
                } else {
                    src = "%res"
                }
            }
            mgStoreFromMv(g, src, ct, a)
            mgScopeInsert(g.scopes[0], lamParams[i2], mgNewAccess(accAlloca(), a, 0, ct))
            i2 = i2 + 1
        }
        if (abi == mchek.abMapFilter() || abi == mchek.abReduce()) {
            g.hasLambdaOut = true
            g.lambdaOut = "%out"
            g.hasLambdaRet = true
            g.lambdaRet = cgTyOfTy(lret)
        }
    }
    mgCgBody(g, body)
    if (!mgTerminated(g)) {
        if (g.hasLambdaOut) {
            // fell off the end of a map/filter/reduce callback: write a
            // void value (the checker requires a return; defensive)
            let out = g.lambdaOut
            mgEmit(g, `store i32 0, ptr ${out}`)
            let g1 = mgMvField(g, out, 1)
            mgEmit(g, `store i32 0, ptr ${g1}`)
            mgFlushPending(g)
            mgReleaseScopeVars(g)
            let el = mgLabelOf(g, exitB)
            mgTerm(g, `br label %${el}`)
        } else {
            mgSyncEpilogue(g, false, mgVoidVal())
        }
    }
    mgSwitchBlock(g, exitB)
    mgTerm(g, "ret void")
    g.hasEnv = false
    g.hasLambdaOut = false
    g.hasLambdaExit = false
    g.hasLambdaRet = false

    // ---- drop function (called by the runtime when the env dies) ----
    mgPushFn(g, mgNewIrFn(`lambda.${li}.drop`, "void", ["ptr %env"]))
    g.hasEnv = true
    g.env = mgNewEnvInfo(ty)
    let j = 0
    while (j < slots.length) {
        g.env.slotTys.push(cgTyOfTy(slots[j].ty))
        g.env.ids.push(slots[j].id)
        g.env.idxs.push(j)
        j = j + 1
    }
    j = 0
    while (j < slots.length) {
        let ct = cgTyOfTy(slots[j].ty)
        if (cgIsPtr(ct)) {
            let gep = mgGepSsa(g, mgNewAccess(accEnv(), "", j, ct))
            let v = mgFresh(g, "dl")
            mgEmit(g, `${v} = load ptr, ptr ${gep}`)
            mgEmit(g, `call void @marina_release(ptr ${v})`)
        }
        j = j + 1
    }
    mgEmit(g, "call void @marina_closure_free(ptr %env)")
    mgTerm(g, "ret void")
    g.hasEnv = false
}

// ---------------------------------------------------------------------------
// Sync functions
// ---------------------------------------------------------------------------

function mgGenSyncFnInto(g: Gen, name: string, pids: Array<Int32>, ptys: Array<Ty>, ret: Ty, body: Array<CSt>): void {
    let irRet = cgIrOf(cgTyOfTy(ret))
    let irParams: Array<string> = []
    let i = 0
    while (i < pids.length) {
        irParams.push(`${cgIrOf(cgTyOfTy(ptys[i]))} %a${i}`)
        i = i + 1
    }
    mgPushFn(g, mgNewIrFn(name, irRet, irParams))
    g.curRet = cgTyOfTy(ret)
    i = 0
    while (i < pids.length) {
        let ct = cgTyOfTy(ptys[i])
        let a = mgNewAccess(accAlloca(), mgAlloca(g, cgMemOf(ct)), 0, ct)
        mgStoreAccess(g, a, `%a${i}`, ct)
        mgScopeInsert(g.scopes[0], pids[i], a)
        i = i + 1
    }
    mgCgBody(g, body)
    if (!mgTerminated(g)) {
        mgSyncEpilogue(g, false, mgVoidVal())
    }
}

function mgGenSyncFn(g: Gen, f: CFn): void {
    mgGenSyncFnInto(g, `fn.${f.name}`, f.pids, f.ptys, f.ret, f.body)
}

// ---------------------------------------------------------------------------
// Async functions
// ---------------------------------------------------------------------------

// Split an async body into linear segments at await points.
function mgTransform(g: Gen, stmts: Array<CSt>, segs: Array<Segment>): void {
    let cur = mchek.emptyCSts()
    let i = 0
    let stopped = false
    while (i < stmts.length && !stopped) {
        let s = stmts[i]
        if (s.k == mchek.csLet() && s.hasE1 && s.e1.k == mchek.ceAwait()) {
            let seg = new Segment()
            seg.stmts = cur
            seg.endKind = seAwait()
            seg.endExpr = s.e1.kids[0]
            seg.hasTarget = true
            seg.targetId = s.id
            seg.targetTy = s.ty
            seg.next = segs.length + 1
            segs.push(seg)
            cur = mchek.emptyCSts()
        } else if (s.k == mchek.csExpr() && s.hasE1 && s.e1.k == mchek.ceAwait()) {
            let seg = new Segment()
            seg.stmts = cur
            seg.endKind = seAwait()
            seg.endExpr = s.e1.kids[0]
            seg.hasTarget = false
            seg.targetId = 0
            seg.targetTy = mchek.mkTy(mchek.tvVoid())
            seg.next = segs.length + 1
            segs.push(seg)
            cur = mchek.emptyCSts()
        } else if (s.k == mchek.csReturn() && s.hasE1 && s.retKind == mchek.rkPlain()) {
            if (s.e1.k == mchek.ceAwait()) {
                // `return await e` == await then resolve
                let tmp = mgFreshVarId(g)
                let seg = new Segment()
                seg.stmts = cur
                seg.endKind = seAwait()
                seg.endExpr = s.e1.kids[0]
                seg.hasTarget = true
                seg.targetId = tmp
                seg.targetTy = s.e1.ty
                seg.next = segs.length + 1
                segs.push(seg)
                let seg2 = new Segment()
                seg2.stmts = mchek.emptyCSts()
                seg2.endKind = seResolve()
                seg2.endExpr = mgDummyEx()
                seg2.hasTarget = false
                seg2.targetId = tmp
                seg2.targetTy = s.e1.ty
                seg2.next = 0
                segs.push(seg2)
            } else {
                let seg = new Segment()
                seg.stmts = cur
                seg.endKind = seRetExpr()
                seg.endExpr = s.e1
                seg.hasTarget = false
                seg.targetId = 0
                seg.targetTy = mchek.mkTy(mchek.tvVoid())
                seg.next = 0
                segs.push(seg)
            }
            stopped = true
        } else if (s.k == mchek.csReturn() && s.hasE1 && s.retKind == mchek.rkFlatten()) {
            // `return promiseExpr`: await the inner promise, then
            // resolve our own promise with its value (JS flattening).
            let inner = s.ty
            let tmp = mgFreshVarId(g)
            let seg = new Segment()
            seg.stmts = cur
            seg.endKind = seAwait()
            seg.endExpr = s.e1
            seg.hasTarget = true
            seg.targetId = tmp
            seg.targetTy = inner
            seg.next = segs.length + 1
            segs.push(seg)
            let seg2 = new Segment()
            seg2.stmts = mchek.emptyCSts()
            seg2.endKind = seResolve()
            seg2.endExpr = mgDummyEx()
            seg2.hasTarget = false
            seg2.targetId = tmp
            seg2.targetTy = inner
            seg2.next = 0
            segs.push(seg2)
            stopped = true
        } else if (s.k == mchek.csReturn() && !s.hasE1) {
            let seg = new Segment()
            seg.stmts = cur
            seg.endKind = seRetVoid()
            seg.endExpr = mgDummyEx()
            seg.hasTarget = false
            seg.targetId = 0
            seg.targetTy = mchek.mkTy(mchek.tvVoid())
            seg.next = 0
            segs.push(seg)
            stopped = true
        } else {
            cur.push(s)
        }
        i = i + 1
    }
    if (!stopped) {
        let seg = new Segment()
        seg.stmts = cur
        seg.endKind = seRetVoid()
        seg.endExpr = mgDummyEx()
        seg.hasTarget = false
        seg.targetId = 0
        seg.targetTy = mchek.mkTy(mchek.tvVoid())
        seg.next = 0
        segs.push(seg)
    }
}

// compile segments into a resume function; shared by gen_async_fn and the
// async-listen lambda. entryName = name of the entry fn (resume target).
function mgGenResumeInto(g: Gen, entryName: string, resumeName: string, segs: Array<Segment>, lret: Ty, innerTy: Ty): void {
    mgPushFn(g, mgNewIrFn(resumeName, "void", ["ptr %fr", "i32 %st", "ptr %val"]))
    // the resume prologue block is named "pro" (not "entry")
    let fns0 = g.fns
    let fn0 = fns0[g.cur]
    let blocks0 = fn0.blocks
    let b0 = blocks0[0]
    b0.label = "pro"
    g.curRet = cgVoid()

    // pre-create segment blocks with stable labels
    let vblock: Array<Int32> = []
    let vHas: Array<bool> = []
    let sblock: Array<Int32> = []
    let k = 0
    while (k < segs.length) {
        if (k > 0) {
            vblock.push(mgNewBlockFixed(g, `seg.${k}v`))
            vHas.push(true)
        } else {
            vblock.push(0)
            vHas.push(false)
        }
        sblock.push(mgNewBlockFixed(g, `seg.${k}`))
        k = k + 1
    }
    // await targets: target of segment k-1 is materialized in segment k
    let atIds: Array<Int32> = []
    let atTys: Array<Ty> = []
    let atHas: Array<bool> = []
    k = 0
    while (k < segs.length) {
        let seg = segs[k]
        if (seg.endKind == seAwait() && seg.hasTarget) {
            atIds.push(seg.targetId)
            atTys.push(seg.targetTy)
            atHas.push(true)
        } else {
            atIds.push(0)
            atTys.push(mchek.mkTy(mchek.tvVoid()))
            atHas.push(false)
        }
        k = k + 1
    }
    k = 0
    while (k < segs.length) {
        let seg = segs[k]
        if (k > 0) {
            mgSwitchBlock(g, vblock[k])
            if (atHas[k - 1]) {
                mgMaterializeAwaitValue(g, atIds[k - 1], atTys[k - 1])
            }
            let sl = mgLabelOf(g, sblock[k])
            mgTerm(g, `br label %${sl}`)
        }
        mgSwitchBlock(g, sblock[k])
        g.scopes.push(mgNewScopeMap())
        mgCgBody(g, seg.stmts)
        if (!mgTerminated(g)) {
            if (seg.endKind == seAwait()) {
                let v = mgCgExpr(g, seg.endExpr)
                v = mgToOwned(g, v)
                mgEmit(g, `call void @marina_await(ptr ${v.ir}, ptr @${resumeName}, ptr %fr, i32 ${seg.next})`)
                mgFlushPending(g)
                mgTerm(g, "ret void")
            } else if (seg.endKind == seRetExpr()) {
                let v = mgCgExpr(g, seg.endExpr)
                v = mgCoerceVal(g, v, cgTyOfTy(lret))
                mgFinishAsync(g, true, v)
            } else if (seg.endKind == seRetVoid()) {
                mgFinishAsync(g, false, mgVoidVal())
            } else {
                // ResolveReturn
                let ct = cgTyOfTy(seg.targetTy)
                let slot = mgSlotFor(g, seg.targetId, ct)
                let a = mgNewAccess(accFrame(), "", slot, ct)
                let v = mgLoadAccess(g, a)
                mgFinishAsync(g, true, mgNewVal(ct, v.ir, false))
            }
        }
        mgPopScope(g)
        k = k + 1
    }

    // switch on state in the prologue block
    let sw = `switch i32 %st, label %${mgLabelOf(g, sblock[0])} [`
    let j = 1
    while (j < sblock.length) {
        let vl = mgLabelOf(g, vblock[j])
        sw = `${sw} i32 ${j}, label %${vl}`
        j = j + 1
    }
    sw = `${sw} ]`
    mgSwitchBlock(g, 0)
    mgTerm(g, sw)
}

function mgGenAsyncFn(g: Gen, f: CFn): void {
    let fname = `fn.${f.name}`
    let body = f.body

    // 1. transform into segments
    let segs: Array<Segment> = []
    mgTransform(g, body, segs)

    // 2. frame layout: slot 0 = promise
    let fty = `%frame.${fname}`
    g.hasFrame = true
    g.frame = mgNewFrameInfo(fty)
    g.frame.slots.push(cgPromise())

    // 3. entry function
    let irParams: Array<string> = []
    let i = 0
    while (i < f.pids.length) {
        irParams.push(`${cgIrOf(cgTyOfTy(f.ptys[i]))} %a${i}`)
        i = i + 1
    }
    let entry = mgNewIrFn(fname, "ptr", irParams)
    entry.hasFrame = true
    entry.frameTy = fty
    mgPushFn(g, entry)
    g.curRet = cgPromise()
    let pr = mgFresh(g, "pr")
    mgEmit(g, `${pr} = call ptr @marina_promise_create()`)
    let fracc = mgNewAccess(accFrame(), "", 0, cgPromise())
    mgStoreAccess(g, fracc, pr, cgPromise())
    i = 0
    while (i < f.pids.length) {
        let ct = cgTyOfTy(f.ptys[i])
        let slot = mgSlotFor(g, f.pids[i], ct)
        let gep = mgGepSsa(g, mgNewAccess(accFrame(), "", slot, ct))
        mgEmit(g, `store ${cgIrOf(ct)} %a${i}, ptr ${gep}`)
        i = i + 1
    }
    let rv = mgFresh(g, "rv")
    mgEmit(g, `${rv} = call ptr @marina_retain(ptr ${pr})`)
    mgEmit(g, `call void @${fname}.resume(ptr %fr, i32 0, ptr null)`)
    mgTerm(g, `ret ptr ${rv}`)

    // 4. resume function (state machine)
    // inner return type: Promise(t) -> t, else void
    let innerTy = mchek.mkTy(mchek.tvVoid())
    if (f.ret.k == mchek.tvPromise()) {
        innerTy = f.ret.elem
    }
    mgGenResumeInto(g, fname, `${fname}.resume`, segs, f.ret, innerTy)

    // 5. emit the frame type def (slot count now final)
    let slots = g.frame.slots
    let tys: Array<string> = []
    let j = 0
    while (j < slots.length) {
        tys.push(cgMemOf(slots[j]))
        j = j + 1
    }
    let joined = ""
    j = 0
    while (j < tys.length) {
        if (j > 0) {
            joined = `${joined}, `
        }
        joined = `${joined}${tys[j]}`
        j = j + 1
    }
    g.typeDefs.push(`${fty} = type { ${joined} }`)
    g.hasFrame = false
}

// Materialize the awaited value (in `%val`) into `id`'s frame slot.
function mgMaterializeAwaitValue(g: Gen, id: Int32, ty: Ty): void {
    let ct = cgTyOfTy(ty)
    let slot = mgSlotFor(g, id, ct)
    let gep = mgGepSsa(g, mgNewAccess(accFrame(), "", slot, ct))
    let vgep2 = mgMvField(g, "%val", 2)
    let vgep3 = mgMvField(g, "%val", 3)
    let vgep4 = mgMvField(g, "%val", 4)
    if (ct == cgInt()) {
        let l = mgFresh(g, "aw")
        mgEmit(g, `${l} = load i64, ptr ${vgep2}`)
        let t = mgFresh(g, "at")
        mgEmit(g, `${t} = trunc i64 ${l} to i32`)
        mgEmit(g, `store i32 ${t}, ptr ${gep}`)
    } else if (ct == cgFloat()) {
        let l = mgFresh(g, "aw")
        mgEmit(g, `${l} = load double, ptr ${vgep3}`)
        mgEmit(g, `store double ${l}, ptr ${gep}`)
    } else if (ct == cgStr()) {
        let l = mgFresh(g, "aw")
        mgEmit(g, `${l} = load ptr, ptr ${vgep4}`)
        let r = mgFresh(g, "ar")
        mgEmit(g, `${r} = call ptr @marina_retain(ptr ${l})`)
        mgEmit(g, `store ptr ${r}, ptr ${gep}`)
    } else if (ct == cgBool()) {
        let l = mgFresh(g, "aw")
        mgEmit(g, `${l} = load i64, ptr ${vgep2}`)
        let t = mgFresh(g, "at")
        mgEmit(g, `${t} = trunc i64 ${l} to i1`)
        let z = mgFresh(g, "az")
        mgEmit(g, `${z} = zext i1 ${t} to i8`)
        mgEmit(g, `store i8 ${z}, ptr ${gep}`)
    } else if (ct == cgStream()) {
        let l = mgFresh(g, "aw")
        mgEmit(g, `${l} = load i64, ptr ${vgep2}`)
        mgEmit(g, `store i64 ${l}, ptr ${gep}`)
    } else if (ct == cgArray() || ct == cgObject() || ct == cgPromise() || ct == cgResolver()) {
        // Reference values: the waiter task hands us a retained copy
        // (marina_promise_resolve retains per waiter), so retain again
        // for the frame slot — the slot releases it when the frame dies
        // and run_waiter drops the task's copy. Stream values are plain
        // integer handles (no payload to move).
        let l = mgFresh(g, "aw")
        mgEmit(g, `${l} = load ptr, ptr ${vgep4}`)
        let r = mgFresh(g, "ar")
        mgEmit(g, `${r} = call ptr @marina_retain(ptr ${l})`)
        mgEmit(g, `store ptr ${r}, ptr ${gep}`)
    }
}

// An `async (req, res) => { ... }` route handler compiles to:
//   * `lambda.N` — the Listen-ABI shim the runtime registers; returns
//     the handler's promise,
//   * `lambda.N.async` — state machine entry: creates the promise,
//     copies captures + (req, res) into the frame, runs segment 0,
//   * `lambda.N.async.resume` — continuations after each await,
//   * `lambda.N.drop` — env cleanup (unchanged).
function mgGenAsyncListenLambda(g: Gen, li: Int32): void {
    let lam = g.c.lambdas[li]
    let lret = lam.ret
    let captures = mgLambdaSlots(g, li) // Listen ABI: captures only
    let lamPids = lam.pids
    let lamPtys = lam.ptys
    let body = lam.body
    let fty = `%frame.lambda.${li}`
    let entryName = `lambda.${li}.async`

    // ---- 1. shim: the runtime calls this; it returns the promise ----
    mgPushFn(g, mgNewIrFn(`lambda.${li}`, "ptr", ["ptr %env", "ptr %req", "ptr %res"]))
    g.curRet = cgPromise()
    let sp = mgFresh(g, "sp")
    mgEmit(g, `${sp} = call ptr @${entryName}(ptr %env, ptr %req, ptr %res)`)
    mgTerm(g, `ret ptr ${sp}`)

    // ---- 2. state machine frame ----
    g.hasFrame = true
    g.frame = mgNewFrameInfo(fty)
    g.frame.slots.push(cgPromise())
    let envTy = mgEnvTypeDef(g, li)
    g.hasEnv = true
    g.env = mgNewEnvInfo(envTy)
    let ci = 0
    while (ci < captures.length) {
        g.env.slotTys.push(cgTyOfTy(captures[ci].ty))
        g.env.ids.push(captures[ci].id)
        g.env.idxs.push(ci)
        ci = ci + 1
    }

    // ---- 3. entry: create promise + frame, unpack, run segment 0 ----
    let entry = mgNewIrFn(entryName, "ptr", ["ptr %env", "ptr %req", "ptr %res"])
    entry.hasFrame = true
    entry.frameTy = fty
    mgPushFn(g, entry)
    g.curRet = cgPromise()
    let pr = mgFresh(g, "pr")
    mgEmit(g, `${pr} = call ptr @marina_promise_create()`)
    let fracc = mgNewAccess(accFrame(), "", 0, cgPromise())
    mgStoreAccess(g, fracc, pr, cgPromise())
    // captures: the env owns its refs; the frame gets its own (retained)
    ci = 0
    while (ci < captures.length) {
        let ct = cgTyOfTy(captures[ci].ty)
        let slot = mgSlotFor(g, captures[ci].id, ct)
        let gep = mgGepSsa(g, mgNewAccess(accFrame(), "", slot, ct))
        let egep = mgGepSsa(g, mgNewAccess(accEnv(), "", ci, ct))
        if (cgIsPtr(ct)) {
            let v = mgFresh(g, "cv")
            mgEmit(g, `${v} = load ptr, ptr ${egep}`)
            let r = mgFresh(g, "cr")
            mgEmit(g, `${r} = call ptr @marina_retain(ptr ${v})`)
            mgEmit(g, `store ptr ${r}, ptr ${gep}`)
        } else {
            let v = mgFresh(g, "cv")
            mgEmit(g, `${v} = load ${cgIrOf(ct)}, ptr ${egep}`)
            mgEmit(g, `store ${cgIrOf(ct)} ${v}, ptr ${gep}`)
        }
        ci = ci + 1
    }
    // Listen-ABI params arrive as pointers to MValues (rc 1 handed over)
    let pi = 0
    while (pi < lamPids.length) {
        let ct = cgTyOfTy(lamPtys[pi])
        let slot = mgSlotFor(g, lamPids[pi], ct)
        let gep = mgGepSsa(g, mgNewAccess(accFrame(), "", slot, ct))
        let src = "%req"
        if (pi == 1) {
            src = "%res"
        }
        mgStoreFromMv(g, src, ct, gep)
        pi = pi + 1
    }
    let rv = mgFresh(g, "rv")
    mgEmit(g, `${rv} = call ptr @marina_retain(ptr ${pr})`)
    mgEmit(g, `call void @${entryName}.resume(ptr %fr, i32 0, ptr null)`)
    mgTerm(g, `ret ptr ${rv}`)

    // ---- 4. resume: continuations (mirrors gen_async_fn) ----
    let segs: Array<Segment> = []
    mgTransform(g, body, segs)
    mgGenResumeInto(g, entryName, `${entryName}.resume`, segs, lret, lret)

    let slots = g.frame.slots
    let tys: Array<string> = []
    let j = 0
    while (j < slots.length) {
        tys.push(cgMemOf(slots[j]))
        j = j + 1
    }
    let joined = ""
    j = 0
    while (j < tys.length) {
        if (j > 0) {
            joined = `${joined}, `
        }
        joined = `${joined}${tys[j]}`
        j = j + 1
    }
    g.typeDefs.push(`${fty} = type { ${joined} }`)
    g.hasFrame = false

    // ---- 5. drop function (env cleanup, same as sync lambdas) ----
    mgPushFn(g, mgNewIrFn(`lambda.${li}.drop`, "void", ["ptr %env"]))
    g.hasEnv = true
    g.env = mgNewEnvInfo(envTy)
    let dj = 0
    while (dj < captures.length) {
        g.env.slotTys.push(cgTyOfTy(captures[dj].ty))
        g.env.ids.push(captures[dj].id)
        g.env.idxs.push(dj)
        dj = dj + 1
    }
    dj = 0
    while (dj < captures.length) {
        let ct = cgTyOfTy(captures[dj].ty)
        if (cgIsPtr(ct)) {
            let gep = mgGepSsa(g, mgNewAccess(accEnv(), "", dj, ct))
            let v = mgFresh(g, "dl")
            mgEmit(g, `${v} = load ptr, ptr ${gep}`)
            mgEmit(g, `call void @marina_release(ptr ${v})`)
        }
        dj = dj + 1
    }
    mgEmit(g, "call void @marina_closure_free(ptr %env)")
    mgTerm(g, "ret void")
    g.hasEnv = false
}

// ---------------------------------------------------------------------------
// Program entry point
// ---------------------------------------------------------------------------

function mgGenMain(g: Gen): void {
    let mainParams: Array<string> = []
    mgPushFn(g, mgNewIrFn("main", "i32", mainParams))
    mgEmit(g, "call void @marina_event_loop_start()")
    // register class metadata (name + field names) so the runtime can
    // print objects and keep classes self-describing
    let id = 0
    while (id < g.c.classes.length) {
        let def = g.c.classes[id]
        let bytes: Array<Int32> = []
        let n = 0
        while (n < def.name.length) {
            bytes.push(def.name.charAt(n))
            n = n + 1
        }
        bytes.push(0)
        let fi = 0
        while (fi < def.fnames.length) {
            let fname = def.fnames[fi]
            let m = 0
            while (m < fname.length) {
                bytes.push(fname.charAt(m))
                m = m + 1
            }
            bytes.push(0)
            fi = fi + 1
        }
        let l = bytes.length
        let gname = `@.classmeta.${id}`
        g.globals.push(`${gname} = private constant [${l} x i8] c"${mgEscapeBytes(bytes)}", align 8`)
        mgEmit(g, `call void @marina_class_register(i32 ${id}, ptr getelementptr inbounds ([${l} x i8], ptr ${gname}, i64 0, i64 0), i64 ${l})`)
        id = id + 1
    }
    if (g.c.hasToplevel) {
        mgEmit(g, "call void @fn.__toplevel()")
    }
    if (g.c.hasSyncMain && !g.c.explicitMain) {
        let rty = cgVoid()
        let sig = mgSigOf(g, "main")
        let hasSig = false
        let si = 0
        while (si < g.sigNames.length) {
            if (g.sigNames[si] == "main") {
                hasSig = true
                si = g.sigNames.length
            } else {
                si = si + 1
            }
        }
        if (hasSig) {
            rty = sig.ret
        }
        mgEmit(g, `call ${cgIrOf(rty)} @fn.main()`)
    }
    if (g.c.hasAsyncMain && !g.c.explicitMain) {
        let mp = mgFresh(g, "mp")
        mgEmit(g, `${mp} = call ptr @fn.main()`)
        mgEmit(g, `call void @marina_release(ptr ${mp})`)
    }
    let r = mgFresh(g, "mr")
    mgEmit(g, `${r} = call i32 @marina_event_loop_run()`)
    mgTerm(g, `ret i32 ${r}`)
}

// ---------------------------------------------------------------------------
// Module rendering
// ---------------------------------------------------------------------------

function mgDeclares(): string {
    return "declare ptr @marina_frame_alloc(i64)\ndeclare void @marina_frame_free(ptr)\ndeclare ptr @marina_promise_create()\ndeclare void @marina_promise_resolve(ptr, ptr)\ndeclare void @marina_await(ptr, ptr, ptr, i32)\ndeclare ptr @marina_promise_run_executor(ptr, ptr, ptr, ptr)\ndeclare void @marina_set_timeout(ptr, ptr, ptr, i64)\ndeclare ptr @marina_closure_alloc(i64)\ndeclare void @marina_closure_free(ptr)\ndeclare ptr @marina_retain(ptr)\ndeclare void @marina_release(ptr)\ndeclare ptr @marina_string_literal(ptr, i64)\ndeclare ptr @marina_string_concat(ptr, ptr)\ndeclare i64 @marina_string_len(ptr)\ndeclare i64 @marina_string_charcode_at(ptr, i64)\ndeclare ptr @marina_string_substring(ptr, i64, i64)\ndeclare ptr @marina_args()\ndeclare ptr @marina_to_string(ptr)\ndeclare void @marina_print(ptr)\ndeclare ptr @marina_array_new(i32)\ndeclare i64 @marina_array_len(ptr)\ndeclare i64 @marina_array_push(ptr, ptr)\ndeclare void @marina_array_pop(ptr, ptr)\ndeclare void @marina_array_shift(ptr, ptr)\ndeclare i64 @marina_array_unshift(ptr, ptr)\ndeclare void @marina_array_get(ptr, i64, ptr)\ndeclare void @marina_array_set(ptr, i64, ptr)\ndeclare ptr @marina_array_splice(ptr, i64, i64)\ndeclare ptr @marina_array_slice(ptr, i64, i64)\ndeclare ptr @marina_array_concat(ptr, ptr)\ndeclare ptr @marina_array_join(ptr, ptr)\ndeclare ptr @marina_array_reverse(ptr)\ndeclare ptr @marina_array_sort(ptr)\ndeclare void @marina_array_foreach(ptr, ptr, ptr, ptr)\ndeclare ptr @marina_array_map(ptr, ptr, ptr, ptr, i32)\ndeclare ptr @marina_array_filter(ptr, ptr, ptr, ptr)\ndeclare void @marina_array_reduce(ptr, ptr, ptr, ptr, ptr, ptr)\ndeclare void @marina_class_register(i32, ptr, i64)\ndeclare ptr @marina_object_new(i32, i64)\ndeclare void @marina_object_get(ptr, i64, ptr)\ndeclare void @marina_object_set(ptr, i64, ptr)\ndeclare void @marina_object_get_field(ptr, ptr, ptr)\ndeclare void @marina_object_set_field(ptr, ptr, ptr)\ndeclare void @marina_fs_read_file(ptr, ptr)\ndeclare void @marina_fs_write_file(ptr, ptr)\ndeclare void @marina_fs_exists(ptr, ptr)\ndeclare void @marina_fs_read_dir(ptr, ptr)\ndeclare void @marina_fs_mkdir(ptr, ptr)\ndeclare void @marina_fs_remove(ptr, ptr)\ndeclare void @marina_crypto_sha256(ptr, ptr)\ndeclare void @marina_crypto_base64(i1, ptr, ptr)\ndeclare void @marina_crypto_random_hex(i64, ptr)\ndeclare void @marina_crypto_uuid(ptr)\ndeclare void @marina_net_connect(ptr, ptr, ptr)\ndeclare void @marina_net_write(ptr, ptr)\ndeclare void @marina_net_read_all(ptr, ptr)\ndeclare void @marina_net_close(ptr)\ndeclare i1 @marina_str_eq(ptr, ptr)\ndeclare void @marina_http_request(ptr, ptr, ptr, ptr, i32)\ndeclare void @marina_http_listen(ptr, ptr, ptr, ptr, i32, i32)\ndeclare void @marina_http_res_send(ptr, ptr)\ndeclare void @marina_http_res_json(ptr, ptr)\ndeclare void @marina_http_router_bind(ptr, ptr)\ndeclare void @marina_http_route_add(ptr, ptr, ptr, ptr, ptr, ptr)\ndeclare void @marina_http_server_listen(ptr, ptr, ptr, i32, i32)\ndeclare void @marina_http_validator_init(ptr, ptr)\ndeclare void @marina_http_field_init(ptr, i32)\ndeclare void @marina_http_field_op(ptr, i32, ptr)\ndeclare void @marina_http_validate(ptr, ptr, i32, ptr)\ndeclare void @marina_sql_open(ptr, ptr, i32, ptr)\ndeclare void @marina_sql_execute(ptr, ptr, i64, ptr, i32, ptr)\ndeclare void @marina_sql_query(ptr, ptr, i64, ptr, ptr)\ndeclare void @marina_sql_close(ptr)\ndeclare ptr @marina_sql_execute_async(ptr, ptr, i64, ptr, i32)\ndeclare ptr @marina_sql_query_async(ptr, ptr, i64, ptr)\ndeclare ptr @marina_fs_read_file_async(ptr)\ndeclare ptr @marina_fs_write_file_async(ptr, ptr)\ndeclare ptr @marina_fs_exists_async(ptr)\ndeclare ptr @marina_fs_read_dir_async(ptr)\ndeclare ptr @marina_fs_mkdir_async(ptr)\ndeclare ptr @marina_fs_remove_async(ptr)\ndeclare ptr @marina_net_connect_async(ptr, ptr)\ndeclare ptr @marina_net_write_async(ptr, ptr)\ndeclare ptr @marina_net_read_all_async(ptr)\ndeclare ptr @marina_net_close_async(ptr)\ndeclare ptr @marina_http_request_async(ptr, ptr, ptr, i32)\ndeclare void @marina_event_loop_start()\ndeclare i32 @marina_event_loop_run()"
}

// render one IR function into the output lines
function mgRenderFn(f: IrFn, out: Array<string>): void {
    let params = ""
    let i = 0
    while (i < f.params.length) {
        if (i > 0) {
            params = `${params}, `
        }
        params = `${params}${f.params[i]}`
        i = i + 1
    }
    out.push(`define ${f.ret} @${f.name}(${params}) {`)
    let b0 = f.blocks[0]
    out.push(`${b0.label}:`)
    if (f.hasFrame) {
        out.push(`  %fr = call ptr @marina_frame_alloc(i64 ptrtoint (ptr getelementptr inbounds (${f.frameTy}, ptr null, i64 1) to i64))`)
    }
    let ai = 0
    while (ai < f.allocas.length) {
        out.push(`  ${f.allocas[ai]}`)
        ai = ai + 1
    }
    let ii = 0
    while (ii < b0.lines.length) {
        out.push(`  ${b0.lines[ii]}`)
        ii = ii + 1
    }
    out.push(`  ${b0.term}`)
    let bi = 1
    while (bi < f.blocks.length) {
        let b = f.blocks[bi]
        out.push("")
        out.push(`${b.label}:`)
        let jj = 0
        while (jj < b.lines.length) {
            out.push(`  ${b.lines[jj]}`)
            jj = jj + 1
        }
        out.push(`  ${b.term}`)
        bi = bi + 1
    }
    out.push("}")
    out.push("")
}

function mgRender(g: Gen): string {
    let out: Array<string> = []
    out.push("; ModuleID = 'marina'")
    out.push("; generated by the marina compiler v0.1")
    out.push("")
    out.push("%mv = type { i32, i32, i64, double, ptr }")
    out.push("")
    let i = 0
    while (i < g.typeDefs.length) {
        out.push(g.typeDefs[i])
        i = i + 1
    }
    if (g.typeDefs.length > 0) {
        out.push("")
    }
    i = 0
    while (i < g.globals.length) {
        out.push(g.globals[i])
        i = i + 1
    }
    if (g.globals.length > 0) {
        out.push("")
    }
    // DECLARES is emitted as one blob with a trailing blank line
    out.push(mgDeclares())
    out.push("")
    i = 0
    while (i < g.fns.length) {
        mgRenderFn(g.fns[i], out)
        i = i + 1
    }
    out.push("")
    return out.join("\n")
}

// ---------------------------------------------------------------------------
// Entry point
// ---------------------------------------------------------------------------

function generate(c: ChkResult): string {
    let g = mgNewGen(c)
    let i = 0
    while (i < c.fns.length) {
        let f = c.fns[i]
        let s = new Sig2()
        s.ret = cgTyOfTy(f.ret)
        let sptys: Array<Int32> = []
        s.ptys = sptys
        let j = 0
        while (j < f.ptys.length) {
            s.ptys.push(cgTyOfTy(f.ptys[j]))
            j = j + 1
        }
        s.isAsync = f.isAsync
        mgInsertSig(g, f.name, s)
        i = i + 1
    }
    // top-level code runs first AND declares its variables as globals, so it
    // must be generated before the lambdas and functions that reference those
    // variables (lambda bodies read top-level vars through the globals)
    if (c.hasToplevel) {
        g.toplevelGen = true
        mgGenSyncFnInto(g, "fn.__toplevel", mast.emptyInts(), mchek.emptyTys(), mchek.mkTy(mchek.tvVoid()), c.toplevel)
        g.toplevelGen = false
    }
    i = 0
    while (i < c.lambdas.length) {
        mgGenLambda(g, i)
        i = i + 1
    }
    i = 0
    while (i < c.fns.length) {
        let f = c.fns[i]
        if (f.isAsync) {
            mgGenAsyncFn(g, f)
        } else {
            mgGenSyncFn(g, f)
        }
        i = i + 1
    }
    mgGenMain(g)
    return mgRender(g)
}