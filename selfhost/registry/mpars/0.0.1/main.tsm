// mpars — recursive-descent parser for the self-hosted marina compiler
// (port of crates/marina/src/parser.rs).
//
// Rust's Result<T, ParseError> becomes an error field on the parser state:
// every fallible call is followed by an `if (p.err != "")` bail-out that
// returns a dummy node. Speculative parses (call type args) snapshot and
// restore the error state alongside the token position.

use mast
use malex

// ---------------------------------------------------------------------------
// Parser state + result
// ---------------------------------------------------------------------------

class Ps {
    toks: Array<Tok>
    pos: Int32
    err: string
    errLine: Int32
    errCol: Int32
}

class Pr {
    ok: bool
    prog: Program
    msg: string
    line: Int32
    col: Int32
}

// ---------------------------------------------------------------------------
// Token cursor helpers (mirror Parser::peek / bump / span / ...)
// ---------------------------------------------------------------------------

function psPeek(p: Ps): Tok {
    return p.toks[p.pos]
}

function psPeekAt(p: Ps, off: Int32): Tok {
    let i = p.pos + off
    if (i > p.toks.length - 1) {
        i = p.toks.length - 1
    }
    return p.toks[i]
}

function psSpanLine(p: Ps): Int32 {
    return psPeek(p).line
}

function psSpanCol(p: Ps): Int32 {
    return psPeek(p).col
}

function psBump(p: Ps): Tok {
    let t = psPeek(p)
    if (p.pos < p.toks.length - 1) {
        p.pos = p.pos + 1
    }
    return t
}

// record the first error only (mirrors early `?` propagation)
function psErr(p: Ps, msg: string): void {
    if (p.err == "") {
        p.err = msg
        p.errLine = psSpanLine(p)
        p.errCol = psSpanCol(p)
    }
}

function psIsP(p: Ps, id: Int32): bool {
    let t = psPeek(p)
    return t.kind == mast.tkP() && t.i == id
}

function psPeekIsP(t: Tok, id: Int32): bool {
    return t.kind == mast.tkP() && t.i == id
}

function psIsKw(p: Ps, id: Int32): bool {
    let t = psPeek(p)
    return t.kind == mast.tkKw() && t.i == id
}

function psIsIdent(p: Ps): bool {
    return psPeek(p).kind == mast.tkIdent()
}

function psIsEof(p: Ps): bool {
    return psPeek(p).kind == mast.tkEof()
}

function psEatP(p: Ps, id: Int32): bool {
    if (psIsP(p, id)) {
        psBump(p)
        return true
    }
    return false
}

function psExpectP(p: Ps, id: Int32, what: string): void {
    if (psIsP(p, id)) {
        psBump(p)
    } else {
        psErr(p, `expected '${what}'`)
    }
}

function psExpectIdent(p: Ps): string {
    if (psIsIdent(p)) {
        let name = psPeek(p).s
        psBump(p)
        return name
    }
    psErr(p, "expected an identifier")
    return ""
}

// ---------------------------------------------------------------------------
// Dummy nodes for bail-outs
// ---------------------------------------------------------------------------

function dmExpr(p: Ps): Expr {
    return mast.newExpr(mast.ekBool(), psSpanLine(p), psSpanCol(p))
}

function dmStmt(p: Ps): Stmt {
    return mast.newStmt(mast.skExpr(), psSpanLine(p), psSpanCol(p))
}

function dmTy(p: Ps): TyAnn {
    return mast.newTyAnn("", psSpanLine(p), psSpanCol(p))
}

// ---------------------------------------------------------------------------
// Type annotations
// ---------------------------------------------------------------------------

// `Name` / `pkg.Name` / `Name<T, U>`
function tyAnn(p: Ps): TyAnn {
    let line = psSpanLine(p)
    let col = psSpanCol(p)
    let name = psExpectIdent(p)
    if (p.err != "") {
        return dmTy(p)
    }
    let full = name
    while (psIsP(p, mast.pDot())) {
        psBump(p)
        let seg = psExpectIdent(p)
        if (p.err != "") {
            return dmTy(p)
        }
        full = `${full}.${seg}`
    }
    let a = mast.newTyAnn(full, line, col)
    if (psIsP(p, mast.pLt())) {
        psBump(p)
        let go = true
        while (go) {
            let t = tyAnn(p)
            if (p.err != "") {
                return dmTy(p)
            }
            a.args.push(t)
            if (!psEatP(p, mast.pComma())) {
                go = false
            }
        }
        psExpectP(p, mast.pGt(), ">")
        if (p.err != "") {
            return dmTy(p)
        }
    }
    return a
}

// `<T, U>` after a function/class name — empty when absent.
function typeParamList(p: Ps): Array<string> {
    let out = mast.emptyStrs()
    if (!psIsP(p, mast.pLt())) {
        return out
    }
    psBump(p)
    let go = true
    while (go) {
        let nm = psExpectIdent(p)
        if (p.err != "") {
            return out
        }
        out.push(nm)
        if (!psEatP(p, mast.pComma())) {
            go = false
        }
    }
    psExpectP(p, mast.pGt(), ">")
    if (p.err != "") {
        return out
    }
    return out
}

// ---------------------------------------------------------------------------
// Template parts: re-lex `${...}` raw sources and parse sub-expressions
// ---------------------------------------------------------------------------

function templateParts(p: Ps, tok: Tok): Array<TPart> {
    let out = mast.emptyTParts()
    let i = 0
    while (i < tok.parts.length) {
        let lp = tok.parts[i]
        if (!lp.isExpr) {
            out.push(mast.newTPartStr(lp.t))
        } else {
            let r = malex.lexSub(lp.t, lp.line, lp.col)
            if (!r.ok) {
                if (p.err == "") {
                    p.err = r.msg
                    p.errLine = r.line
                    p.errCol = r.col
                }
                return out
            }
            let sp = new Ps()
            sp.toks = r.toks
            sp.pos = 0
            sp.err = ""
            sp.errLine = 0
            sp.errCol = 0
            let e = pexpr(sp)
            if (sp.err != "") {
                if (p.err == "") {
                    p.err = sp.err
                    p.errLine = sp.errLine
                    p.errCol = sp.errCol
                }
                return out
            }
            if (psPeek(sp).kind != mast.tkEof()) {
                if (p.err == "") {
                    p.err = "unexpected tokens in template expression"
                    p.errLine = lp.line
                    p.errCol = lp.col
                }
                return out
            }
            out.push(mast.newTPartExpr(lp.t, e, lp.line, lp.col))
        }
        i++
    }
    return out
}

// consume a peeked template token and convert its parts
function parseTemplateToken(p: Ps): Array<TPart> {
    let tok = psPeek(p)
    psBump(p)
    return templateParts(p, tok)
}

// ---------------------------------------------------------------------------
// Lambda lookahead + speculative call type args
// ---------------------------------------------------------------------------

// is the '(' at the current position the start of `(params) => { ... }`?
function isLambdaAhead(p: Ps): bool {
    let i = p.pos
    let depth = 0
    let found = false
    let res = false
    while (!found && i < p.toks.length) {
        let t = p.toks[i]
        if (psPeekIsP(t, mast.pLParen())) {
            depth = depth + 1
        } else if (psPeekIsP(t, mast.pRParen())) {
            depth = depth - 1
            if (depth == 0) {
                let nt = p.toks[i + 1]
                found = true
                res = psPeekIsP(nt, mast.pArrow())
            }
        } else if (t.kind == mast.tkEof()) {
            found = true
            res = false
        }
        i = i + 1
    }
    return res
}

// speculatively parse `<T, U>(` — empty result (position + errors restored)
// means the `<` is a comparison instead
function tryCallTypeArgs(p: Ps): Array<TyAnn> {
    let save = p.pos
    let serr = p.err
    let sline = p.errLine
    let scol = p.errCol
    psBump(p) // <
    let tas = mast.emptyTyAnns()
    let ok = true
    let go = true
    while (go) {
        let t = tyAnn(p)
        if (p.err != "") {
            ok = false
            go = false
        } else {
            tas.push(t)
            if (!psEatP(p, mast.pComma())) {
                go = false
            }
        }
    }
    if (ok) {
        let gtOk = psEatP(p, mast.pGt())
        if (!gtOk || !psIsP(p, mast.pLParen())) {
            ok = false
        }
    }
    if (!ok) {
        p.pos = save
        p.err = serr
        p.errLine = sline
        p.errCol = scol
        return mast.emptyTyAnns()
    }
    return tas
}

// ---------------------------------------------------------------------------
// Primary expressions
// ---------------------------------------------------------------------------

function lambda(p: Ps, isAsync: bool): Expr {
    let line = psSpanLine(p)
    let col = psSpanCol(p)
    psExpectP(p, mast.pLParen(), "(")
    if (p.err != "") {
        return dmExpr(p)
    }
    let l = mast.newLambda(line, col)
    l.isAsync = isAsync
    if (!psEatP(p, mast.pRParen())) {
        let go = true
        while (go) {
            let pline = psSpanLine(p)
            let pcol = psSpanCol(p)
            let pname = psExpectIdent(p)
            if (p.err != "") {
                return dmExpr(p)
            }
            let prm = mast.newParam(pname, pline, pcol)
            if (psIsP(p, mast.pColon())) {
                psBump(p)
                let a = tyAnn(p)
                if (p.err != "") {
                    return dmExpr(p)
                }
                prm.ann = a
                prm.hasAnn = true
            }
            l.params.push(prm)
            if (!psEatP(p, mast.pComma())) {
                go = false
            }
        }
        psExpectP(p, mast.pRParen(), ")")
        if (p.err != "") {
            return dmExpr(p)
        }
    }
    psExpectP(p, mast.pArrow(), "=>")
    if (p.err != "") {
        return dmExpr(p)
    }
    if (!psIsP(p, mast.pLBrace())) {
        psErr(p, "lambda bodies must be a { block } in marina")
        return dmExpr(p)
    }
    l.body = block(p)
    if (p.err != "") {
        return dmExpr(p)
    }
    let e = mast.newExpr(mast.ekLambda(), line, col)
    e.lam = l
    return e
}

function primary(p: Ps): Expr {
    let line = psSpanLine(p)
    let col = psSpanCol(p)
    let t = psPeek(p)
    if (t.kind == mast.tkInt()) {
        psBump(p)
        let e = mast.newExpr(mast.ekInt(), line, col)
        e.ival = t.i
        return e
    }
    if (t.kind == mast.tkFloat()) {
        psBump(p)
        let e = mast.newExpr(mast.ekFloat(), line, col)
        e.fval = t.f
        return e
    }
    if (t.kind == mast.tkStr()) {
        psBump(p)
        let e = mast.newExpr(mast.ekStr(), line, col)
        e.sval = t.s
        return e
    }
    if (t.kind == mast.tkTemplate()) {
        psBump(p)
        let parts = templateParts(p, t)
        if (p.err != "") {
            return dmExpr(p)
        }
        let e = mast.newExpr(mast.ekTemplate(), line, col)
        e.parts = parts
        return e
    }
    if (psIsKw(p, mast.kwTrue())) {
        psBump(p)
        let e = mast.newExpr(mast.ekBool(), line, col)
        e.bval = true
        return e
    }
    if (psIsKw(p, mast.kwFalse())) {
        psBump(p)
        let e = mast.newExpr(mast.ekBool(), line, col)
        e.bval = false
        return e
    }
    if (psIsKw(p, mast.kwNew())) {
        psBump(p)
        let name = psExpectIdent(p)
        if (p.err != "") {
            return dmExpr(p)
        }
        if (name == "Promise" && psIsP(p, mast.pLParen())) {
            psExpectP(p, mast.pLParen(), "(")
            if (p.err != "") {
                return dmExpr(p)
            }
            let l = pexpr(p)
            if (p.err != "") {
                return dmExpr(p)
            }
            psExpectP(p, mast.pRParen(), ")")
            if (p.err != "") {
                return dmExpr(p)
            }
            let e = mast.newExpr(mast.ekNewPromise(), line, col)
            e.kids.push(l)
            return e
        }
        // dotted constructor path: `new http.Server()` etc.
        let path = mast.emptyStrs()
        path.push(name)
        while (psIsP(p, mast.pDot())) {
            psBump(p)
            let seg = psExpectIdent(p)
            if (p.err != "") {
                return dmExpr(p)
            }
            path.push(seg)
        }
        // optional explicit type args: `new Box<Int32>()` (single-segment only)
        let typeArgs = mast.emptyTyAnns()
        if (path.length == 1 && psIsP(p, mast.pLt())) {
            psBump(p)
            let go = true
            while (go) {
                let ta = tyAnn(p)
                if (p.err != "") {
                    return dmExpr(p)
                }
                typeArgs.push(ta)
                if (!psEatP(p, mast.pComma())) {
                    go = false
                }
            }
            psExpectP(p, mast.pGt(), ">")
            if (p.err != "") {
                return dmExpr(p)
            }
        }
        // constructor arguments
        let args = mast.emptyExprs()
        if (psIsP(p, mast.pLParen())) {
            psBump(p)
            if (!psEatP(p, mast.pRParen())) {
                let go2 = true
                while (go2) {
                    let a = pexpr(p)
                    if (p.err != "") {
                        return dmExpr(p)
                    }
                    args.push(a)
                    if (!psEatP(p, mast.pComma())) {
                        go2 = false
                    }
                }
                psExpectP(p, mast.pRParen(), ")")
                if (p.err != "") {
                    return dmExpr(p)
                }
            }
        }
        if (path.length == 1) {
            if (args.length == 0) {
                let e = mast.newExpr(mast.ekNewClass(), line, col)
                e.sval = path[0]
                e.targs = typeArgs
                return e
            }
            psErr(p, "classes take no constructor arguments (use `new ClassName()`)")
            return dmExpr(p)
        }
        let e = mast.newExpr(mast.ekNewCtor(), line, col)
        e.names = path
        e.args = args
        return e
    }
    if (psIsP(p, mast.pLBracket())) {
        psBump(p)
        let elems = mast.emptyExprs()
        if (!psEatP(p, mast.pRBracket())) {
            let go = true
            while (go) {
                let el = pexpr(p)
                if (p.err != "") {
                    return dmExpr(p)
                }
                elems.push(el)
                if (!psEatP(p, mast.pComma())) {
                    go = false
                } else if (psEatP(p, mast.pRBracket())) {
                    // trailing comma
                    let e = mast.newExpr(mast.ekArrayLit(), line, col)
                    e.args = elems
                    return e
                }
            }
            psExpectP(p, mast.pRBracket(), "]")
            if (p.err != "") {
                return dmExpr(p)
            }
        }
        let e = mast.newExpr(mast.ekArrayLit(), line, col)
        e.args = elems
        return e
    }
    if (psIsP(p, mast.pLBrace())) {
        // object literal: { field: expr, ... } (trailing comma ok)
        psBump(p)
        let names = mast.emptyStrs()
        let values = mast.emptyExprs()
        if (!psEatP(p, mast.pRBrace())) {
            let go = true
            while (go) {
                let fname = psExpectIdent(p)
                if (p.err != "") {
                    return dmExpr(p)
                }
                psExpectP(p, mast.pColon(), ":")
                if (p.err != "") {
                    return dmExpr(p)
                }
                let value = pexpr(p)
                if (p.err != "") {
                    return dmExpr(p)
                }
                names.push(fname)
                values.push(value)
                if (!psEatP(p, mast.pComma())) {
                    go = false
                } else if (psEatP(p, mast.pRBrace())) {
                    let e = mast.newExpr(mast.ekObjectLit(), line, col)
                    e.names = names
                    e.args = values
                    return e
                }
            }
            psExpectP(p, mast.pRBrace(), "}")
            if (p.err != "") {
                return dmExpr(p)
            }
        }
        let e = mast.newExpr(mast.ekObjectLit(), line, col)
        e.names = names
        e.args = values
        return e
    }
    if (psIsIdent(p)) {
        psBump(p)
        let e = mast.newExpr(mast.ekIdent(), line, col)
        e.sval = t.s
        return e
    }
    if (psIsKw(p, mast.kwAsync())) {
        // async lambda: `async (params) => { ... }`
        psBump(p)
        if (!isLambdaAhead(p)) {
            psErr(p, "expected (params) => { ... } after `async`")
            return dmExpr(p)
        }
        return lambda(p, true)
    }
    if (psIsP(p, mast.pLParen())) {
        if (isLambdaAhead(p)) {
            return lambda(p, false)
        }
        psBump(p)
        let e = pexpr(p)
        if (p.err != "") {
            return dmExpr(p)
        }
        psExpectP(p, mast.pRParen(), ")")
        if (p.err != "") {
            return dmExpr(p)
        }
        return e
    }
    psErr(p, "expected an expression")
    return dmExpr(p)
}

// ---------------------------------------------------------------------------
// Postfix expressions
// ---------------------------------------------------------------------------

function postfixExpr(p: Ps): Expr {
    let e = primary(p)
    if (p.err != "") {
        return dmExpr(p)
    }
    let go = true
    while (go) {
        if (psIsP(p, mast.pDot())) {
            psBump(p)
            let name = psExpectIdent(p)
            if (p.err != "") {
                return dmExpr(p)
            }
            let m = mast.newExpr(mast.ekMember(), psSpanLine(p), psSpanCol(p))
            m.sval = name
            m.kids.push(e)
            e = m
        } else if (psIsP(p, mast.pLParen())) {
            psBump(p)
            let args = mast.emptyExprs()
            if (!psEatP(p, mast.pRParen())) {
                let more = true
                while (more) {
                    let a = pexpr(p)
                    if (p.err != "") {
                        return dmExpr(p)
                    }
                    args.push(a)
                    if (!psEatP(p, mast.pComma())) {
                        more = false
                    }
                }
                psExpectP(p, mast.pRParen(), ")")
                if (p.err != "") {
                    return dmExpr(p)
                }
            }
            let c = mast.newExpr(mast.ekCall(), psSpanLine(p), psSpanCol(p))
            c.kids.push(e)
            c.args = args
            e = c
        } else if (psIsP(p, mast.pLt())) {
            // speculative `<...>(` type args; restored (comparison) otherwise
            let save = p.pos
            let tas = tryCallTypeArgs(p)
            if (tas.length > 0) {
                psBump(p) // (
                let args = mast.emptyExprs()
                if (!psEatP(p, mast.pRParen())) {
                    let more = true
                    while (more) {
                        let a = pexpr(p)
                        if (p.err != "") {
                            return dmExpr(p)
                        }
                        args.push(a)
                        if (!psEatP(p, mast.pComma())) {
                            more = false
                        }
                    }
                    psExpectP(p, mast.pRParen(), ")")
                    if (p.err != "") {
                        return dmExpr(p)
                    }
                }
                let c = mast.newExpr(mast.ekCallGen(), psSpanLine(p), psSpanCol(p))
                c.targs = tas
                c.kids.push(e)
                c.args = args
                e = c
            } else {
                p.pos = save
                go = false
            }
        } else if (psIsP(p, mast.pLBracket())) {
            psBump(p)
            let idx = pexpr(p)
            if (p.err != "") {
                return dmExpr(p)
            }
            psExpectP(p, mast.pRBracket(), "]")
            if (p.err != "") {
                return dmExpr(p)
            }
            let ix = mast.newExpr(mast.ekIndex(), psSpanLine(p), psSpanCol(p))
            ix.kids.push(e)
            ix.kids.push(idx)
            e = ix
        } else if (psPeek(p).kind == mast.tkTemplate()) {
            // tagged template: `sql.stmt`...``
            let parts = parseTemplateToken(p)
            if (p.err != "") {
                return dmExpr(p)
            }
            let tg = mast.newExpr(mast.ekTagged(), psSpanLine(p), psSpanCol(p))
            tg.kids.push(e)
            tg.parts = parts
            e = tg
        } else {
            go = false
        }
    }
    return e
}

// ---------------------------------------------------------------------------
// Unary + binary precedence chain
// ---------------------------------------------------------------------------

function unaryExpr(p: Ps): Expr {
    let line = psSpanLine(p)
    let col = psSpanCol(p)
    if (psIsKw(p, mast.kwAwait())) {
        psBump(p)
        let inner = unaryExpr(p)
        if (p.err != "") {
            return dmExpr(p)
        }
        let e = mast.newExpr(mast.ekAwait(), line, col)
        e.kids.push(inner)
        return e
    }
    if (psIsP(p, mast.pMinus())) {
        psBump(p)
        let inner = unaryExpr(p)
        if (p.err != "") {
            return dmExpr(p)
        }
        let e = mast.newExpr(mast.ekUnary(), line, col)
        e.opv = mast.uoNeg()
        e.kids.push(inner)
        return e
    }
    if (psIsP(p, mast.pBang())) {
        psBump(p)
        let inner = unaryExpr(p)
        if (p.err != "") {
            return dmExpr(p)
        }
        let e = mast.newExpr(mast.ekUnary(), line, col)
        e.opv = mast.uoNot()
        e.kids.push(inner)
        return e
    }
    return postfixExpr(p)
}

function mulExpr(p: Ps): Expr {
    let l = unaryExpr(p)
    if (p.err != "") {
        return dmExpr(p)
    }
    let go = true
    while (go) {
        let op = 0
        if (psIsP(p, mast.pStar())) {
            op = mast.boMul()
        } else if (psIsP(p, mast.pSlash())) {
            op = mast.boDiv()
        } else if (psIsP(p, mast.pPercent())) {
            op = mast.boMod()
        } else {
            go = false
        }
        if (go) {
            let line = psSpanLine(p)
            let col = psSpanCol(p)
            psBump(p)
            let r = unaryExpr(p)
            if (p.err != "") {
                return dmExpr(p)
            }
            let b = mast.newExpr(mast.ekBinary(), line, col)
            b.opv = op
            b.kids.push(l)
            b.kids.push(r)
            l = b
        }
    }
    return l
}

function addExpr(p: Ps): Expr {
    let l = mulExpr(p)
    if (p.err != "") {
        return dmExpr(p)
    }
    let go = true
    while (go) {
        let op = 0
        if (psIsP(p, mast.pPlus())) {
            op = mast.boAdd()
        } else if (psIsP(p, mast.pMinus())) {
            op = mast.boSub()
        } else {
            go = false
        }
        if (go) {
            let line = psSpanLine(p)
            let col = psSpanCol(p)
            psBump(p)
            let r = mulExpr(p)
            if (p.err != "") {
                return dmExpr(p)
            }
            let b = mast.newExpr(mast.ekBinary(), line, col)
            b.opv = op
            b.kids.push(l)
            b.kids.push(r)
            l = b
        }
    }
    return l
}

function relExpr(p: Ps): Expr {
    let l = addExpr(p)
    if (p.err != "") {
        return dmExpr(p)
    }
    let go = true
    while (go) {
        let op = 0
        if (psIsP(p, mast.pLt())) {
            op = mast.boLt()
        } else if (psIsP(p, mast.pGt())) {
            op = mast.boGt()
        } else if (psIsP(p, mast.pLe())) {
            op = mast.boLe()
        } else if (psIsP(p, mast.pGe())) {
            op = mast.boGe()
        } else {
            go = false
        }
        if (go) {
            let line = psSpanLine(p)
            let col = psSpanCol(p)
            psBump(p)
            let r = addExpr(p)
            if (p.err != "") {
                return dmExpr(p)
            }
            let b = mast.newExpr(mast.ekBinary(), line, col)
            b.opv = op
            b.kids.push(l)
            b.kids.push(r)
            l = b
        }
    }
    return l
}

function eqExpr(p: Ps): Expr {
    let l = relExpr(p)
    if (p.err != "") {
        return dmExpr(p)
    }
    let go = true
    while (go) {
        let op = 0
        if (psIsP(p, mast.pEq())) {
            op = mast.boEq()
        } else if (psIsP(p, mast.pNeq())) {
            op = mast.boNeq()
        } else {
            go = false
        }
        if (go) {
            let line = psSpanLine(p)
            let col = psSpanCol(p)
            psBump(p)
            let r = relExpr(p)
            if (p.err != "") {
                return dmExpr(p)
            }
            let b = mast.newExpr(mast.ekBinary(), line, col)
            b.opv = op
            b.kids.push(l)
            b.kids.push(r)
            l = b
        }
    }
    return l
}

function andExpr(p: Ps): Expr {
    let l = eqExpr(p)
    if (p.err != "") {
        return dmExpr(p)
    }
    let go = true
    while (go) {
        if (psIsP(p, mast.pAndAnd())) {
            let line = psSpanLine(p)
            let col = psSpanCol(p)
            psBump(p)
            let r = eqExpr(p)
            if (p.err != "") {
                return dmExpr(p)
            }
            let b = mast.newExpr(mast.ekBinary(), line, col)
            b.opv = mast.boAnd()
            b.kids.push(l)
            b.kids.push(r)
            l = b
        } else {
            go = false
        }
    }
    return l
}

function pexpr(p: Ps): Expr {
    let l = andExpr(p)
    if (p.err != "") {
        return dmExpr(p)
    }
    let go = true
    while (go) {
        if (psIsP(p, mast.pOrOr())) {
            let line = psSpanLine(p)
            let col = psSpanCol(p)
            psBump(p)
            let r = andExpr(p)
            if (p.err != "") {
                return dmExpr(p)
            }
            let b = mast.newExpr(mast.ekBinary(), line, col)
            b.opv = mast.boOr()
            b.kids.push(l)
            b.kids.push(r)
            l = b
        } else {
            go = false
        }
    }
    return l
}

// ---------------------------------------------------------------------------
// Statements
// ---------------------------------------------------------------------------

// given that toks[pos+off] is `[`, find the offset of its matching `]`
// (nesting counted); -1 if unbalanced before EOF
function matchingBracket(p: Ps, off: Int32): Int32 {
    let depth = 0
    let i = p.pos + off
    while (i < p.toks.length) {
        let t = p.toks[i]
        if (psPeekIsP(t, mast.pLBracket())) {
            depth = depth + 1
        } else if (psPeekIsP(t, mast.pRBracket())) {
            depth = depth - 1
            if (depth == 0) {
                return i - p.pos
            }
        } else if (t.kind == mast.tkEof()) {
            return -1
        }
        i = i + 1
    }
    return -1
}

// assignment (`a = e`), compound (`a += e`, `a--`), or plain expression
function simpleStmt(p: Ps): Stmt {
    if (psIsIdent(p)) {
        let name = psPeek(p).s
        let line = psSpanLine(p)
        let col = psSpanCol(p)
        let t1 = psPeekAt(p, 1)
        if (psPeekIsP(t1, mast.pAssign())) {
            psBump(p)
            psBump(p) // =
            let value = pexpr(p)
            if (p.err != "") {
                return dmStmt(p)
            }
            psEatP(p, mast.pSemi())
            let s = mast.newStmt(mast.skAssign(), line, col)
            s.name = name
            s.e1 = value
            s.hasE1 = true
            return s
        }
        if (psPeekIsP(t1, mast.pPlusAssign()) || psPeekIsP(t1, mast.pMinusAssign())) {
            let op = mast.boAdd()
            if (psPeekIsP(t1, mast.pMinusAssign())) {
                op = mast.boSub()
            }
            psBump(p)
            psBump(p) // += or -=
            let rhs = pexpr(p)
            if (p.err != "") {
                return dmStmt(p)
            }
            psEatP(p, mast.pSemi())
            let id = mast.newExpr(mast.ekIdent(), line, col)
            id.sval = name
            let value = mast.newExpr(mast.ekBinary(), line, col)
            value.opv = op
            value.kids.push(id)
            value.kids.push(rhs)
            let s = mast.newStmt(mast.skAssign(), line, col)
            s.name = name
            s.e1 = value
            s.hasE1 = true
            return s
        }
        if (psPeekIsP(t1, mast.pPlusPlus()) || psPeekIsP(t1, mast.pMinusMinus())) {
            let op = mast.boAdd()
            if (psPeekIsP(t1, mast.pMinusMinus())) {
                op = mast.boSub()
            }
            psBump(p)
            psBump(p) // ++ or --
            psEatP(p, mast.pSemi())
            let id = mast.newExpr(mast.ekIdent(), line, col)
            id.sval = name
            let one = mast.newExpr(mast.ekInt(), line, col)
            one.ival = 1
            let value = mast.newExpr(mast.ekBinary(), line, col)
            value.opv = op
            value.kids.push(id)
            value.kids.push(one)
            let s = mast.newStmt(mast.skAssign(), line, col)
            s.name = name
            s.e1 = value
            s.hasE1 = true
            return s
        }
    }
    let e = pexpr(p)
    if (p.err != "") {
        return dmStmt(p)
    }
    psEatP(p, mast.pSemi())
    let s = mast.newStmt(mast.skExpr(), e.line, e.col)
    s.e1 = e
    s.hasE1 = true
    return s
}

function letStmt(p: Ps): Stmt {
    let line = psSpanLine(p)
    let col = psSpanCol(p)
    let isConst = psIsKw(p, mast.kwConst())
    psBump(p)
    let name = psExpectIdent(p)
    if (p.err != "") {
        return dmStmt(p)
    }
    let s = mast.newStmt(mast.skLet(), line, col)
    s.name = name
    s.isConst = isConst
    if (psIsP(p, mast.pColon())) {
        psBump(p)
        let a = tyAnn(p)
        if (p.err != "") {
            return dmStmt(p)
        }
        s.ann = a
        s.hasAnn = true
    }
    if (!psEatP(p, mast.pAssign())) {
        psErr(p, "declarations must be initialized (marina has no 'undefined')")
        return dmStmt(p)
    }
    let init = pexpr(p)
    if (p.err != "") {
        return dmStmt(p)
    }
    s.e1 = init
    s.hasE1 = true
    psEatP(p, mast.pSemi())
    return s
}

function ifStmt(p: Ps): Stmt {
    let line = psSpanLine(p)
    let col = psSpanCol(p)
    psBump(p) // if
    let cond = pexpr(p)
    if (p.err != "") {
        return dmStmt(p)
    }
    let thenBody = block(p)
    if (p.err != "") {
        return dmStmt(p)
    }
    let s = mast.newStmt(mast.skIf(), line, col)
    s.e1 = cond
    s.hasE1 = true
    s.body = thenBody
    if (psIsKw(p, mast.kwElse())) {
        psBump(p)
        if (psIsKw(p, mast.kwIf())) {
            let nested = ifStmt(p)
            if (p.err != "") {
                return dmStmt(p)
            }
            s.els.push(nested)
        } else {
            let els = block(p)
            if (p.err != "") {
                return dmStmt(p)
            }
            s.els = els
        }
    }
    psEatP(p, mast.pSemi())
    return s
}

function whileStmt(p: Ps): Stmt {
    let line = psSpanLine(p)
    let col = psSpanCol(p)
    psBump(p)
    let cond = pexpr(p)
    if (p.err != "") {
        return dmStmt(p)
    }
    let body = block(p)
    if (p.err != "") {
        return dmStmt(p)
    }
    psEatP(p, mast.pSemi())
    let s = mast.newStmt(mast.skWhile(), line, col)
    s.e1 = cond
    s.hasE1 = true
    s.body = body
    return s
}

function forStmt(p: Ps): Stmt {
    let line = psSpanLine(p)
    let col = psSpanCol(p)
    psBump(p) // for
    psExpectP(p, mast.pLParen(), "(")
    if (p.err != "") {
        return dmStmt(p)
    }
    let s = mast.newStmt(mast.skFor(), line, col)
    if (psIsP(p, mast.pSemi())) {
        psBump(p)
    } else if (psIsKw(p, mast.kwLet()) || psIsKw(p, mast.kwConst())) {
        let init = letStmt(p)
        if (p.err != "") {
            return dmStmt(p)
        }
        s.s1 = init
        s.hasS1 = true
    } else {
        let init = simpleStmt(p)
        if (p.err != "") {
            return dmStmt(p)
        }
        s.s1 = init
        s.hasS1 = true
    }
    if (!psIsP(p, mast.pSemi())) {
        let cond = pexpr(p)
        if (p.err != "") {
            return dmStmt(p)
        }
        s.e1 = cond
        s.hasE1 = true
    }
    psExpectP(p, mast.pSemi(), ";")
    if (p.err != "") {
        return dmStmt(p)
    }
    if (!psIsP(p, mast.pRParen())) {
        let upd = simpleStmt(p)
        if (p.err != "") {
            return dmStmt(p)
        }
        s.s2 = upd
        s.hasS2 = true
    }
    psExpectP(p, mast.pRParen(), ")")
    if (p.err != "") {
        return dmStmt(p)
    }
    let body = block(p)
    if (p.err != "") {
        return dmStmt(p)
    }
    s.body = body
    psEatP(p, mast.pSemi())
    return s
}

function stmt(p: Ps): Stmt {
    if (psIsKw(p, mast.kwLet()) || psIsKw(p, mast.kwConst())) {
        return letStmt(p)
    }
    if (psIsKw(p, mast.kwReturn())) {
        let line = psSpanLine(p)
        let col = psSpanCol(p)
        psBump(p)
        let s = mast.newStmt(mast.skReturn(), line, col)
        if (!psIsP(p, mast.pSemi()) && !psIsP(p, mast.pRBrace()) && !psIsEof(p)) {
            let value = pexpr(p)
            if (p.err != "") {
                return dmStmt(p)
            }
            s.e1 = value
            s.hasE1 = true
        }
        psEatP(p, mast.pSemi())
        return s
    }
    if (psIsKw(p, mast.kwIf())) {
        return ifStmt(p)
    }
    if (psIsKw(p, mast.kwFor())) {
        return forStmt(p)
    }
    if (psIsKw(p, mast.kwWhile())) {
        return whileStmt(p)
    }
    if (psIsKw(p, mast.kwFunction()) || psIsKw(p, mast.kwAsync())) {
        psErr(p, "functions must be declared at the top level of the file")
        return dmStmt(p)
    }
    if (psIsIdent(p)) {
        // `list[i] = value` — lookahead for `=` after the matching `]`
        if (psPeekIsP(psPeekAt(p, 1), mast.pLBracket())) {
            let end = matchingBracket(p, 1)
            if (end >= 0) {
                if (psPeekIsP(psPeekAt(p, end + 1), mast.pAssign())) {
                    let line = psSpanLine(p)
                    let col = psSpanCol(p)
                    let name = psExpectIdent(p)
                    if (p.err != "") {
                        return dmStmt(p)
                    }
                    psBump(p) // [
                    let index = pexpr(p)
                    if (p.err != "") {
                        return dmStmt(p)
                    }
                    psExpectP(p, mast.pRBracket(), "]")
                    if (p.err != "") {
                        return dmStmt(p)
                    }
                    psBump(p) // =
                    let value = pexpr(p)
                    if (p.err != "") {
                        return dmStmt(p)
                    }
                    psEatP(p, mast.pSemi())
                    let s = mast.newStmt(mast.skIndexAssign(), line, col)
                    s.name = name
                    s.e1 = index
                    s.e2 = value
                    s.hasE1 = true
                    s.hasE2 = true
                    return s
                }
            }
        }
        // `obj.field = value` and compound forms (`obj.f += x`, `obj.f++`)
        if (psPeekIsP(psPeekAt(p, 1), mast.pDot())) {
            let t0 = psPeek(p)
            let t2 = psPeekAt(p, 2)
            if (t0.kind == mast.tkIdent() && t2.kind == mast.tkIdent()) {
                let opT = psPeekAt(p, 3)
                // delta: 3 = plain `=`, 1 = add-form, 2 = sub-form, 0 = not an assign
                let delta = 0
                if (psPeekIsP(opT, mast.pAssign())) {
                    delta = 3
                } else if (psPeekIsP(opT, mast.pPlusAssign()) || psPeekIsP(opT, mast.pPlusPlus())) {
                    delta = 1
                } else if (psPeekIsP(opT, mast.pMinusAssign()) || psPeekIsP(opT, mast.pMinusMinus())) {
                    delta = 2
                }
                if (delta != 0) {
                    let line = psSpanLine(p)
                    let col = psSpanCol(p)
                    let obj = psExpectIdent(p)
                    if (p.err != "") {
                        return dmStmt(p)
                    }
                    psBump(p) // .
                    let field = psExpectIdent(p)
                    if (p.err != "") {
                        return dmStmt(p)
                    }
                    let fobj = mast.newExpr(mast.ekIdent(), line, col)
                    fobj.sval = obj
                    let fexpr = mast.newExpr(mast.ekMember(), line, col)
                    fexpr.sval = field
                    fexpr.kids.push(fobj)
                    let value = dmExpr(p)
                    if (delta == 3) {
                        psBump(p) // =
                        value = pexpr(p)
                        if (p.err != "") {
                            return dmStmt(p)
                        }
                    } else {
                        psBump(p) // += -= ++ --
                        let rhs = dmExpr(p)
                        if (psIsP(p, mast.pSemi()) || psIsP(p, mast.pRBrace()) || psIsEof(p)) {
                            // ++ / -- need no operand
                            rhs = mast.newExpr(mast.ekInt(), line, col)
                            rhs.ival = 1
                        } else {
                            rhs = pexpr(p)
                            if (p.err != "") {
                                return dmStmt(p)
                            }
                        }
                        value = mast.newExpr(mast.ekBinary(), line, col)
                        if (delta == 1) {
                            value.opv = mast.boAdd()
                        } else {
                            value.opv = mast.boSub()
                        }
                        value.kids.push(fexpr)
                        value.kids.push(rhs)
                    }
                    psEatP(p, mast.pSemi())
                    let s = mast.newStmt(mast.skMemberAssign(), line, col)
                    s.name = obj
                    s.field = field
                    s.e1 = value
                    s.hasE1 = true
                    return s
                }
            }
        }
    }
    return simpleStmt(p)
}

function block(p: Ps): Array<Stmt> {
    let stmts = mast.emptyStmts()
    psExpectP(p, mast.pLBrace(), "{")
    if (p.err != "") {
        return stmts
    }
    while (!psIsP(p, mast.pRBrace()) && !psIsEof(p) && p.err == "") {
        let s = stmt(p)
        if (p.err == "") {
            stmts.push(s)
        }
    }
    if (psIsEof(p) && p.err == "") {
        psErr(p, "expected '}' before end of file")
        return stmts
    }
    if (p.err == "") {
        psBump(p) // }
    }
    return stmts
}

// ---------------------------------------------------------------------------
// Declarations + program
// ---------------------------------------------------------------------------

function fnDecl(p: Ps): FnDecl {
    let line = psSpanLine(p)
    let col = psSpanCol(p)
    let isAsync = psIsKw(p, mast.kwAsync())
    if (isAsync) {
        psBump(p)
    }
    if (!psIsKw(p, mast.kwFunction())) {
        psErr(p, "expected 'function' after 'async'")
        return mast.newFnDecl("", line, col)
    }
    psBump(p)
    let name = psExpectIdent(p)
    if (p.err != "") {
        return mast.newFnDecl("", line, col)
    }
    let f = mast.newFnDecl(name, line, col)
    f.isAsync = isAsync
    f.typeParams = typeParamList(p)
    if (p.err != "") {
        return f
    }
    psExpectP(p, mast.pLParen(), "(")
    if (p.err != "") {
        return f
    }
    if (!psEatP(p, mast.pRParen())) {
        let go = true
        while (go) {
            let pline = psSpanLine(p)
            let pcol = psSpanCol(p)
            let pname = psExpectIdent(p)
            if (p.err != "") {
                return f
            }
            let prm = mast.newParam(pname, pline, pcol)
            if (psIsP(p, mast.pColon())) {
                psBump(p)
                let a = tyAnn(p)
                if (p.err != "") {
                    return f
                }
                prm.ann = a
                prm.hasAnn = true
            }
            f.params.push(prm)
            if (!psEatP(p, mast.pComma())) {
                go = false
            }
        }
        psExpectP(p, mast.pRParen(), ")")
        if (p.err != "") {
            return f
        }
    }
    if (psIsP(p, mast.pColon())) {
        psBump(p)
        let r = tyAnn(p)
        if (p.err != "") {
            return f
        }
        f.retAnn = r
        f.hasRet = true
    }
    f.body = block(p)
    if (p.err != "") {
        return f
    }
    return f
}

function classDecl(p: Ps): ClassDecl {
    let line = psSpanLine(p)
    let col = psSpanCol(p)
    psBump(p) // class
    let name = psExpectIdent(p)
    if (p.err != "") {
        return mast.newClassDecl("", line, col)
    }
    let c = mast.newClassDecl("", line, col)
    c.name = name
    c.typeParams = typeParamList(p)
    if (p.err != "") {
        return c
    }
    psExpectP(p, mast.pLBrace(), "{")
    if (p.err != "") {
        return c
    }
    while (!psIsP(p, mast.pRBrace()) && !psIsEof(p) && p.err == "") {
        // optional `public` modifier (accepted and ignored)
        if (psIsIdent(p) && psPeek(p).s == "public") {
            psBump(p)
        }
        let fname = psExpectIdent(p)
        if (p.err != "") {
            return c
        }
        psExpectP(p, mast.pColon(), ":")
        if (p.err != "") {
            return c
        }
        let ty = tyAnn(p)
        if (p.err != "") {
            return c
        }
        let fd = mast.newFieldDecl(fname, ty, ty.line, ty.col)
        c.fields.push(fd)
        psEatP(p, mast.pComma())
        psEatP(p, mast.pSemi())
    }
    if (psIsEof(p) && p.err == "") {
        psErr(p, "expected '}' before end of file")
        return c
    }
    if (p.err == "") {
        psBump(p) // }
    }
    return c
}

function interfaceDecl(p: Ps): IfaceDecl {
    let line = psSpanLine(p)
    let col = psSpanCol(p)
    psBump(p) // interface
    let name = psExpectIdent(p)
    if (p.err != "") {
        return mast.newIfaceDecl("", line, col)
    }
    let it = mast.newIfaceDecl("", line, col)
    it.name = name
    psExpectP(p, mast.pLBrace(), "{")
    if (p.err != "") {
        return it
    }
    while (!psIsP(p, mast.pRBrace()) && !psIsEof(p) && p.err == "") {
        let fname = psExpectIdent(p)
        if (p.err != "") {
            return it
        }
        psExpectP(p, mast.pColon(), ":")
        if (p.err != "") {
            return it
        }
        let a = tyAnn(p)
        if (p.err != "") {
            return it
        }
        // duplicate-field check (linear scan mirrors the Rust HashSet)
        let dup = false
        let j = 0
        while (j < it.fields.length) {
            if (it.fields[j].name == fname) {
                dup = true
            }
            j = j + 1
        }
        if (dup) {
            psErr(p, "duplicate field in interface")
            return it
        }
        let fd = mast.newFieldDecl(fname, a, a.line, a.col)
        it.fields.push(fd)
        if (!psEatP(p, mast.pComma()) && !psIsP(p, mast.pRBrace())) {
            psExpectP(p, mast.pSemi(), ";")
            if (p.err != "") {
                return it
            }
        }
    }
    if (psIsEof(p) && p.err == "") {
        psErr(p, "expected '}' before end of file")
        return it
    }
    if (p.err == "") {
        psBump(p) // }
    }
    return it
}

function program(p: Ps): Program {
    let prog = mast.newProgram()
    while (!psIsEof(p) && p.err == "") {
        if (psIsKw(p, mast.kwFunction()) || psIsKw(p, mast.kwAsync())) {
            let f = fnDecl(p)
            if (p.err != "") {
                return prog
            }
            prog.fns.push(f)
        } else if (psIsKw(p, mast.kwClass())) {
            let c = classDecl(p)
            if (p.err != "") {
                return prog
            }
            prog.classes.push(c)
        } else if (psIsKw(p, mast.kwInterface())) {
            let it = interfaceDecl(p)
            if (p.err != "") {
                return prog
            }
            prog.ifaces.push(it)
        } else if (psIsKw(p, mast.kwUse())) {
            let line = psSpanLine(p)
            let col = psSpanCol(p)
            psBump(p) // use
            let name = psExpectIdent(p)
            if (p.err != "") {
                return prog
            }
            psEatP(p, mast.pSemi())
            prog.useNames.push(name)
            prog.useLines.push(line)
            prog.useCols.push(col)
        } else if (psIsKw(p, mast.kwImport())) {
            psErr(p, "`import` statements are not supported — declare modules with `use <module>`")
            return prog
        } else {
            let s = stmt(p)
            if (p.err != "") {
                return prog
            }
            prog.stmts.push(s)
        }
    }
    return prog
}

// parse a token stream into a Program (mirrors parser::parse)
function parse(toks: Array<Tok>): Pr {
    let p = new Ps()
    p.toks = toks
    p.pos = 0
    p.err = ""
    p.errLine = 0
    p.errCol = 0
    let prog = program(p)
    let r = new Pr()
    if (p.err != "") {
        r.ok = false
        r.prog = prog
        r.msg = p.err
        r.line = p.errLine
        r.col = p.errCol
    } else {
        r.ok = true
        r.prog = prog
        r.msg = ""
        r.line = 0
        r.col = 0
    }
    return r
}