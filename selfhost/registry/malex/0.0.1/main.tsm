// malex — lexer for the marina language, written in marina itself.
// 1:1 port of crates/marina/src/lexer.rs onto the Rust-side primitives
// (charAt/substring/length). Deviations (documented bootstrap trade-offs):
//   - positions are byte-based (ASCII sources are identical to the Rust lexer)
//   - identifier bytes >= 0x80 are treated as alphabetic (no Unicode tables)
//   - integer/float literal parsing is hand-rolled; the i64/i32 range
//     boundary at exactly 2^63 classifies as "does not fit in Int32"

use mast

class Lx {
    src: string
    pos: Int32
    line: Int32
    col: Int32
    baseLine: Int32      // -1: no base span override
    baseCol: Int32
    err: string          // "" = no error; set by scanning helpers
    errLine: Int32
    errCol: Int32
}

class LexResult {
    ok: bool
    toks: Array<Tok>
    msg: string
    line: Int32
    col: Int32
}

function newLx(src: string, baseLine: Int32, baseCol: Int32): Lx {
    let st = new Lx()
    st.src = src
    st.pos = 0
    st.line = 1
    st.col = 1
    st.baseLine = baseLine
    st.baseCol = baseCol
    st.err = ""
    st.errLine = 0
    st.errCol = 0
    return st
}

function lxSpanLine(st: Lx): Int32 {
    if (st.baseLine >= 0) {
        return st.baseLine
    }
    return st.line
}

function lxSpanCol(st: Lx): Int32 {
    if (st.baseLine >= 0) {
        return st.baseCol
    }
    return st.col
}

function lxPeek(st: Lx): Int32 {
    if (st.pos >= st.src.length) {
        return 0
    }
    return st.src.charAt(st.pos)
}

function lxPeek2(st: Lx): Int32 {
    if (st.pos + 1 >= st.src.length) {
        return 0
    }
    return st.src.charAt(st.pos + 1)
}

function lxBump(st: Lx): Int32 {
    let c = lxPeek(st)
    if (st.pos >= st.src.length) {
        return 0
    }
    st.pos = st.pos + 1
    if (c == 10) {
        st.line = st.line + 1
        st.col = 1
    } else {
        st.col = st.col + 1
    }
    return c
}


function lxErr(st: Lx, msg: string): void {
    st.err = msg
    st.errLine = lxSpanLine(st)
    st.errCol = lxSpanCol(st)
}

function isIdentStart(c: Int32): bool {
    if ((c >= 97 && c <= 122) || (c >= 65 && c <= 90)) {
        return true
    }
    if (c == 95 || c == 36) {
        return true
    }
    return c >= 128
}

function isDigit(c: Int32): bool {
    return c >= 48 && c <= 57
}

function lexResultErr(msg: string, line: Int32, col: Int32): LexResult {
    let r = new LexResult()
    r.ok = false
    r.msg = msg
    r.line = line
    r.col = col
    return r
}

// ---------------------------------------------------------------------------
// string scanning
// ---------------------------------------------------------------------------

// caller has consumed the backslash
function scanEscape(st: Lx, quote: Int32): string {
    let c = lxBump(st)
    if (c == 110) {
        return "\n"
    }
    if (c == 116) {
        return "\t"
    }
    if (c == 114) {
        return "\r"
    }
    if (c == 48) {
        return "\0"
    }
    if (c == 92) {
        return "\\"
    }
    if (c == quote) {
        return st.src.substring(st.pos - 1, st.pos)
    }
    if (c == 36) {
        return "$"
    }
    if (c == 0) {
        lxErr(st, "unterminated escape sequence")
        return ""
    }
    return st.src.substring(st.pos - 1, st.pos)
}

function scanString(st: Lx, quote: Int32): string {
    lxBump(st) // opening quote
    let s = ""
    while (true) {
        if (st.err != "") {
            return ""
        }
        let c = lxPeek(st)
        if (st.pos >= st.src.length) {
            lxErr(st, "unterminated string literal")
            return ""
        }
        if (c == quote) {
            lxBump(st)
            return s
        }
        if (c == 92) {
            lxBump(st)
            s = `${s}${scanEscape(st, quote)}`
        } else {
            s = `${s}${st.src.substring(st.pos, st.pos + 1)}`
            lxBump(st)
        }
    }
    return s
}

// nested-template skip inside ${...}
function skipNestedTemplate(st: Lx): void {
    lxBump(st) // opening backtick
    let tdepth = 0
    while (true) {
        if (st.err != "") {
            return
        }
        if (st.pos >= st.src.length) {
            lxErr(st, "unterminated template in template expression")
            return
        }
        let c = lxPeek(st)
        if (c == 92) {
            lxBump(st)
            lxBump(st)
        } else if (c == 36 && lxPeek2(st) == 123) {
            lxBump(st)
            lxBump(st)
            tdepth++
        } else if (c == 125 && tdepth > 0) {
            tdepth--
            lxBump(st)
        } else if (c == 96) {
            lxBump(st)
            if (tdepth == 0) {
                return
            }
            tdepth = 0
        } else {
            lxBump(st)
        }
    }
}

// quoted string skip inside ${...}; appends consumed bytes to raw
function skipQuoted(st: Lx, raw: string, q: Int32): string {
    let out = `${raw}${st.src.substring(st.pos, st.pos + 1)}`
    lxBump(st)
    while (true) {
        if (st.err != "") {
            return out
        }
        if (st.pos >= st.src.length) {
            lxErr(st, "unterminated string in template expression")
            return out
        }
        let c = lxPeek(st)
        if (c == 92) {
            lxBump(st)
            out = `${out}\\`
            let e = lxBump(st)
            if (e != 0) {
                out = `${out}${st.src.substring(st.pos - 1, st.pos)}`
            }
        } else if (c == q) {
            out = `${out}${st.src.substring(st.pos, st.pos + 1)}`
            lxBump(st)
            return out
        } else {
            out = `${out}${st.src.substring(st.pos, st.pos + 1)}`
            lxBump(st)
        }
    }
    return out
}

function noParts(): Array<TPart> {
    let a: Array<TPart> = []
    return a
}

function scanTemplate(st: Lx): Array<TPart> {
    lxBump(st) // opening backtick
    let parts: Array<TPart> = []
    let buf = ""
    while (true) {
        if (st.err != "") {
            return noParts()
        }
        let spLine = lxSpanLine(st)
        let spCol = lxSpanCol(st)
        if (st.pos >= st.src.length) {
            lxErr(st, "unterminated template literal")
            return noParts()
        }
        let c = lxPeek(st)
        if (c == 96) {
            lxBump(st)
            if (buf.length > 0 || parts.length == 0) {
                parts.push(mast.newTPartStr(buf))
            }
            return parts
        }
        if (c == 92) {
            lxBump(st)
            buf = `${buf}${scanEscape(st, 96)}`
        } else if (c == 36 && lxPeek2(st) == 123) {
            lxBump(st)
            lxBump(st)
            let raw = ""
            let depth = 1
            while (depth > 0) {
                if (st.err != "") {
                    return noParts()
                }
                if (st.pos >= st.src.length) {
                    lxErr(st, "unterminated ${...} in template literal")
                    return noParts()
                }
                let c2 = lxPeek(st)
                if (c2 == 125) {
                    depth--
                    lxBump(st)
                    if (depth > 0) {
                        raw = `${raw}}`
                    }
                } else if (c2 == 123) {
                    depth++
                    raw = `${raw}{`
                    lxBump(st)
                } else if (c2 == 34 || c2 == 39) {
                    raw = skipQuoted(st, raw, c2)
                } else if (c2 == 96) {
                    skipNestedTemplate(st)
                } else {
                    raw = `${raw}${st.src.substring(st.pos, st.pos + 1)}`
                    lxBump(st)
                }
            }
            parts.push(mast.newTPartStr(buf))
            parts.push(mast.newTPartExpr(raw, mast.newExpr(mast.ekBool(), spLine, spCol), spLine, spCol))
            buf = ""
        } else {
            buf = `${buf}${st.src.substring(st.pos, st.pos + 1)}`
            lxBump(st)
        }
    }
    return parts
}

// ---------------------------------------------------------------------------
// number scanning — hand-rolled parsing (no runtime parse primitives)
// ---------------------------------------------------------------------------

function pow10(k: Int32): Float64 {
    let v = 1.0
    let i = 0
    while (i < k) {
        v = v * 10.0
        i++
    }
    return v
}

function parseFloatHand(text: string): Float64 {
    // split mantissa / exponent at 'e' or 'E'
    let mEnd = 0
    while (mEnd < text.length && text.charAt(mEnd) != 101 && text.charAt(mEnd) != 69) {
        mEnd++
    }
    let mant = text.substring(0, mEnd)
    let exp = 0
    let expNeg = false
    if (mEnd < text.length) {
        let j = mEnd + 1
        if (j < text.length && (text.charAt(j) == 43 || text.charAt(j) == 45)) {
            if (text.charAt(j) == 45) {
                expNeg = true
            }
            j++
        }
        while (j < text.length) {
            exp = exp * 10 + (text.charAt(j) - 48)
            j++
        }
    }
    // mantissa: integer part + fraction
    let dot = 0
    while (dot < mant.length && mant.charAt(dot) != 46) {
        dot++
    }
    let ip = 0.0
    let i = 0
    while (i < dot) {
        ip = ip * 10.0 + (mant.charAt(i) - 48) * 1.0
        i++
    }
    let fp = 0.0
    let flen = mant.length - dot - 1
    let j = dot + 1
    while (j < mant.length) {
        fp = fp * 10.0 + (mant.charAt(j) - 48) * 1.0
        j++
    }
    let v = ip + fp / pow10(flen)
    if (expNeg) {
        v = v / pow10(exp)
    } else {
        v = v * pow10(exp)
    }
    return v
}

// Exact Int32 accumulation with overflow detection; huge inputs are
// classified separately (out of i64 range vs does not fit in Int32).
// flags[0]: 1 = overflowed i32; flags[1]: 1 = beyond i64 range.
function parseIntHand(text: string, flags: Array<Int32>): Int32 {
    // strip leading zeros for length-based classification
    let z = 0
    while (z < text.length - 1 && text.charAt(z) == 48) {
        z++
    }
    let digits = text.substring(z, text.length)
    if (digits.length > 19) {
        flags[1] = 1
        return 0
    }
    if (digits.length >= 11) {
        // classify with a float accumulator (2^53-exact digits are enough
        // to decide the range for 11..19 digit inputs)
        let f = 0.0
        let i = 0
        while (i < digits.length) {
            f = f * 10.0 + (digits.charAt(i) - 48) * 1.0
            i++
        }
        if (f > 9223372036854775807.0) {
            flags[1] = 1
        } else {
            flags[0] = 1
        }
        return 0
    }
    let acc = 0
    let i = 0
    while (i < digits.length) {
        let d = digits.charAt(i) - 48
        if (acc > 214748364 || (acc == 214748364 && d > 7)) {
            flags[0] = 1
            return 0
        }
        acc = acc * 10 + d
        i++
    }
    return acc
}

function scanNumber(st: Lx, tokLine: Int32, tokCol: Int32): Tok {
    let start = st.pos
    let isFloat = false
    let more = true
    while (more) {
        let c = lxPeek(st)
        if (isDigit(c)) {
            lxBump(st)
        } else if (c == 46 && !isFloat && isDigit(lxPeek2(st))) {
            isFloat = true
            lxBump(st)
        } else if ((c == 101 || c == 69) && st.pos > start && isDigit(st.src.charAt(st.pos - 1))) {
            isFloat = true
            lxBump(st)
            let sign = lxPeek(st)
            if (sign == 43 || sign == 45) {
                lxBump(st)
            }
        } else {
            more = false
        }
    }
    let text = st.src.substring(start, st.pos)
    let t = mast.newTok(0, tokLine, tokCol)
    if (isFloat) {
        t.kind = mast.tkFloat()
        t.f = parseFloatHand(text)
    } else {
        let flags: Array<Int32> = [0, 0]
        let iv = parseIntHand(text, flags)
        if (flags[1] == 1) {
            lxErr(st, "integer literal out of range")
            return t
        }
        if (flags[0] == 1) {
            lxErr(st, "integer literal does not fit in Int32")
            return t
        }
        t.kind = mast.tkInt()
        t.i = iv
    }
    return t
}

// ---------------------------------------------------------------------------
// punctuation
// ---------------------------------------------------------------------------

function scanPunct(st: Lx, tokLine: Int32, tokCol: Int32): Tok {
    let c = lxBump(st)
    let t = mast.newTok(mast.tkP(), tokLine, tokCol)
    if (c == 43) {
        if (lxPeek(st) == 43) {
            lxBump(st)
            t.i = mast.pPlusPlus()
        } else if (lxPeek(st) == 61) {
            lxBump(st)
            t.i = mast.pPlusAssign()
        } else {
            t.i = mast.pPlus()
        }
        return t
    }
    if (c == 45) {
        if (lxPeek(st) == 45) {
            lxBump(st)
            t.i = mast.pMinusMinus()
        } else if (lxPeek(st) == 61) {
            lxBump(st)
            t.i = mast.pMinusAssign()
        } else {
            t.i = mast.pMinus()
        }
        return t
    }
    if (c == 42) { t.i = mast.pStar(); return t }
    if (c == 47) { t.i = mast.pSlash(); return t }
    if (c == 37) { t.i = mast.pPercent(); return t }
    if (c == 61) {
        if (lxPeek(st) == 61) {
            lxBump(st)
            t.i = mast.pEq()
        } else if (lxPeek(st) == 62) {
            lxBump(st)
            t.i = mast.pArrow()
        } else {
            t.i = mast.pAssign()
        }
        return t
    }
    if (c == 33) {
        if (lxPeek(st) == 61) {
            lxBump(st)
            t.i = mast.pNeq()
        } else {
            t.i = mast.pBang()
        }
        return t
    }
    if (c == 60) {
        if (lxPeek(st) == 61) {
            lxBump(st)
            t.i = mast.pLe()
        } else {
            t.i = mast.pLt()
        }
        return t
    }
    if (c == 62) {
        if (lxPeek(st) == 61) {
            lxBump(st)
            t.i = mast.pGe()
        } else {
            t.i = mast.pGt()
        }
        return t
    }
    if (c == 38) {
        if (lxPeek(st) == 38) {
            lxBump(st)
            t.i = mast.pAndAnd()
            return t
        }
        lxErr(st, "single '&' is not valid (use '&&')")
        return t
    }
    if (c == 124) {
        if (lxPeek(st) == 124) {
            lxBump(st)
            t.i = mast.pOrOr()
            return t
        }
        lxErr(st, "single '|' is not valid (use '||')")
        return t
    }
    if (c == 40) { t.i = mast.pLParen(); return t }
    if (c == 41) { t.i = mast.pRParen(); return t }
    if (c == 123) { t.i = mast.pLBrace(); return t }
    if (c == 125) { t.i = mast.pRBrace(); return t }
    if (c == 91) { t.i = mast.pLBracket(); return t }
    if (c == 93) { t.i = mast.pRBracket(); return t }
    if (c == 44) { t.i = mast.pComma(); return t }
    if (c == 58) { t.i = mast.pColon(); return t }
    if (c == 59) { t.i = mast.pSemi(); return t }
    if (c == 46) { t.i = mast.pDot(); return t }
    lxErr(st, `unexpected character '${st.src.substring(st.pos - 1, st.pos)}'`)
    return t
}

// ---------------------------------------------------------------------------
// trivia + main loop
// ---------------------------------------------------------------------------

function skipTrivia(st: Lx): void {
    let go = true
    while (go) {
        let c = lxPeek(st)
        if (c == 32 || c == 9 || c == 13 || c == 10) {
            lxBump(st)
        } else if (c == 47 && lxPeek2(st) == 47) {
            while (st.pos < st.src.length && lxPeek(st) != 10) {
                lxBump(st)
            }
        } else if (c == 47 && lxPeek2(st) == 42) {
            lxBump(st)
            lxBump(st)
            let open = true
            while (open) {
                if (st.pos >= st.src.length) {
                    open = false
                } else if (lxPeek(st) == 42 && lxPeek2(st) == 47) {
                    lxBump(st)
                    lxBump(st)
                    open = false
                } else {
                    lxBump(st)
                }
            }
        } else {
            go = false
        }
    }
}

function kwId(name: string): Int32 {
    if (name == "let") { return mast.kwLet() }
    if (name == "const") { return mast.kwConst() }
    if (name == "function") { return mast.kwFunction() }
    if (name == "async") { return mast.kwAsync() }
    if (name == "await") { return mast.kwAwait() }
    if (name == "return") { return mast.kwReturn() }
    if (name == "if") { return mast.kwIf() }
    if (name == "else") { return mast.kwElse() }
    if (name == "while") { return mast.kwWhile() }
    if (name == "for") { return mast.kwFor() }
    if (name == "true") { return mast.kwTrue() }
    if (name == "false") { return mast.kwFalse() }
    if (name == "new") { return mast.kwNew() }
    if (name == "class") { return mast.kwClass() }
    if (name == "use") { return mast.kwUse() }
    if (name == "import") { return mast.kwImport() }
    if (name == "interface") { return mast.kwInterface() }
    return 0
}

function runLexer(st: Lx): LexResult {
    let out: Array<Tok> = []
    let live = true
    while (live) {
        skipTrivia(st)
        let line = lxSpanLine(st)
        let col = lxSpanCol(st)
        if (st.err != "") {
            return lexResultErr(st.err, st.errLine, st.errCol)
        }
        if (st.pos >= st.src.length) {
            let eof = mast.newTok(mast.tkEof(), line, col)
            out.push(eof)
            let r = new LexResult()
            r.ok = true
            r.toks = out
            return r
        }
        let c = lxPeek(st)
        let tok: Tok = mast.newTok(0, line, col)
        if (c == 34 || c == 39) {
            let s = scanString(st, c)
            if (st.err != "") {
                return lexResultErr(st.err, st.errLine, st.errCol)
            }
            tok.kind = mast.tkStr()
            tok.s = s
        } else if (c == 96) {
            let parts = scanTemplate(st)
            if (st.err != "") {
                return lexResultErr(st.err, st.errLine, st.errCol)
            }
            tok.kind = mast.tkTemplate()
            tok.parts = parts
        } else if (isDigit(c)) {
            let n = scanNumber(st, line, col)
            if (st.err != "") {
                return lexResultErr(st.err, st.errLine, st.errCol)
            }
            tok = n
        } else if (isIdentStart(c)) {
            let start = st.pos
            while (isIdentStart(lxPeek(st)) || isDigit(lxPeek(st))) {
                lxBump(st)
            }
            let name = st.src.substring(start, st.pos)
            let k = kwId(name)
            if (k > 0) {
                tok.kind = mast.tkKw()
                tok.i = k
            } else {
                tok.kind = mast.tkIdent()
                tok.s = name
            }
        } else {
            let p = scanPunct(st, line, col)
            if (st.err != "") {
                return lexResultErr(st.err, st.errLine, st.errCol)
            }
            tok = p
        }
        out.push(tok)
    }
    return lexResultErr("unreachable", 0, 0)
}

/// Lex a source string (top-level entry, mirrors lexer::lex).
function lex(src: string): LexResult {
    let st = newLx(src, -1, -1)
    return runLexer(st)
}

/// Re-lex a template interpolation; spans collapse onto the `${`.
function lexSub(src: string, baseLine: Int32, baseCol: Int32): LexResult {
    let st = newLx(src, baseLine, baseCol)
    return runLexer(st)
}