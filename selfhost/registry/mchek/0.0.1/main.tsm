// mchek — strict type checker for the self-hosted marina compiler
// (port of crates/marina/src/checker.rs).
//
// Rust enums become fat structs with kind tags; Result<(A, B)> pairs become
// out-fields on the checker state (lookupRes / aRes / aTy / cbIdx / cbRet).
// HashMaps become parallel arrays with linear scans (fine at compiler scale).

use mast

// ---------------------------------------------------------------------------
// Checked types (CTy)
// ---------------------------------------------------------------------------

function tvVoid(): Int32 { return 1 }
function tvInt(): Int32 { return 2 }
function tvFloat(): Int32 { return 3 }
function tvBool(): Int32 { return 4 }
function tvStr(): Int32 { return 5 }
function tvPromise(): Int32 { return 6 }
function tvResolver(): Int32 { return 7 }
function tvArray(): Int32 { return 8 }
function tvObject(): Int32 { return 9 }
function tvStream(): Int32 { return 10 }
function tvIface(): Int32 { return 11 }

class Ty {
    k: Int32
    elem: Ty          // Promise/Array/Resolver payload
    oid: Int32        // object: class id
    oname: string     // object: display name
    iname: string     // interface name
}

function mkTy(k: Int32): Ty {
    let t = new Ty()
    t.k = k
    // elem placeholder (Rust side uses Option::None): a detached Ty that is
    // never followed unless k is Promise/Array/Resolver, where mk*Ty sets it
    let e = new Ty()
    e.k = tvVoid()
    t.elem = e
    t.oid = -1
    t.oname = ""
    t.iname = ""
    return t
}

function mkPromiseTy(elem: Ty): Ty {
    let t = mkTy(tvPromise())
    t.elem = elem
    return t
}

function mkArrayTy(elem: Ty): Ty {
    let t = mkTy(tvArray())
    t.elem = elem
    return t
}

function mkResolverTy(elem: Ty): Ty {
    let t = mkTy(tvResolver())
    t.elem = elem
    return t
}

function mkObjectTy(id: Int32, name: string): Ty {
    let t = mkTy(tvObject())
    t.oid = id
    t.oname = name
    return t
}

function mkIfaceTy(name: string): Ty {
    let t = mkTy(tvIface())
    t.iname = name
    return t
}

// structural equality (objects compare by id; matches derived PartialEq)
function tyEq(a: Ty, b: Ty): bool {
    if (a.k != b.k) {
        return false
    }
    if (a.k == tvPromise() || a.k == tvArray() || a.k == tvResolver()) {
        return tyEq(a.elem, b.elem)
    }
    if (a.k == tvObject()) {
        return a.oid == b.oid
    }
    if (a.k == tvIface()) {
        return a.iname == b.iname
    }
    return true
}

function tyName(t: Ty): string {
    if (t.k == tvVoid()) { return "void" }
    if (t.k == tvInt()) { return "Int32" }
    if (t.k == tvFloat()) { return "Float64" }
    if (t.k == tvBool()) { return "bool" }
    if (t.k == tvStr()) { return "string" }
    if (t.k == tvPromise()) { return `Promise<${tyName(t.elem)}>` }
    if (t.k == tvResolver()) { return `Resolver<${tyName(t.elem)}>` }
    if (t.k == tvArray()) { return `Array<${tyName(t.elem)}>` }
    if (t.k == tvObject()) { return t.oname }
    if (t.k == tvStream()) { return "Stream" }
    return t.iname
}

function isNumeric(t: Ty): bool {
    return t.k == tvInt() || t.k == tvFloat()
}

// ---------------------------------------------------------------------------
// Checked IR: statements, expressions, lambdas, functions
// ---------------------------------------------------------------------------

function csLet(): Int32 { return 1 }
function csAssign(): Int32 { return 2 }
function csIf(): Int32 { return 3 }
function csWhile(): Int32 { return 4 }
function csIndexSet(): Int32 { return 5 }
function csFieldSet(): Int32 { return 6 }
function csIfaceSet(): Int32 { return 7 }
function csFor(): Int32 { return 8 }
function csReturn(): Int32 { return 9 }
function csExpr(): Int32 { return 10 }

function ceInt(): Int32 { return 1 }
function ceFloat(): Int32 { return 2 }
function ceBool(): Int32 { return 3 }
function ceStr(): Int32 { return 4 }
function ceTemplate(): Int32 { return 5 }
function ceIdent(): Int32 { return 6 }
function ceUnary(): Int32 { return 7 }
function ceBinary(): Int32 { return 8 }
function ceCallFn(): Int32 { return 9 }
function ceCallResolver(): Int32 { return 10 }
function ceAwait(): Int32 { return 11 }
function ceNewPromise(): Int32 { return 12 }
function ceConsoleLog(): Int32 { return 13 }
function ceSetTimeout(): Int32 { return 14 }
function ceArrayLit(): Int32 { return 15 }
function ceIndex(): Int32 { return 16 }
function ceArrayOp(): Int32 { return 17 }
function ceArrayHof(): Int32 { return 18 }
function ceLambdaVal(): Int32 { return 19 }
function ceStrLen(): Int32 { return 20 }
function ceStrMethod(): Int32 { return 21 }
function ceFsArgs(): Int32 { return 22 }
function ceObjectLit(): Int32 { return 23 }
function ceNewClass(): Int32 { return 24 }
function ceFieldGet(): Int32 { return 25 }
function ceNetConnect(): Int32 { return 26 }
function ceNetWrite(): Int32 { return 27 }
function ceNetReadAll(): Int32 { return 28 }
function ceNetClose(): Int32 { return 29 }
function ceIfaceGet(): Int32 { return 30 }
function ceIfaceSet(): Int32 { return 31 }
function ceFsReadFile(): Int32 { return 32 }
function ceFsWriteFile(): Int32 { return 33 }
function ceFsExists(): Int32 { return 34 }
function ceFsReadDir(): Int32 { return 35 }
function ceFsMkdir(): Int32 { return 36 }
function ceFsRemove(): Int32 { return 37 }
function ceCryptoSha256(): Int32 { return 38 }
function ceCryptoBase64(): Int32 { return 39 }
function ceCryptoRandomHex(): Int32 { return 40 }
function ceCryptoUuid(): Int32 { return 41 }

// binary ops (BinOpC — same ids as mast bo*)
function bcAdd(): Int32 { return 1 }
function bcSub(): Int32 { return 2 }
function bcMul(): Int32 { return 3 }
function bcDiv(): Int32 { return 4 }
function bcMod(): Int32 { return 5 }
function bcLt(): Int32 { return 6 }
function bcGt(): Int32 { return 7 }
function bcLe(): Int32 { return 8 }
function bcGe(): Int32 { return 9 }
function bcEq(): Int32 { return 10 }
function bcNeq(): Int32 { return 11 }
function bcAnd(): Int32 { return 12 }
function bcOr(): Int32 { return 13 }

function ucNeg(): Int32 { return 1 }
function ucNot(): Int32 { return 2 }

// array op kinds
function aoPush(): Int32 { return 1 }
function aoPop(): Int32 { return 2 }
function aoShift(): Int32 { return 3 }
function aoUnshift(): Int32 { return 4 }
function aoSplice(): Int32 { return 5 }
function aoSlice(): Int32 { return 6 }
function aoConcat(): Int32 { return 7 }
function aoJoin(): Int32 { return 8 }
function aoReverse(): Int32 { return 9 }
function aoSort(): Int32 { return 10 }
function aoLen(): Int32 { return 11 }

// higher-order kinds
function hofForEach(): Int32 { return 1 }
function hofMap(): Int32 { return 2 }
function hofFilter(): Int32 { return 3 }
function hofReduce(): Int32 { return 4 }

// string method kinds
function smCharAt(): Int32 { return 1 }
function smSubstring(): Int32 { return 2 }

// lambda ABIs
function abPlain(): Int32 { return 1 }
function abForEach(): Int32 { return 2 }
function abMapFilter(): Int32 { return 3 }
function abReduce(): Int32 { return 4 }
function abListen(): Int32 { return 5 }

// return kinds
function rkPlain(): Int32 { return 1 }
function rkFlatten(): Int32 { return 2 }

class TPartC {
    isExpr: bool
    t: string
    e: CEx
}

class CEx {
    k: Int32
    ival: Int32
    fval: Float64
    bval: bool
    sval: string       // CallFn name, Str value
    opv: Int32         // BinOpC / UnOpC / ArrayOpKind / HofKind / StrOpKind
    id: Int32          // var id / class id / lambda idx / field idx
    ty: Ty             // carried result/element type
    kids: Array<CEx>   // positional sub-expressions
    args: Array<CEx>   // call / op / literal arguments
    iidx: Array<Int32> // object-lit field indices (parallel to args)
    parts: Array<TPartC>
    ex: bool           // CallFn is_async / Base64 decode
}

function newCEx(k: Int32): CEx {
    let e = new CEx()
    e.k = k
    e.ival = 0
    e.fval = 0.0
    e.bval = false
    e.sval = ""
    e.opv = 0
    e.id = -1
    e.ty = mkTy(tvVoid())
    e.kids = emptyCExs()
    e.args = emptyCExs()
    e.iidx = mast.emptyInts()
    e.parts = emptyTPartsC()
    e.ex = false
    return e
}

function emptyCExs(): Array<CEx> {
    let a: Array<CEx> = []
    return a
}

function emptyTPartsC(): Array<TPartC> {
    let a: Array<TPartC> = []
    return a
}

function emptyCSts(): Array<CSt> {
    let a: Array<CSt> = []
    return a
}

function emptyTys(): Array<Ty> {
    let a: Array<Ty> = []
    return a
}

class CSt {
    k: Int32
    id: Int32          // let/assign/indexset/fieldset/ifaceset target var id
    ty: Ty             // let declared type / element type of set ops
    e1: CEx            // init / value / cond / index
    e2: CEx            // index-set value
    hasE1: bool
    s1: CSt
    hasS1: bool
    s2: CSt
    hasS2: bool
    body: Array<CSt>
    els: Array<CSt>
    retKind: Int32     // rkPlain / rkFlatten
    fid: Int32         // field index for FieldSet
    fname: string      // field name for IfaceSet
}

function newCSt(k: Int32): CSt {
    let s = new CSt()
    s.k = k
    s.id = -1
    s.ty = mkTy(tvVoid())
    s.e1 = newCEx(ceBool())
    s.e2 = newCEx(ceBool())
    s.hasE1 = false
    s.hasS1 = false
    s.hasS2 = false
    s.body = emptyCSts()
    s.els = emptyCSts()
    s.retKind = rkPlain()
    s.fid = -1
    s.fname = ""
    return s
}

class CLam {
    pids: Array<Int32>
    ptys: Array<Ty>
    cids: Array<Int32>
    ctys: Array<Ty>
    body: Array<CSt>
    ret: Ty
    abi: Int32
    isExecutor: bool
    isAsync: bool
}

function newCLam(abi: Int32, isExecutor: bool, isAsync: bool): CLam {
    let l = new CLam()
    l.pids = mast.emptyInts()
    l.ptys = emptyTys()
    l.cids = mast.emptyInts()
    l.ctys = emptyTys()
    l.body = emptyCSts()
    l.ret = mkTy(tvVoid())
    l.abi = abi
    l.isExecutor = isExecutor
    l.isAsync = isAsync
    return l
}

class CFn {
    name: string
    pids: Array<Int32>
    ptys: Array<Ty>
    ret: Ty
    isAsync: bool
    body: Array<CSt>
}

class ClassDef {
    name: string
    fnames: Array<string>
    ftys: Array<Ty>
    isGhost: bool
}

class IfaceDef {
    name: string
    fnames: Array<string>
    ftys: Array<Ty>
}

// ---------------------------------------------------------------------------
// Checker state
// ---------------------------------------------------------------------------

class Sig {
    params: Array<Ty>
    hasRet: bool
    ret: Ty
    isAsync: bool
}

class Scope {
    names: Array<string>
    ids: Array<Int32>
    consts: Array<bool>
}

function newScope(): Scope {
    let s = new Scope()
    s.names = mast.emptyStrs()
    s.ids = mast.emptyInts()
    let cs: Array<bool> = []
    s.consts = cs
    return s
}

class ChkResult {
    ok: bool
    fns: Array<CFn>
    lambdas: Array<CLam>
    hasToplevel: bool
    toplevel: Array<CSt>
    explicitMain: bool
    varTypes: Array<Ty>
    varNames: Array<string>
    classes: Array<ClassDef>
    hasAsyncMain: bool
    hasSyncMain: bool
    msgs: Array<string>
    dlines: Array<Int32>
    dcols: Array<Int32>
}

class Ck {
    sigNames: Array<string>
    sigs: Array<Sig>
    varTypes: Array<Ty>
    varNames: Array<string>
    nextId: Int32
    dmsgs: Array<string>
    dlines: Array<Int32>
    dcols: Array<Int32>
    lambdas: Array<CLam>
    scopes: Array<Scope>
    isAsync: bool
    hasRet: bool
    retTy: Ty
    sawFloatRet: bool
    hasLastRet: bool
    lastFnRet: Ty
    pinfHas: bool
    pinfTy: Ty
    pinfFloat: bool
    inToplevel: bool
    blockDepth: Int32
    lambdaBase: Array<Int32>
    lambdaIdx: Array<Int32>
    curCaps: Array<Capt>
    lamRetOk: Array<bool>
    rejectIds: Array<Int32>
    classes: Array<ClassDef>
    cbNames: Array<string>
    cbIds: Array<Int32>
    ghostCount: Int32
    uses: Array<string>
    topVarIds: Array<Int32>
    genFnNames: Array<string>
    genFnDecls: Array<FnDecl>
    genClsNames: Array<string>
    genClsDecls: Array<ClassDecl>
    ifaces: Array<IfaceDef>
    monoFns: Array<CFn>
    // out-fields for multi-value returns
    lookupRes: bool
    loId: Int32
    loTy: Ty
    loCap: bool
    aRes: CEx
    aTy: Ty
    cbIdx: Int32
    cbRet: Ty
}

class Capt {
    ids: Array<Int32>
    tys: Array<Ty>
}

function newCapt(): Capt {
    let c = new Capt()
    c.ids = mast.emptyInts()
    c.tys = emptyTys()
    return c
}

// ---------------------------------------------------------------------------
// Naming conventions (is_camel_case etc.)
// ---------------------------------------------------------------------------

// camelCase: starts lowercase, then letters/digits only
function isCamelCase(s: string): bool {
    if (s.length == 0) {
        return false
    }
    let c0 = s.charAt(0)
    if (!(c0 >= 97 && c0 <= 122)) {
        return false
    }
    let i = 1
    while (i < s.length) {
        let c = s.charAt(i)
        if (!((c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57))) {
            return false
        }
        i = i + 1
    }
    return true
}

// package-merged function names `pkg__fn`
function isNamespacedFn(s: string): bool {
    // find "__"
    let idx = -1
    let i = 0
    while (i + 1 < s.length) {
        if (s.charAt(i) == 95 && s.charAt(i + 1) == 95) {
            idx = i
            i = s.length
        } else {
            i = i + 1
        }
    }
    if (idx <= 0) {
        return false
    }
    let pkg = s.substring(0, idx)
    let f = s.substring(idx + 2, s.length)
    if (pkg.length == 0) {
        return false
    }
    let j = 0
    while (j < pkg.length) {
        let c = pkg.charAt(j)
        if (!((c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95)) {
            return false
        }
        j = j + 1
    }
    return isCamelCase(f)
}

// UPPER_SNAKE_CASE: uppercase letters, digits, underscores; not starting with a digit
function isUpperSnakeCase(s: string): bool {
    if (s.length == 0) {
        return false
    }
    let c0 = s.charAt(0)
    if (!((c0 >= 65 && c0 <= 90) || c0 == 95)) {
        return false
    }
    let i = 0
    while (i < s.length) {
        let c = s.charAt(i)
        if (!((c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95)) {
            return false
        }
        i = i + 1
    }
    return true
}

// PascalCase: starts uppercase, then letters/digits only
function isPascalCase(s: string): bool {
    if (s.length == 0) {
        return false
    }
    let c0 = s.charAt(0)
    if (!(c0 >= 65 && c0 <= 90)) {
        return false
    }
    let i = 1
    while (i < s.length) {
        let c = s.charAt(i)
        if (!((c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57))) {
            return false
        }
        i = i + 1
    }
    return true
}
// ---------------------------------------------------------------------------
// State helpers
// ---------------------------------------------------------------------------

function ckDiag(c: Ck, msg: string, line: Int32, col: Int32): void {
    c.dmsgs.push(msg)
    c.dlines.push(line)
    c.dcols.push(col)
}

function ckFreshId(c: Ck): Int32 {
    let id = c.nextId
    c.nextId = c.nextId + 1
    c.varTypes.push(mkTy(tvVoid()))
    c.varNames.push("")
    return id
}

function ckSigOf(c: Ck, name: string): Sig {
    let i = 0
    while (i < c.sigNames.length) {
        if (c.sigNames[i] == name) {
            return c.sigs[i]
        }
        i = i + 1
    }
    let none = new Sig()
    none.params = emptyTys()
    none.hasRet = false
    none.ret = mkTy(tvVoid())
    none.isAsync = false
    return none
}

function ckHasSig(c: Ck, name: string): bool {
    let i = 0
    while (i < c.sigNames.length) {
        if (c.sigNames[i] == name) {
            return true
        }
        i = i + 1
    }
    return false
}

function ckInsertSig(c: Ck, name: string, s: Sig): void {
    let i = 0
    while (i < c.sigNames.length) {
        if (c.sigNames[i] == name) {
            let sa = c.sigs
            sa[i] = s
            return
        }
        i = i + 1
    }
    c.sigNames.push(name)
    c.sigs.push(s)
}

function ckClassIdOf(c: Ck, name: string): Int32 {
    let i = 0
    while (i < c.cbNames.length) {
        if (c.cbNames[i] == name) {
            return c.cbIds[i]
        }
        i = i + 1
    }
    return -1
}

function ckIfaceIdx(c: Ck, name: string): Int32 {
    let i = 0
    while (i < c.ifaces.length) {
        if (c.ifaces[i].name == name) {
            return i
        }
        i = i + 1
    }
    return -1
}

// ---------------------------------------------------------------------------
// Types from annotations
// ---------------------------------------------------------------------------

function ckTyOf(c: Ck, a: TyAnn): Ty {
    let nm = a.name
    let nArgs = a.args.length
    if (nm == "int" || nm == "Int32" || nm == "i32") { return mkTy(tvInt()) }
    if (nm == "float" || nm == "Float64" || nm == "f64" || nm == "double" || nm == "number") {
        return mkTy(tvFloat())
    }
    if (nm == "string" || nm == "String") { return mkTy(tvStr()) }
    if (nm == "bool" || nm == "boolean" || nm == "Boolean") { return mkTy(tvBool()) }
    if (nm == "void" || nm == "undefined") { return mkTy(tvVoid()) }
    if (nm == "Stream" || nm == "stream") { return mkTy(tvStream()) }
    if (nm == "Promise") {
        if (nArgs > 0) {
            return mkPromiseTy(ckTyOf(c, a.args[0]))
        }
        ckDiag(c, "Promise requires a type parameter, e.g. Promise<string>", a.line, a.col)
        return mkPromiseTy(mkTy(tvVoid()))
    }
    if (nm == "Array") {
        if (nArgs > 0) {
            return mkArrayTy(ckTyOf(c, a.args[0]))
        }
        ckDiag(c, "Array requires a type parameter, e.g. Array<Int32>", a.line, a.col)
        return mkArrayTy(mkTy(tvInt()))
    }
    let cid = ckClassIdOf(c, nm)
    let genIdx = ckGenClsIdx(c, nm)
    let t = mkTy(tvVoid())
    if (cid >= 0 || genIdx >= 0) {
        if (genIdx >= 0) {
            if (nArgs == 0) {
                ckDiag(c, `generic class '${nm}' needs type parameters, e.g. ${nm}<Int32>`, a.line, a.col)
                return mkTy(tvVoid())
            }
            return ckMonoClass(c, nm, a.args, a.line, a.col)
        }
        if (nArgs > 0) {
            ckDiag(c, `class '${nm}' does not take type parameters`, a.line, a.col)
        }
        t = mkObjectTy(cid, c.classes[cid].name)
    } else if (nArgs == 0 && ckIfaceIdx(c, nm) >= 0) {
        t = mkIfaceTy(nm)
    } else {
        ckDiag(c, `unknown type '${nm}'`, a.line, a.col)
        t = mkTy(tvVoid())
    }
    if (nm != "Promise" && nm != "Array" && nArgs > 0) {
        ckDiag(c, `type '${nm}' does not take type parameters`, a.line, a.col)
    }
    return t
}

function ckGenClsIdx(c: Ck, name: string): Int32 {
    let i = 0
    while (i < c.genClsNames.length) {
        if (c.genClsNames[i] == name) {
            return i
        }
        i = i + 1
    }
    return -1
}

function ckGenFnIdx(c: Ck, name: string): Int32 {
    let i = 0
    while (i < c.genFnNames.length) {
        if (c.genFnNames[i] == name) {
            return i
        }
        i = i + 1
    }
    return -1
}

// ---------------------------------------------------------------------------
// Coercion (Int32 -> Float64 widening + interface conformance)
// ---------------------------------------------------------------------------

function ckCoerceQuiet(c: Ck, from: Ty, to: Ty): bool {
    if (tyEq(from, to)) {
        return true
    }
    if (from.k == tvIface()) {
        let ii = ckIfaceIdx(c, from.iname)
        if (ii >= 0) {
            if (c.ifaces[ii].fnames.length == 0) {
                return true
            }
        }
    }
    if (from.k == tvInt() && to.k == tvFloat()) {
        return true
    }
    if (to.k == tvIface() && from.k == tvObject()) {
        return ckIfaceConformQuiet(c, from.oid, to.iname)
    }
    if (from.k == tvIface() && to.k == tvObject()) {
        return ckIfaceConformQuiet(c, to.oid, from.iname)
    }
    return false
}

function ckIfaceConformQuiet(c: Ck, classId: Int32, iname: string): bool {
    let ii = ckIfaceIdx(c, iname)
    if (ii < 0 || classId < 0 || classId >= c.classes.length) {
        return false
    }
    let idef = c.ifaces[ii]
    let cdef = c.classes[classId]
    let j = 0
    while (j < idef.fnames.length) {
        let fname = idef.fnames[j]
        let fty = idef.ftys[j]
        let found = false
        let k = 0
        while (k < cdef.fnames.length) {
            if (cdef.fnames[k] == fname) {
                let t = cdef.ftys[k]
                if (!tyEq(t, fty) && !(t.k == tvInt() && fty.k == tvFloat())) {
                    return false
                }
                found = true
                k = cdef.fnames.length
            } else {
                k = k + 1
            }
        }
        if (!found) {
            return false
        }
        j = j + 1
    }
    return true
}

function ckIfaceConform(c: Ck, classId: Int32, iname: string, line: Int32, col: Int32): bool {
    let ii = ckIfaceIdx(c, iname)
    if (ii < 0 || classId < 0 || classId >= c.classes.length) {
        return false
    }
    let idef = c.ifaces[ii]
    let cdef = c.classes[classId]
    let ok = true
    let j = 0
    while (j < idef.fnames.length) {
        let fname = idef.fnames[j]
        let fty = idef.ftys[j]
        let found = false
        let k = 0
        while (k < cdef.fnames.length) {
            if (cdef.fnames[k] == fname) {
                let t = cdef.ftys[k]
                if (!tyEq(t, fty) && !(t.k == tvInt() && fty.k == tvFloat())) {
                    ckDiag(c, `interface '${iname}': field '${fname}' has type ${tyName(t)}, expected ${tyName(fty)}`, line, col)
                    ok = false
                }
                found = true
                k = cdef.fnames.length
            } else {
                k = k + 1
            }
        }
        if (!found) {
            let names = ""
            let m = 0
            while (m < idef.fnames.length) {
                if (m > 0) { names = `${names}, ` }
                names = `${names}${idef.fnames[m]}`
                m = m + 1
            }
            ckDiag(c, `interface '${iname}': missing field '${fname}' (required: ${names})`, line, col)
            ok = false
        }
        j = j + 1
    }
    return ok
}

function ckCoerce(c: Ck, from: Ty, to: Ty, line: Int32, col: Int32): bool {
    if (tyEq(from, to)) {
        return true
    }
    if (from.k == tvIface()) {
        let ii = ckIfaceIdx(c, from.iname)
        if (ii >= 0) {
            if (c.ifaces[ii].fnames.length == 0) {
                return true
            }
        }
    }
    if (from.k == tvInt() && to.k == tvFloat()) {
        return true
    }
    if (from.k == tvArray() && to.k == tvArray()) {
        if (ckCoerceQuiet(c, from.elem, to.elem)) {
            return true
        }
    }
    if (to.k == tvIface() && from.k == tvObject()) {
        return ckIfaceConform(c, from.oid, to.iname, line, col)
    }
    if (from.k == tvIface() && to.k == tvObject()) {
        return ckIfaceConform(c, to.oid, from.iname, line, col)
    }
    ckDiag(c, `type mismatch: expected ${tyName(to)}, found ${tyName(from)}`, line, col)
    return false
}

// ---------------------------------------------------------------------------
// Scopes
// ---------------------------------------------------------------------------

function ckDeclare(c: Ck, name: string, ty: Ty, isConst: bool, line: Int32, col: Int32): Int32 {
    let sc = c.scopes[c.scopes.length - 1]
    let exists = false
    let i = 0
    while (i < sc.names.length) {
        if (sc.names[i] == name) {
            exists = true
            i = sc.names.length
        } else {
            i = i + 1
        }
    }
    if (exists) {
        ckDiag(c, `cannot redeclare '${name}' in the same scope`, line, col)
    }
    let id = ckFreshId(c)
    let vt = c.varTypes
    vt[id] = ty
    let vn = c.varNames
    vn[id] = name
    sc.names.push(name)
    sc.ids.push(id)
    sc.consts.push(isConst)
    return id
}

// resolve an identifier; result in c.lookupRes / c.loId / c.loTy / c.loCap
function ckLookup(c: Ck, name: string, line: Int32, col: Int32): void {
    c.lookupRes = false
    let i = c.scopes.length - 1
    while (i >= 0) {
        let sc = c.scopes[i]
        let j = 0
        while (j < sc.names.length) {
            if (sc.names[j] == name) {
                let id = sc.ids[j]
                let ty = c.varTypes[id]
                let isCap = false
                if (c.lambdaBase.length > 0) {
                    isCap = i < c.lambdaBase[c.lambdaBase.length - 1]
                }
                if (isCap && c.curCaps.length > 0) {
                    let caps = c.curCaps[c.curCaps.length - 1]
                    let seen = false
                    let k = 0
                    while (k < caps.ids.length) {
                        if (caps.ids[k] == id) {
                            seen = true
                            k = caps.ids.length
                        } else {
                            k = k + 1
                        }
                    }
                    if (!seen) {
                        caps.ids.push(id)
                        caps.tys.push(ty)
                    }
                }
                c.lookupRes = true
                c.loId = id
                c.loTy = ty
                c.loCap = isCap
                return
            }
            j = j + 1
        }
        i = i - 1
    }
    ckDiag(c, `cannot find name '${name}'`, line, col)
}

// is the variable id a top-level (global) variable?
function ckIsTopVar(c: Ck, id: Int32): bool {
    let i = 0
    while (i < c.topVarIds.length) {
        if (c.topVarIds[i] == id) {
            return true
        }
        i = i + 1
    }
    return false
}

// is_capture + const-ness of the innermost binding of `name`
function ckBindingConst(c: Ck, name: string): bool {
    let i = c.scopes.length - 1
    while (i >= 0) {
        let sc = c.scopes[i]
        let j = 0
        while (j < sc.names.length) {
            if (sc.names[j] == name) {
                return sc.consts[j]
            }
            j = j + 1
        }
        i = i - 1
    }
    return false
}

// ---------------------------------------------------------------------------
// Functions
// ---------------------------------------------------------------------------

function ckCheckFn(c: Ck, f: FnDecl): CFn {
    c.isAsync = f.isAsync
    c.inToplevel = false
    c.hasRet = false
    c.retTy = mkTy(tvVoid())
    c.sawFloatRet = false
    c.scopes.push(newScope())
    let cf = new CFn()
    cf.name = f.name
    cf.pids = mast.emptyInts()
    cf.ptys = emptyTys()
    cf.isAsync = f.isAsync
    cf.body = emptyCSts()
    let i = 0
    while (i < f.params.length) {
        let p = f.params[i]
        let ty = mkTy(tvVoid())
        if (p.hasAnn) {
            ty = ckTyOf(c, p.ann)
        }
        let id = ckDeclare(c, p.name, ty, true, p.line, p.col)
        cf.pids.push(id)
        cf.ptys.push(ty)
        i = i + 1
    }
    cf.body = ckCheckStmts(c, f.body)
    let ret = c.retTy
    if (!c.hasRet) {
        ret = mkTy(tvVoid())
    }
    if (c.sawFloatRet && ret.k == tvInt()) {
        ret = mkTy(tvFloat())
    }
    if (f.isAsync) {
        ret = mkPromiseTy(ret)
    }
    if (f.hasRet) {
        let at = ckTyOf(c, f.retAnn)
        ckCoerce(c, ret, at, f.line, f.col)
        ret = at
    }
    let inner = ret
    let requiresRet = true
    if (ret.k == tvPromise()) {
        inner = ret.elem
        requiresRet = inner.k != tvVoid()
    } else if (ret.k == tvVoid()) {
        requiresRet = false
    }
    if (requiresRet) {
        let hasReturn = false
        let j = 0
        while (j < cf.body.length) {
            if (cf.body[j].k == csReturn()) {
                hasReturn = true
                j = cf.body.length
            } else {
                j = j + 1
            }
        }
        if (!hasReturn) {
            ckDiag(c, `function '${f.name}' returns ${tyName(ret)} but not all paths return a value`, f.line, f.col)
        }
    }
    c.hasLastRet = true
    c.lastFnRet = ret
    c.scopes.pop()
    cf.ret = ret
    return cf
}

// ---------------------------------------------------------------------------
// Registration passes
// ---------------------------------------------------------------------------

function ckRegisterClasses(c: Ck, prog: Program): void {
    let pendingIds = mast.emptyInts()
    let pendingDecls = mast.emptyClasses()
    let i = 0
    while (i < prog.classes.length) {
        let cl = prog.classes[i]
        if (!isPascalCase(cl.name)) {
            ckDiag(c, `class '${cl.name}' must be PascalCase`, cl.line, cl.col)
        }
        if (ckClassIdOf(c, cl.name) >= 0) {
            ckDiag(c, `duplicate class '${cl.name}'`, cl.line, cl.col)
        } else if (cl.typeParams.length > 0) {
            c.genClsNames.push(cl.name)
            c.genClsDecls.push(cl)
        } else {
            let id = c.classes.length
            let def = new ClassDef()
            def.name = cl.name
            def.fnames = mast.emptyStrs()
            def.ftys = emptyTys()
            def.isGhost = false
            c.classes.push(def)
            c.cbNames.push(cl.name)
            c.cbIds.push(id)
            pendingIds.push(id)
            pendingDecls.push(cl)
        }
        i = i + 1
    }
    // pass B: field types (all class names are known now)
    let j = 0
    while (j < pendingDecls.length) {
        let cl = pendingDecls[j]
        let def = c.classes[pendingIds[j]]
        let k = 0
        while (k < cl.fields.length) {
            let fd = cl.fields[k]
            let dup = false
            let m = 0
            while (m < def.fnames.length) {
                if (def.fnames[m] == fd.name) {
                    dup = true
                    m = def.fnames.length
                } else {
                    m = m + 1
                }
            }
            if (dup) {
                ckDiag(c, `duplicate field '${fd.name}' in class '${cl.name}'`, cl.line, cl.col)
            } else {
                def.fnames.push(fd.name)
                def.ftys.push(ckTyOf(c, fd.ann))
            }
            k = k + 1
        }
        j = j + 1
    }
}

function ckRegisterInterfaces(c: Ck, prog: Program): void {
    let i = 0
    while (i < prog.ifaces.length) {
        let it = prog.ifaces[i]
        if (!isPascalCase(it.name)) {
            ckDiag(c, `interface '${it.name}' must be PascalCase`, it.line, it.col)
        }
        if (ckIfaceIdx(c, it.name) >= 0 || ckClassIdOf(c, it.name) >= 0) {
            ckDiag(c, `duplicate interface '${it.name}'`, it.line, it.col)
        } else {
            let def = new IfaceDef()
            def.name = it.name
            def.fnames = mast.emptyStrs()
            def.ftys = emptyTys()
            c.ifaces.push(def)
        }
        i = i + 1
    }
    i = 0
    while (i < prog.ifaces.length) {
        let it = prog.ifaces[i]
        let ii = ckIfaceIdx(c, it.name)
        let skipIf = ii < 0
        if (!skipIf) {
            if (c.ifaces[ii].fnames.length > 0) {
                skipIf = true
            }
        }
        if (!skipIf) {
        let def = c.ifaces[ii]
        let j = 0
        while (j < it.fields.length) {
            let fd = it.fields[j]
            let dup = false
            let m = 0
            while (m < def.fnames.length) {
                if (def.fnames[m] == fd.name) {
                    dup = true
                    m = def.fnames.length
                } else {
                    m = m + 1
                }
            }
            if (!dup) {
                def.fnames.push(fd.name)
                def.ftys.push(ckTyOf(c, fd.ann))
            }
            j = j + 1
        }
        }
        i = i + 1
    }
}

// ---------------------------------------------------------------------------
// Entry point
// ---------------------------------------------------------------------------

function ckCheck(prog: Program): ChkResult {
    let c = new Ck()
    c.sigNames = mast.emptyStrs()
    let emptySigs: Array<Sig> = []
    c.sigs = emptySigs
    c.varTypes = emptyTys()
    c.varNames = mast.emptyStrs()
    c.nextId = 0
    c.dmsgs = mast.emptyStrs()
    c.dlines = mast.emptyInts()
    c.dcols = mast.emptyInts()
    let emptyLams: Array<CLam> = []
    c.lambdas = emptyLams
    let emptyScopes: Array<Scope> = []
    c.scopes = emptyScopes
    c.isAsync = false
    c.hasRet = false
    c.retTy = mkTy(tvVoid())
    c.sawFloatRet = false
    c.hasLastRet = false
    c.lastFnRet = mkTy(tvVoid())
    c.pinfHas = false
    c.pinfTy = mkTy(tvVoid())
    c.pinfFloat = false
    c.inToplevel = false
    c.blockDepth = 0
    c.lambdaBase = mast.emptyInts()
    c.lambdaIdx = mast.emptyInts()
    let emptyCaps: Array<Capt> = []
    c.curCaps = emptyCaps
    let emptyFlags: Array<bool> = []
    c.lamRetOk = emptyFlags
    c.rejectIds = mast.emptyInts()
    let emptyClasses2: Array<ClassDef> = []
    c.classes = emptyClasses2
    c.cbNames = mast.emptyStrs()
    c.cbIds = mast.emptyInts()
    c.ghostCount = 0
    c.uses = mast.emptyStrs()
    let ui = 0
    while (ui < prog.useNames.length) {
        c.uses.push(prog.useNames[ui])
        ui = ui + 1
    }
    c.topVarIds = mast.emptyInts()
    c.genFnNames = mast.emptyStrs()
    c.genFnDecls = mast.emptyFns()
    c.genClsNames = mast.emptyStrs()
    c.genClsDecls = mast.emptyClasses()
    let emptyIfaces: Array<IfaceDef> = []
    c.ifaces = emptyIfaces
    let emptyMonos: Array<CFn> = []
    c.monoFns = emptyMonos
    c.lookupRes = false
    c.loId = -1
    c.loTy = mkTy(tvVoid())
    c.loCap = false
    c.aRes = newCEx(ceBool())
    c.aTy = mkTy(tvVoid())
    c.cbIdx = -1
    c.cbRet = mkTy(tvVoid())

    ckRegisterClasses(c, prog)
    ckRegisterInterfaces(c, prog)

    // pass 1: register function signatures (hoisting)
    let seenNames = mast.emptyStrs()
    let fi = 0
    while (fi < prog.fns.length) {
        let f = prog.fns[fi]
        if (!isCamelCase(f.name) && f.name != "main" && !isNamespacedFn(f.name)) {
            ckDiag(c, `function '${f.name}' must be camelCase`, f.line, f.col)
        }
        let dup = false
        let si = 0
        while (si < seenNames.length) {
            if (seenNames[si] == f.name) {
                dup = true
                si = seenNames.length
            } else {
                si = si + 1
            }
        }
        if (dup) {
            ckDiag(c, `duplicate function '${f.name}'`, f.line, f.col)
        } else {
        seenNames.push(f.name)
        if (f.typeParams.length > 0) {
            let ti = 0
            while (ti < f.typeParams.length) {
                if (!isPascalCase(f.typeParams[ti])) {
                    ckDiag(c, `type parameter '${f.typeParams[ti]}' must be PascalCase (e.g. T)`, f.line, f.col)
                }
                ti = ti + 1
            }
            c.genFnNames.push(f.name)
            c.genFnDecls.push(f)
        } else {
        let sig = new Sig()
        sig.params = emptyTys()
        sig.isAsync = f.isAsync
        sig.hasRet = false
        sig.ret = mkTy(tvVoid())
        let pi = 0
        while (pi < f.params.length) {
            let p = f.params[pi]
            if (p.hasAnn) {
                sig.params.push(ckTyOf(c, p.ann))
            } else {
                ckDiag(c, `parameter '${p.name}' of function '${f.name}' needs a type annotation (strict mode)`, p.line, p.col)
                sig.params.push(mkTy(tvVoid()))
            }
            pi = pi + 1
        }
        if (f.hasRet) {
            sig.ret = ckTyOf(c, f.retAnn)
            sig.hasRet = true
            if (sig.ret.k == tvResolver()) {
                ckDiag(c, "functions cannot return a Resolver", f.line, f.col)
            }
        }
        ckInsertSig(c, f.name, sig)
        }
        }
        fi = fi + 1
    }

    // pass 2: top-level declarations first (fn bodies need them in scope)
    let slots = emptyCSts()
    let hasSlot: Array<bool> = []
    if (prog.stmts.length > 0) {
        c.isAsync = false
        c.inToplevel = true
        c.hasRet = false
        c.retTy = mkTy(tvVoid())
        c.sawFloatRet = false
        c.scopes.push(newScope())
        let sti = 0
        while (sti < prog.stmts.length) {
            let s = prog.stmts[sti]
            let doNow = false
            if (s.kind == mast.skLet() && !ckStmtCallsUnresolved(c, s)) {
                doNow = true
            }
            if (doNow) {
                slots.push(ckCheckStmt(c, s))
                hasSlot.push(true)
            } else {
                slots.push(newCSt(csExpr()))
                hasSlot.push(false)
            }
            sti = sti + 1
        }
        c.inToplevel = false
    }

    // pass 3: fn bodies
    let fns: Array<CFn> = []
    let hasAsyncMain = false
    let hasSyncMain = false
    fi = 0
    while (fi < prog.fns.length) {
        let f = prog.fns[fi]
        if (f.name == "main") {
            if (f.isAsync) {
                if (hasSyncMain) {
                    ckDiag(c, "cannot define both an async and a sync 'main'", f.line, f.col)
                }
                hasAsyncMain = true
            } else {
                if (hasAsyncMain) {
                    ckDiag(c, "cannot define both an async and a sync 'main'", f.line, f.col)
                }
                hasSyncMain = true
            }
        }
        if (f.typeParams.length == 0) {
            let cf = ckCheckFn(c, f)
            if (c.hasLastRet) {
                let sig = ckSigOf(c, f.name)
                sig.ret = c.lastFnRet
                sig.hasRet = true
                ckInsertSig(c, f.name, sig)
            }
            fns.push(cf)
        }
        fi = fi + 1
    }

    // pass 4: remaining top-level statements
    let hasToplevel = false
    let toplevel = emptyCSts()
    if (prog.stmts.length > 0) {
        c.isAsync = false
        c.inToplevel = true
        c.hasRet = false
        c.retTy = mkTy(tvVoid())
        c.sawFloatRet = false
        let sti = 0
        while (sti < prog.stmts.length) {
            if (!hasSlot[sti]) {
                slots[sti] = ckCheckStmt(c, prog.stmts[sti])
                hasSlot[sti] = true
            }
            sti = sti + 1
        }
        let ti = 0
        while (ti < slots.length) {
            if (hasSlot[ti]) {
                toplevel.push(slots[ti])
            }
            ti = ti + 1
        }
        hasToplevel = true
        c.inToplevel = false
        c.scopes.pop()
    }

    let mi = 0
    while (mi < c.monoFns.length) {
        fns.push(c.monoFns[mi])
        mi = mi + 1
    }

    // explicit top-level `main()` call?
    let explicitMain = false
    let si2 = 0
    while (si2 < prog.stmts.length) {
        let s = prog.stmts[si2]
        if (s.kind == mast.skExpr()) {
            if (s.e1.kind == mast.ekCall()) {
                if (s.e1.kids.length > 0) {
                    if (s.e1.kids[0].kind == mast.ekIdent() && s.e1.kids[0].sval == "main") {
                        explicitMain = true
                        si2 = prog.stmts.length
                    } else {
                        si2 = si2 + 1
                    }
                } else {
                    si2 = si2 + 1
                }
            } else {
                si2 = si2 + 1
            }
        } else {
            si2 = si2 + 1
        }
    }

    let r = new ChkResult()
    r.ok = c.dmsgs.length == 0
    r.fns = fns
    r.lambdas = c.lambdas
    r.hasToplevel = hasToplevel
    r.toplevel = toplevel
    r.explicitMain = explicitMain
    r.varTypes = c.varTypes
    r.varNames = c.varNames
    r.classes = c.classes
    r.hasAsyncMain = hasAsyncMain
    r.hasSyncMain = hasSyncMain
    r.msgs = c.dmsgs
    r.dlines = c.dlines
    r.dcols = c.dcols
    return r
} 

// ---------------------------------------------------------------------------
// Statements
// ---------------------------------------------------------------------------

function ckCheckStmts(c: Ck, stmts: Array<Stmt>): Array<CSt> {
    let out = emptyCSts()
    let i = 0
    while (i < stmts.length) {
        out.push(ckCheckStmt(c, stmts[i]))
        i = i + 1
    }
    return out
}

// does the statement's expressions call an async fn whose return type is
// not yet known? (used to defer top-level statements)
function ckStmtCallsUnresolved(c: Ck, s: Stmt): bool {
    if (s.kind == mast.skLet() && s.hasE1) {
        return ckExprCallsUnresolved(c, s.e1)
    }
    return false
}

function ckExprCallsUnresolved(c: Ck, e: Expr): bool {
    if (e.kind == mast.ekCall() || e.kind == mast.ekCallGen()) {
        let direct = false
        if (e.kids.length > 0) {
            if (e.kids[0].kind == mast.ekIdent()) {
                let sig = ckSigOf(c, e.kids[0].sval)
                if (ckHasSig(c, e.kids[0].sval)) {
                    direct = !sig.hasRet && sig.isAsync
                }
            }
        }
        let any = direct
        if (e.kids.length > 0) {
            if (ckExprCallsUnresolved(c, e.kids[0])) {
                any = true
            }
        }
        let i = 0
        while (i < e.args.length) {
            if (ckExprCallsUnresolved(c, e.args[i])) {
                any = true
            }
            i = i + 1
        }
        return any
    }
    if (e.kind == mast.ekAwait() || e.kind == mast.ekNewPromise() || e.kind == mast.ekUnary() || e.kind == mast.ekMember()) {
        if (e.kids.length > 0) {
            return ckExprCallsUnresolved(c, e.kids[0])
        }
        return false
    }
    if (e.kind == mast.ekBinary()) {
        return ckExprCallsUnresolved(c, e.kids[0]) || ckExprCallsUnresolved(c, e.kids[1])
    }
    if (e.kind == mast.ekIndex()) {
        return ckExprCallsUnresolved(c, e.kids[0]) || ckExprCallsUnresolved(c, e.kids[1])
    }
    if (e.kind == mast.ekArrayLit()) {
        let i = 0
        while (i < e.args.length) {
            if (ckExprCallsUnresolved(c, e.args[i])) {
                return true
            }
            i = i + 1
        }
        return false
    }
    if (e.kind == mast.ekObjectLit()) {
        let i = 0
        while (i < e.args.length) {
            if (ckExprCallsUnresolved(c, e.args[i])) {
                return true
            }
            i = i + 1
        }
        return false
    }
    if (e.kind == mast.ekNewCtor()) {
        let i = 0
        while (i < e.args.length) {
            if (ckExprCallsUnresolved(c, e.args[i])) {
                return true
            }
            i = i + 1
        }
        return false
    }
    if (e.kind == mast.ekTemplate() || e.kind == mast.ekTagged()) {
        let i = 0
        while (i < e.parts.length) {
            let p = e.parts[i]
            if (p.isExpr && ckExprCallsUnresolved(c, p.e)) {
                return true
            }
            i = i + 1
        }
        return false
    }
    return false
}

// await at statement level; result in c.aRes / c.aTy
function ckAwaitTop(c: Ck, inner: Expr, line: Int32, col: Int32): void {
    if (c.blockDepth > 0) {
        ckDiag(c, "await inside if/while is not supported in marina v0.1 (keep awaits at the top level of the async function)", line, col)
        c.aRes = newCEx(ceBool())
        c.aTy = mkTy(tvVoid())
        return
    }
    let e = ckCheckExpr(c, inner)
    let t = ckExprTy(c, e)
    if (t.k == tvPromise()) {
        let a = newCEx(ceAwait())
        a.kids.push(e)
        a.ty = t.elem
        c.aRes = a
        c.aTy = t.elem
        return
    }
    ckDiag(c, `can only await a Promise, found ${tyName(t)}`, line, col)
    let a = newCEx(ceAwait())
    a.kids.push(e)
    a.ty = mkTy(tvVoid())
    c.aRes = a
    c.aTy = mkTy(tvVoid())
}

function ckUnifyRet(c: Ck, t: Ty, line: Int32, col: Int32): void {
    if (c.hasRet) {
        let prev = c.retTy
        if (tyEq(prev, t)) {
            return
        }
        if (prev.k == tvInt() && t.k == tvFloat()) {
            c.sawFloatRet = true
            return
        }
        if (prev.k == tvFloat() && t.k == tvInt()) {
            return
        }
        ckDiag(c, `inconsistent return types: expected ${tyName(prev)}, found ${tyName(t)}`, line, col)
    } else {
        c.hasRet = true
        c.retTy = t
    }
}

function ckCheckStmt(c: Ck, s: Stmt): CSt {
    if (s.kind == mast.skLet()) {
        // naming rules
        if (s.isConst) {
            if (!isUpperSnakeCase(s.name)) {
                ckDiag(c, `const '${s.name}' must be UPPER_SNAKE_CASE (e.g. MAX_RETRIES)`, s.line, s.col)
            }
        } else if (!isCamelCase(s.name)) {
            ckDiag(c, `let variable '${s.name}' must be camelCase`, s.line, s.col)
        }
        // annotated array literal: element type from the annotation
        let hasExpElem = false
        let expElem = mkTy(tvInt())
        if (s.hasAnn && s.e1.kind == mast.ekArrayLit()) {
            let at = ckTyOf(c, s.ann)
            if (at.k == tvArray()) {
                hasExpElem = true
                expElem = at.elem
            }
        }
        // object literal bound to a variable: target class from annotation
        let hasTarget = false
        let targetId = -1
        if (s.hasAnn && s.e1.kind == mast.ekObjectLit()) {
            let at = ckTyOf(c, s.ann)
            if (at.k == tvObject()) {
                hasTarget = true
                targetId = at.oid
            } else {
                ckDiag(c, `type annotation must be a class for object literals, found ${tyName(at)}`, s.line, s.col)
            }
        }
        let initC = newCEx(ceBool())
        let initTy = mkTy(tvVoid())
        if (s.e1.kind == mast.ekAwait()) {
            ckAwaitTop(c, s.e1.kids[0], s.e1.line, s.e1.col)
            initC = c.aRes
            initTy = c.aTy
        } else if (s.e1.kind == mast.ekArrayLit()) {
            initC = ckArrayLit(c, s.e1.args, s.e1.line, s.e1.col, hasExpElem, expElem)
            initTy = ckExprTy(c, initC)
        } else if (s.e1.kind == mast.ekObjectLit()) {
            initC = ckObjectLit(c, s.e1, hasTarget, targetId, s.name)
            initTy = ckExprTy(c, initC)
        } else {
            initC = ckCheckExpr(c, s.e1)
            initTy = ckExprTy(c, initC)
        }
        let ty = initTy
        if (s.hasAnn) {
            let at = ckTyOf(c, s.ann)
            ckCoerce(c, initTy, at, s.line, s.col)
            ty = at
        }
        let id = ckDeclare(c, s.name, ty, s.isConst, s.line, s.col)
        if (c.inToplevel) {
            c.topVarIds.push(id)
        }
        let st = newCSt(csLet())
        st.id = id
        st.ty = ty
        st.e1 = initC
        st.hasE1 = true
        return st
    }
    if (s.kind == mast.skAssign()) {
        ckLookup(c, s.name, s.line, s.col)
        if (!c.lookupRes) {
            let st = newCSt(csExpr())
            st.e1 = newCEx(ceBool())
            return st
        }
        let id = c.loId
        let ty = c.loTy
        let isCap = c.loCap
        if (isCap && !ckIsTopVar(c, id)) {
            ckDiag(c, "cannot assign to a captured variable (captures are by value)", s.line, s.col)
            let st = newCSt(csExpr())
            st.e1 = newCEx(ceBool())
            return st
        }
        if (ckBindingConst(c, s.name)) {
            ckDiag(c, `cannot assign to 'const ${s.name}'`, s.line, s.col)
        }
        let v = ckCheckExpr(c, s.e1)
        ckCoerce(c, ckExprTy(c, v), ty, s.line, s.col)
        let st = newCSt(csAssign())
        st.id = id
        st.e1 = v
        st.hasE1 = true
        return st
    }
    if (s.kind == mast.skIndexAssign()) {
        ckLookup(c, s.name, s.line, s.col)
        if (!c.lookupRes) {
            let st = newCSt(csExpr())
            st.e1 = newCEx(ceBool())
            return st
        }
        let id = c.loId
        let ty = c.loTy
        let isCap = c.loCap
        if (isCap && !ckIsTopVar(c, id)) {
            ckDiag(c, "cannot assign to a captured variable (captures are by value)", s.line, s.col)
            let st = newCSt(csExpr())
            st.e1 = newCEx(ceBool())
            return st
        }
        if (ty.k == tvArray()) {
            let elem = ty.elem
            let ic = ckCheckExpr(c, s.e1)
            if (ckExprTy(c, ic).k != tvInt()) {
                ckDiag(c, `array index must be Int32, found ${tyName(ckExprTy(c, ic))}`, s.line, s.col)
            }
            let vc = ckCheckExpr(c, s.e2)
            ckCoerce(c, ckExprTy(c, vc), elem, s.line, s.col)
            let st = newCSt(csIndexSet())
            st.id = id
            st.e1 = ic
            st.e2 = vc
            st.hasE1 = true
            st.ty = elem
            return st
        }
        ckDiag(c, `indexed assignment requires an Array, found ${tyName(ty)}`, s.line, s.col)
        let st = newCSt(csExpr())
        st.e1 = newCEx(ceBool())
        return st
    }
    if (s.kind == mast.skMemberAssign()) {
        ckLookup(c, s.name, s.line, s.col)
        if (!c.lookupRes) {
            let st = newCSt(csExpr())
            st.e1 = newCEx(ceBool())
            return st
        }
        let id = c.loId
        let ty = c.loTy
        let isCap = c.loCap
        if (isCap && !ckIsTopVar(c, id)) {
            ckDiag(c, "cannot assign to a captured variable (captures are by value)", s.line, s.col)
            let st = newCSt(csExpr())
            st.e1 = newCEx(ceBool())
            return st
        }
        if (ty.k == tvIface()) {
            let ii = ckIfaceIdx(c, ty.iname)
            let idef = c.ifaces[ii]
            let fidx = -1
            let k = 0
            while (k < idef.fnames.length) {
                if (idef.fnames[k] == s.field) {
                    fidx = k
                    k = idef.fnames.length
                } else {
                    k = k + 1
                }
            }
            if (fidx < 0) {
                let names = ""
                let m = 0
                while (m < idef.fnames.length) {
                    if (m > 0) { names = `${names}, ` }
                    names = `${names}${idef.fnames[m]}`
                    m = m + 1
                }
                let list = names
                if (idef.fnames.length == 0) {
                    list = "none"
                }
                ckDiag(c, `interface '${ty.iname}' has no field '${s.field}' (fields: ${list})`, s.line, s.col)
                let st = newCSt(csExpr())
                st.e1 = newCEx(ceBool())
                return st
            }
            let elem = idef.ftys[fidx]
            let vc = ckCheckExpr(c, s.e1)
            ckCoerce(c, ckExprTy(c, vc), elem, s.line, s.col)
            let st = newCSt(csIfaceSet())
            st.id = id
            st.e1 = vc
            st.hasE1 = true
            st.ty = elem
            st.fname = s.field
            return st
        }
        if (ty.k == tvObject()) {
            let def = c.classes[ty.oid]
            let fidx = -1
            let k = 0
            while (k < def.fnames.length) {
                if (def.fnames[k] == s.field) {
                    fidx = k
                    k = def.fnames.length
                } else {
                    k = k + 1
                }
            }
            if (fidx < 0) {
                let list = ""
                let m = 0
                while (m < def.fnames.length) {
                    if (m > 0) { list = `${list}, ` }
                    list = `${list}${def.fnames[m]}`
                    m = m + 1
                }
                if (def.fnames.length == 0) {
                    list = "none"
                }
                ckDiag(c, `class '${ty.oname}' has no field '${s.field}' (fields: ${list})`, s.line, s.col)
                let st = newCSt(csExpr())
                st.e1 = newCEx(ceBool())
                return st
            }
            let elem = def.ftys[fidx]
            let vc = ckCheckExpr(c, s.e1)
            ckCoerce(c, ckExprTy(c, vc), elem, s.line, s.col)
            let st = newCSt(csFieldSet())
            st.id = id
            st.e1 = vc
            st.hasE1 = true
            st.ty = elem
            st.retKind = fidx
            return st
        }
        ckDiag(c, `field assignment requires an object, found ${tyName(ty)} (hint: use '${s.name}[i] = v' for arrays)`, s.line, s.col)
        let st = newCSt(csExpr())
        st.e1 = newCEx(ceBool())
        return st
    }
    if (s.kind == mast.skReturn()) {
        let lamRetOk = false
        if (c.lamRetOk.length > 0) {
            lamRetOk = c.lamRetOk[c.lamRetOk.length - 1]
        }
        let inLambda = c.lambdaIdx.length > 0
        if (inLambda && !lamRetOk) {
            ckDiag(c, "cannot return from a lambda", s.line, s.col)
            let st = newCSt(csExpr())
            st.e1 = newCEx(ceBool())
            return st
        }
        if (!inLambda && c.inToplevel) {
            ckDiag(c, "'return' is not allowed at the top level", s.line, s.col)
            let st = newCSt(csExpr())
            st.e1 = newCEx(ceBool())
            return st
        }
        if (!s.hasE1) {
            ckUnifyRet(c, mkTy(tvVoid()), s.line, s.col)
            let st = newCSt(csReturn())
            st.retKind = rkPlain()
            return st
        }
        if (s.e1.kind == mast.ekAwait()) {
            ckAwaitTop(c, s.e1.kids[0], s.e1.line, s.e1.col)
            let a = c.aRes
            ckUnifyRet(c, c.aTy, s.line, s.col)
            let st = newCSt(csReturn())
            st.e1 = a
            st.hasE1 = true
            st.retKind = rkPlain()
            return st
        }
        let v = ckCheckExpr(c, s.e1)
        let t = ckExprTy(c, v)
        if (c.isAsync) {
            if (t.k == tvPromise()) {
                if (c.blockDepth > 0) {
                    ckDiag(c, "returning a promise from inside if/while is not supported in marina v0.1", s.line, s.col)
                    let st = newCSt(csReturn())
                    st.retKind = rkPlain()
                    return st
                }
                if (t.elem.k == tvPromise()) {
                    ckDiag(c, "returning a promise of a promise is not supported", s.line, s.col)
                }
                let inner = t.elem
                ckUnifyRet(c, inner, s.line, s.col)
                let st = newCSt(csReturn())
                st.e1 = v
                st.hasE1 = true
                st.retKind = rkFlatten()
                st.ty = inner
                return st
            }
        } else if (t.k == tvPromise()) {
            ckDiag(c, "sync functions cannot return a Promise (make the function async)", s.line, s.col)
        }
        ckUnifyRet(c, t, s.line, s.col)
        let st = newCSt(csReturn())
        st.e1 = v
        st.hasE1 = true
        st.retKind = rkPlain()
        return st
    }
    if (s.kind == mast.skIf()) {
        let cond = ckCheckExpr(c, s.e1)
        if (ckExprTy(c, cond).k != tvBool()) {
            ckDiag(c, `if condition must be bool, found ${tyName(ckExprTy(c, cond))}`, s.line, s.col)
        }
        c.scopes.push(newScope())
        c.blockDepth = c.blockDepth + 1
        let thenBody = ckCheckStmts(c, s.body)
        c.blockDepth = c.blockDepth - 1
        c.scopes.pop()
        let st = newCSt(csIf())
        st.e1 = cond
        st.hasE1 = true
        st.body = thenBody
        if (s.els.length > 0) {
            c.scopes.push(newScope())
            c.blockDepth = c.blockDepth + 1
            let els = ckCheckStmts(c, s.els)
            c.blockDepth = c.blockDepth - 1
            c.scopes.pop()
            st.els = els
        }
        return st
    }
    if (s.kind == mast.skWhile()) {
        let cond = ckCheckExpr(c, s.e1)
        if (ckExprTy(c, cond).k != tvBool()) {
            ckDiag(c, `while condition must be bool, found ${tyName(ckExprTy(c, cond))}`, s.line, s.col)
        }
        c.scopes.push(newScope())
        c.blockDepth = c.blockDepth + 1
        let body = ckCheckStmts(c, s.body)
        c.blockDepth = c.blockDepth - 1
        c.scopes.pop()
        let st = newCSt(csWhile())
        st.e1 = cond
        st.hasE1 = true
        st.body = body
        return st
    }
    if (s.kind == mast.skFor()) {
        c.scopes.push(newScope())
        let st = newCSt(csFor())
        if (s.hasS1) {
            st.s1 = ckCheckStmt(c, s.s1)
            st.hasS1 = true
        }
        if (s.hasE1) {
            if (s.e1.kind == mast.ekAwait()) {
                ckDiag(c, "await in a loop condition is not supported in marina v0.1", s.e1.line, s.e1.col)
                let ce = newCEx(ceBool())
                ce.bval = false
                st.e1 = ce
            } else {
                let cond = ckCheckExpr(c, s.e1)
                if (ckExprTy(c, cond).k != tvBool()) {
                    ckDiag(c, `for condition must be bool, found ${tyName(ckExprTy(c, cond))}`, s.line, s.col)
                }
                st.e1 = cond
            }
            st.hasE1 = true
        } else {
            st.e1 = newCEx(ceBool())
            let ce2 = st.e1
            ce2.bval = true
            st.hasE1 = true
        }
        if (s.hasS2) {
            if (s.s2.kind == mast.skExpr() && s.s2.e1.kind == mast.ekAwait()) {
                ckDiag(c, "await in a loop update is not supported in marina v0.1", s.s2.e1.line, s.s2.e1.col)
            } else {
                st.s2 = ckCheckStmt(c, s.s2)
                st.hasS2 = true
            }
        }
        c.blockDepth = c.blockDepth + 1
        st.body = ckCheckStmts(c, s.body)
        c.blockDepth = c.blockDepth - 1
        c.scopes.pop()
        return st
    }
    // expression statement
    if (s.e1.kind == mast.ekAwait()) {
        ckAwaitTop(c, s.e1.kids[0], s.e1.line, s.e1.col)
        let st = newCSt(csExpr())
        st.e1 = c.aRes
        st.hasE1 = true
        return st
    }
    let e = ckCheckExpr(c, s.e1)
    let st = newCSt(csExpr())
    st.e1 = e
    st.hasE1 = true
    return st
}

// ---------------------------------------------------------------------------
// Checked-expression types (expr_ty)
// ---------------------------------------------------------------------------

function ckExprTy(c: Ck, e: CEx): Ty {
    if (e.k == ceInt()) { return mkTy(tvInt()) }
    if (e.k == ceFloat()) { return mkTy(tvFloat()) }
    if (e.k == ceBool()) { return mkTy(tvBool()) }
    if (e.k == ceStr()) { return mkTy(tvStr()) }
    if (e.k == ceTemplate()) { return mkTy(tvStr()) }
    if (e.k == ceIdent()) { return e.ty }
    if (e.k == ceUnary()) { return e.ty }
    if (e.k == ceBinary()) { return e.ty }
    if (e.k == ceCallFn()) { return e.ty }
    if (e.k == ceCallResolver()) { return mkTy(tvVoid()) }
    if (e.k == ceAwait()) { return e.ty }
    if (e.k == ceNewPromise()) {
        let l = c.lambdas[e.id]
        if (l.ptys.length > 0) {
            if (l.ptys[0].k == tvResolver()) {
                return mkPromiseTy(l.ptys[0].elem)
            }
        }
        return mkTy(tvVoid())
    }
    if (e.k == ceConsoleLog()) { return mkTy(tvVoid()) }
    if (e.k == ceSetTimeout()) { return mkTy(tvVoid()) }
    if (e.k == ceArrayLit()) { return mkArrayTy(e.ty) }
    if (e.k == ceIndex()) { return e.ty }
    if (e.k == ceArrayOp()) { return e.ty }
    if (e.k == ceArrayHof()) { return e.ty }
    if (e.k == ceLambdaVal()) { return e.ty }
    if (e.k == ceStrLen()) { return mkTy(tvInt()) }
    if (e.k == ceStrMethod()) { return e.ty }
    if (e.k == ceFsArgs()) { return mkArrayTy(mkTy(tvStr())) }
    if (e.k == ceObjectLit() || e.k == ceNewClass()) {
        return mkObjectTy(e.id, c.classes[e.id].name)
    }
    if (e.k == ceFieldGet()) { return e.ty }
    if (e.k == ceIfaceGet()) { return e.ty }
    if (e.k == ceIfaceSet()) { return mkTy(tvVoid()) }
    if (e.k == ceFsReadFile()) { return mkPromiseTy(mkTy(tvStr())) }
    if (e.k == ceFsWriteFile() || e.k == ceFsMkdir() || e.k == ceFsRemove()) {
        return mkPromiseTy(mkTy(tvVoid()))
    }
    if (e.k == ceFsExists()) { return mkPromiseTy(mkTy(tvBool())) }
    if (e.k == ceFsReadDir()) { return mkPromiseTy(mkArrayTy(mkTy(tvStr()))) }
    if (e.k == ceCryptoSha256() || e.k == ceCryptoBase64() || e.k == ceCryptoRandomHex() || e.k == ceCryptoUuid()) {
        return mkTy(tvStr())
    }
    return mkTy(tvVoid())
} 

// ---------------------------------------------------------------------------
// Expressions
// ---------------------------------------------------------------------------

function ckCheckExpr(c: Ck, e: Expr): CEx {
    if (e.kind == mast.ekInt()) {
        let r = newCEx(ceInt())
        r.ival = e.ival
        return r
    }
    if (e.kind == mast.ekFloat()) {
        let r = newCEx(ceFloat())
        r.fval = e.fval
        return r
    }
    if (e.kind == mast.ekBool()) {
        let r = newCEx(ceBool())
        r.bval = e.bval
        return r
    }
    if (e.kind == mast.ekStr()) {
        let r = newCEx(ceStr())
        r.sval = e.sval
        return r
    }
    if (e.kind == mast.ekTemplate()) {
        console.log(`TPL parts=${e.parts.length}`)
        let out = emptyTPartsC()
        let i = 0
        while (i < e.parts.length) {
            let p = e.parts[i]
            if (!p.isExpr) {
                let pc = new TPartC()
                pc.isExpr = false
                pc.t = p.t
                pc.e = newCEx(ceBool())
                out.push(pc)
            } else {
                let ce = ckCheckExpr(c, p.e)
                if (ckExprTy(c, ce).k == tvVoid()) {
                    ckDiag(c, "cannot interpolate a void expression", p.e.line, p.e.col)
                }
                let pc = new TPartC()
                pc.isExpr = true
                pc.t = ""
                pc.e = ce
                out.push(pc)
            }
            i = i + 1
        }
        if (out.length == 0) {
            ckDiag(c, "empty template literal", e.line, e.col)
        }
        let r = newCEx(ceTemplate())
        r.parts = out
        return r
    }
    if (e.kind == mast.ekTagged()) {
        ckDiag(c, "template tags must be passed directly to db.execute or db.query (e.g. db.query(sql.stmt`SELECT 1`))", e.line, e.col)
        return newCEx(ceBool())
    }
    if (e.kind == mast.ekIdent()) {
        ckLookup(c, e.sval, e.line, e.col)
        if (!c.lookupRes) {
            return newCEx(ceBool())
        }
        let r = newCEx(ceIdent())
        r.id = c.loId
        r.ty = c.loTy
        return r
    }
    if (e.kind == mast.ekUnary()) {
        let inner = ckCheckExpr(c, e.kids[0])
        let t = ckExprTy(c, inner)
        if (e.opv == mast.uoNeg()) {
            if (!isNumeric(t)) {
                ckDiag(c, `unary '-' requires a number, found ${tyName(t)}`, e.line, e.col)
            }
            let r = newCEx(ceUnary())
            r.opv = ucNeg()
            r.kids.push(inner)
            r.ty = t
            return r
        }
        if (t.k != tvBool()) {
            ckDiag(c, `'!' requires a bool, found ${tyName(t)}`, e.line, e.col)
        }
        let r = newCEx(ceUnary())
        r.opv = ucNot()
        r.kids.push(inner)
        r.ty = mkTy(tvBool())
        return r
    }
    if (e.kind == mast.ekBinary()) {
        return ckCheckBinary(c, e.opv, e.kids[0], e.kids[1], e.line, e.col)
    }
    if (e.kind == mast.ekAwait()) {
        ckDiag(c, "await is only allowed as `let x = await ...`, a standalone `await ...` statement, or `return await ...`", e.line, e.col)
        return newCEx(ceBool())
    }
    if (e.kind == mast.ekCall()) {
        return ckCheckCall(c, e.kids[0], e.args, e.line, e.col)
    }
    if (e.kind == mast.ekCallGen()) {
        return ckCheckCallGen(c, e.kids[0], e.targs, e.args, e.line, e.col)
    }
    if (e.kind == mast.ekArrayLit()) {
        return ckArrayLit(c, e.args, e.line, e.col, false, mkTy(tvInt()))
    }
    if (e.kind == mast.ekObjectLit()) {
        return ckObjectLit(c, e, false, -1, "")
    }
    if (e.kind == mast.ekNewClass()) {
        let gidx = ckGenClsIdx(c, e.sval)
        if (gidx >= 0) {
            if (e.targs.length == 0) {
                ckDiag(c, `generic class '${e.sval}' needs type parameters, e.g. new ${e.sval}<Int32>()`, e.line, e.col)
                return newCEx(ceBool())
            }
            let t = ckMonoClass(c, e.sval, e.targs, e.line, e.col)
            if (t.k == tvObject()) {
                let r = newCEx(ceNewClass())
                r.id = t.oid
                return r
            }
            return newCEx(ceBool())
        }
        if (e.targs.length > 0) {
            ckDiag(c, `class '${e.sval}' does not take type parameters`, e.line, e.col)
        }
        let id = ckClassIdOf(c, e.sval)
        if (id >= 0) {
            let r = newCEx(ceNewClass())
            r.id = id
            return r
        }
        ckDiag(c, `unknown class '${e.sval}'`, e.line, e.col)
        return newCEx(ceBool())
    }
    if (e.kind == mast.ekNewCtor()) {
        if (e.names.length == 1) {
            let id = ckClassIdOf(c, e.names[0])
            if (id >= 0) {
                let r = newCEx(ceNewClass())
                r.id = id
                return r
            }
            ckDiag(c, `unknown class '${e.names[0]}'`, e.line, e.col)
            return newCEx(ceBool())
        }
        let path = ""
        let i = 0
        while (i < e.names.length) {
            if (i > 0) { path = `${path}.` }
            path = `${path}${e.names[i]}`
            i = i + 1
        }
        ckDiag(c, `unknown class '${path}'`, e.line, e.col)
        return newCEx(ceBool())
    }
    if (e.kind == mast.ekIndex()) {
        let oc = ckCheckExpr(c, e.kids[0])
        let ot = ckExprTy(c, oc)
        let ic = ckCheckExpr(c, e.kids[1])
        let it = ckExprTy(c, ic)
        if (it.k != tvInt()) {
            ckDiag(c, `array index must be Int32, found ${tyName(it)}`, e.line, e.col)
        }
        if (ot.k == tvArray()) {
            let r = newCEx(ceIndex())
            r.kids.push(oc)
            r.kids.push(ic)
            r.ty = ot.elem
            return r
        }
        ckDiag(c, `indexing requires an Array, found ${tyName(ot)}`, e.line, e.col)
        return newCEx(ceBool())
    }
    if (e.kind == mast.ekMember()) {
        // property access: arr.length / str.length / fields on instances
        let oc = ckCheckExpr(c, e.kids[0])
        let ot = ckExprTy(c, oc)
        if (e.sval == "length") {
            if (ot.k == tvArray()) {
                let r = newCEx(ceArrayOp())
                r.opv = aoLen()
                r.kids.push(oc)
                r.ty = mkTy(tvInt())
                return r
            }
            if (ot.k == tvStr()) {
                let r = newCEx(ceStrLen())
                r.kids.push(oc)
                return r
            }
        }
        if (ot.k == tvIface()) {
            let ii = ckIfaceIdx(c, ot.iname)
            let idef = c.ifaces[ii]
            let fidx = -1
            let k = 0
            while (k < idef.fnames.length) {
                if (idef.fnames[k] == e.sval) {
                    fidx = k
                    k = idef.fnames.length
                } else {
                    k = k + 1
                }
            }
            if (fidx >= 0) {
                let r = newCEx(ceIfaceGet())
                r.kids.push(oc)
                r.sval = e.sval
                r.ty = idef.ftys[fidx]
                return r
            }
            let list = ""
            let m = 0
            while (m < idef.fnames.length) {
                if (m > 0) { list = `${list}, ` }
                list = `${list}${idef.fnames[m]}`
                m = m + 1
            }
            if (idef.fnames.length == 0) {
                list = "none"
            }
            ckDiag(c, `interface '${ot.iname}' has no field '${e.sval}' (fields: ${list})`, e.line, e.col)
            return newCEx(ceBool())
        }
        if (ot.k == tvObject()) {
            let def = c.classes[ot.oid]
            let fidx = -1
            let k = 0
            while (k < def.fnames.length) {
                if (def.fnames[k] == e.sval) {
                    fidx = k
                    k = def.fnames.length
                } else {
                    k = k + 1
                }
            }
            if (fidx >= 0) {
                let r = newCEx(ceFieldGet())
                r.kids.push(oc)
                r.id = fidx
                r.ty = def.ftys[fidx]
                return r
            }
            let list = ""
            let m = 0
            while (m < def.fnames.length) {
                if (m > 0) { list = `${list}, ` }
                list = `${list}${def.fnames[m]}`
                m = m + 1
            }
            if (def.fnames.length == 0) {
                list = "none"
            }
            ckDiag(c, `class '${ot.oname}' has no field '${e.sval}' (fields: ${list})`, e.line, e.col)
            return newCEx(ceBool())
        }
        ckDiag(c, "member access is only supported for 'console.log(...)', 'arr.length' and 'str.length'", e.line, e.col)
        return newCEx(ceBool())
    }
    if (e.kind == mast.ekNewPromise()) {
        let badExec = e.kids.length == 0
        if (!badExec) {
            badExec = e.kids[0].kind != mast.ekLambda()
        }
        if (badExec) {
            ckDiag(c, "new Promise(...) takes an executor lambda: new Promise((resolve) => { ... })", e.line, e.col)
            return newCEx(ceBool())
        }
        ckExecutorLambda(c, e.kids[0].lam)
        let r = newCEx(ceNewPromise())
        r.id = c.cbIdx
        return r
    }
    if (e.kind == mast.ekLambda()) {
        ckDiag(c, "lambda functions can only be passed directly to setTimeout(...) or new Promise(...)", e.line, e.col)
        return newCEx(ceBool())
    }
    return newCEx(ceBool())
}

function ckCheckBinary(c: Ck, op: Int32, l: Expr, r: Expr, line: Int32, col: Int32): CEx {
    let lc = ckCheckExpr(c, l)
    let rc = ckCheckExpr(c, r)
    let lt = ckExprTy(c, lc)
    let rt = ckExprTy(c, rc)
    if (op == mast.boAnd() || op == mast.boOr()) {
        if (lt.k != tvBool() || rt.k != tvBool()) {
            ckDiag(c, `'&&'/'||' require bools, found ${tyName(lt)} and ${tyName(rt)}`, line, col)
        }
        let b = newCEx(ceBinary())
        b.opv = op
        b.kids.push(lc)
        b.kids.push(rc)
        b.ty = mkTy(tvBool())
        return b
    }
    if (op == mast.boLt() || op == mast.boGt() || op == mast.boLe() || op == mast.boGe()) {
        if (!isNumeric(lt) || !isNumeric(rt)) {
            ckDiag(c, `comparison requires numbers, found ${tyName(lt)} and ${tyName(rt)}`, line, col)
        }
        let b = newCEx(ceBinary())
        b.opv = op
        b.kids.push(lc)
        b.kids.push(rc)
        b.ty = mkTy(tvBool())
        return b
    }
    if (op == mast.boEq() || op == mast.boNeq()) {
        if (!(lt.k == tvStr() && rt.k == tvStr())) {
            if (!isNumeric(lt) && lt.k != tvBool()) {
                ckDiag(c, `'=='/'!=' requires numbers or bools, found ${tyName(lt)}`, line, col)
            }
            if (!isNumeric(rt) && rt.k != tvBool()) {
                ckDiag(c, `'=='/'!=' requires numbers or bools, found ${tyName(rt)}`, line, col)
            }
        }
        let b = newCEx(ceBinary())
        b.opv = op
        b.kids.push(lc)
        b.kids.push(rc)
        b.ty = mkTy(tvBool())
        return b
    }
    if (op == mast.boAdd()) {
        if (lt.k == tvStr() || rt.k == tvStr()) {
            ckDiag(c, "cannot use '+' with strings (use a template literal `...${x}...`)", line, col)
        }
        return ckArith(c, op, lc, rc, lt, rt, line, col)
    }
    if (op == mast.boMod()) {
        if (lt.k != tvInt() || rt.k != tvInt()) {
            ckDiag(c, "operator '%' requires Int32 operands", line, col)
        }
        let b = newCEx(ceBinary())
        b.opv = op
        b.kids.push(lc)
        b.kids.push(rc)
        b.ty = mkTy(tvInt())
        return b
    }
    return ckArith(c, op, lc, rc, lt, rt, line, col)
}

function ckArith(c: Ck, op: Int32, lc: CEx, rc: CEx, lt: Ty, rt: Ty, line: Int32, col: Int32): CEx {
    if (!isNumeric(lt) || !isNumeric(rt)) {
        ckDiag(c, `arithmetic requires numbers, found ${tyName(lt)} and ${tyName(rt)}`, line, col)
    }
    let result = mkTy(tvInt())
    if (lt.k == tvFloat() || rt.k == tvFloat()) {
        result = mkTy(tvFloat())
    }
    let b = newCEx(ceBinary())
    b.opv = op
    b.kids.push(lc)
    b.kids.push(rc)
    b.ty = result
    return b
}

// ---------------------------------------------------------------------------
// fs / crypto std modules
// ---------------------------------------------------------------------------

function ckFsModule(c: Ck, name: string, args: Array<Expr>, line: Int32, col: Int32): CEx {
    if (name == "args") {
        if (args.length > 0) {
            ckDiag(c, "fs.args takes no arguments", line, col)
        }
        return newCEx(ceFsArgs())
    }
    if (args.length > 0) {
        let p0 = ckCheckExpr(c, args[0])
        ckCoerce(c, ckExprTy(c, p0), mkTy(tvStr()), args[0].line, args[0].col)
        if (name == "readFile") {
            if (args.length != 1) {
                ckDiag(c, "fs.readFile takes (path)", line, col)
                return newCEx(ceBool())
            }
            let r = newCEx(ceFsReadFile())
            r.kids.push(p0)
            return r
        }
        if (name == "writeFile") {
            if (args.length != 2) {
                ckDiag(c, "fs.writeFile takes (path, data)", line, col)
                return newCEx(ceBool())
            }
            let d = ckCheckExpr(c, args[1])
            ckCoerce(c, ckExprTy(c, d), mkTy(tvStr()), args[1].line, args[1].col)
            let r = newCEx(ceFsWriteFile())
            r.kids.push(p0)
            r.kids.push(d)
            return r
        }
        if (name == "exists") {
            if (args.length != 1) {
                ckDiag(c, "fs.exists takes (path)", line, col)
                return newCEx(ceBool())
            }
            let r = newCEx(ceFsExists())
            r.kids.push(p0)
            return r
        }
        if (name == "readDir") {
            if (args.length != 1) {
                ckDiag(c, "fs.readDir takes (path)", line, col)
                return newCEx(ceBool())
            }
            let r = newCEx(ceFsReadDir())
            r.kids.push(p0)
            return r
        }
        if (name == "mkdir") {
            if (args.length != 1) {
                ckDiag(c, "fs.mkdir takes (path)", line, col)
                return newCEx(ceBool())
            }
            let r = newCEx(ceFsMkdir())
            r.kids.push(p0)
            return r
        }
        if (name == "remove") {
            if (args.length != 1) {
                ckDiag(c, "fs.remove takes (path)", line, col)
                return newCEx(ceBool())
            }
            let r = newCEx(ceFsRemove())
            r.kids.push(p0)
            return r
        }
    }
    ckDiag(c, `fs.${name} is not supported (fs has args, readFile, writeFile, exists, readDir, mkdir, remove)`, line, col)
    return newCEx(ceBool())
}

function ckCryptoModule(c: Ck, name: string, args: Array<Expr>, line: Int32, col: Int32): CEx {
    if (name == "sha256") {
        if (args.length != 1) {
            ckDiag(c, "crypto.sha256 takes (data)", line, col)
            return newCEx(ceBool())
        }
        let v = ckCheckExpr(c, args[0])
        ckCoerce(c, ckExprTy(c, v), mkTy(tvStr()), args[0].line, args[0].col)
        let r = newCEx(ceCryptoSha256())
        r.kids.push(v)
        return r
    }
    if (name == "base64Encode") {
        if (args.length != 1) {
            ckDiag(c, "crypto.base64Encode takes (data)", line, col)
            return newCEx(ceBool())
        }
        let v = ckCheckExpr(c, args[0])
        ckCoerce(c, ckExprTy(c, v), mkTy(tvStr()), args[0].line, args[0].col)
        let r = newCEx(ceCryptoBase64())
        r.ex = false
        r.kids.push(v)
        return r
    }
    if (name == "base64Decode") {
        if (args.length != 1) {
            ckDiag(c, "crypto.base64Decode takes (data)", line, col)
            return newCEx(ceBool())
        }
        let v = ckCheckExpr(c, args[0])
        ckCoerce(c, ckExprTy(c, v), mkTy(tvStr()), args[0].line, args[0].col)
        let r = newCEx(ceCryptoBase64())
        r.ex = true
        r.kids.push(v)
        return r
    }
    if (name == "randomHex") {
        if (args.length != 1) {
            ckDiag(c, "crypto.randomHex takes (numBytes)", line, col)
            return newCEx(ceBool())
        }
        let v = ckCheckExpr(c, args[0])
        ckCoerce(c, ckExprTy(c, v), mkTy(tvInt()), args[0].line, args[0].col)
        let r = newCEx(ceCryptoRandomHex())
        r.kids.push(v)
        return r
    }
    if (name == "uuid") {
        if (args.length > 0) {
            ckDiag(c, "crypto.uuid takes no arguments", line, col)
            return newCEx(ceBool())
        }
        return newCEx(ceCryptoUuid())
    }
    ckDiag(c, `crypto.${name} is not supported (crypto has sha256, base64Encode, base64Decode, randomHex, uuid)`, line, col)
    return newCEx(ceBool())
} 

// ---------------------------------------------------------------------------
// Calls
// ---------------------------------------------------------------------------

function ckCheckCall(c: Ck, callee: Expr, args: Array<Expr>, line: Int32, col: Int32): CEx {
    // std-module and package functions: `fs.readFile(...)`, `mypkg.fn(...)`
    if (callee.kind == mast.ekMember()) {
        let obj = callee.kids[0]
        let name = callee.sval
        if (obj.kind == mast.ekIdent()) {
            let m = obj.sval
            let isUse = false
            let ui = 0
            while (ui < c.uses.length) {
                if (c.uses[ui] == m) {
                    isUse = true
                    ui = c.uses.length
                } else {
                    ui = ui + 1
                }
            }
            if (isUse) {
                if (m == "net" || m == "http" || m == "sql") {
                    ckDiag(c, `${m}.${name} is not supported yet in the self-hosted compiler`, line, col)
                    return newCEx(ceBool())
                }
                if (m == "fs") {
                    return ckFsModule(c, name, args, line, col)
                }
                if (m == "crypto") {
                    return ckCryptoModule(c, name, args, line, col)
                }
                let full = `${m}__${name}`
                if (ckHasSig(c, full)) {
                    let ident = mast.newExpr(mast.ekIdent(), line, col)
                    ident.sval = full
                    return ckCheckCall(c, ident, args, line, col)
                }
                ckDiag(c, `module '${m}' has no function '${name}'`, line, col)
                return newCEx(ceBool())
            }
        }
        // console.log(...)
        if (obj.kind == mast.ekIdent() && obj.sval == "console") {
            if (name != "log") {
                ckDiag(c, `console.${name} is not supported (only console.log)`, line, col)
            }
            if (args.length != 1) {
                ckDiag(c, "console.log takes exactly one argument", line, col)
                return newCEx(ceBool())
            }
            let a = ckCheckExpr(c, args[0])
            let t = ckExprTy(c, a)
            if (t.k == tvVoid()) {
                ckDiag(c, "cannot print a void value", line, col)
            }
            if (t.k == tvPromise()) {
                ckDiag(c, "cannot print a Promise (await it first)", line, col)
            }
    let r = newCEx(ceConsoleLog())
            r.kids.push(a)
            return r
        }
        // member calls: array methods, string methods
        let oc = ckCheckExpr(c, obj)
        let ot = ckExprTy(c, oc)
        if (ot.k == tvArray()) {
            return ckArrayMethod(c, oc, ot.elem, name, args, line, col)
        }
        if (ot.k == tvStr()) {
            return ckStrMethod(c, oc, name, args, line, col)
        }
        ckDiag(c, `'${name}' is not supported`, line, col)
        return newCEx(ceBool())
    }
    if (callee.kind == mast.ekIdent()) {
        let name = callee.sval
        if (name == "setTimeout") {
            if (args.length != 2) {
                ckDiag(c, "setTimeout takes (callback, milliseconds)", line, col)
                return newCEx(ceBool())
            }
            if (args[0].kind != mast.ekLambda()) {
                ckDiag(c, "setTimeout's first argument must be a lambda: setTimeout(() => { ... }, ms)", args[0].line, args[0].col)
                return newCEx(ceBool())
            }
            let l = args[0].lam
            if (l.params.length != 0) {
                ckDiag(c, "setTimeout callbacks take no parameters", l.line, l.col)
            }
            ckPlainLambda(c, l)
            let idx = c.cbIdx
            let ms = ckCheckExpr(c, args[1])
            if (ckExprTy(c, ms).k != tvInt()) {
                ckDiag(c, "setTimeout's delay must be an Int32", args[1].line, args[1].col)
            }
            let r = newCEx(ceSetTimeout())
            r.id = idx
            r.kids.push(ms)
            return r
        }
        if (ckGenFnIdx(c, name) >= 0) {
            return ckGenericCall(c, name, false, mast.emptyTyAnns(), args, line, col)
        }
        if (ckHasSig(c, name)) {
            let sig = ckSigOf(c, name)
            if (args.length != sig.params.length) {
                ckDiag(c, `function '${name}' takes ${sig.params.length} argument(s), got ${args.length}`, line, col)
            }
            let cargs = emptyCExs()
            let i = 0
            while (i < args.length) {
                let a = ckCheckExpr(c, args[i])
                if (i < sig.params.length) {
                    ckCoerce(c, ckExprTy(c, a), sig.params[i], args[i].line, args[i].col)
                }
                cargs.push(a)
                i = i + 1
            }
            if (sig.hasRet) {
                let r = newCEx(ceCallFn())
                r.sval = name
                r.args = cargs
                r.ty = sig.ret
                r.ex = sig.isAsync
                return r
            }
            ckDiag(c, `cannot call '${name}' here: its return type is not yet known (add a return type annotation, e.g. \`: void\`)`, line, col)
            return newCEx(ceBool())
        }
        // resolver call inside a promise executor?
        ckLookup(c, name, line, col)
        if (c.lookupRes) {
            let id = c.loId
            let ty = c.loTy
            if (ty.k == tvResolver()) {
                let rejected = false
                let ri = 0
                while (ri < c.rejectIds.length) {
                    if (c.rejectIds[ri] == id) {
                        rejected = true
                        ri = c.rejectIds.length
                    } else {
                        ri = ri + 1
                    }
                }
                if (rejected) {
                    ckDiag(c, "'reject' is not supported in marina v0.1 (promises never fail)", line, col)
                    return newCEx(ceBool())
                }
                if (args.length != 1) {
                    ckDiag(c, "resolve takes exactly one value", line, col)
                    return newCEx(ceBool())
                }
                let a = ckCheckExpr(c, args[0])
                let at = ckExprTy(c, a)
                ckInferPromiseType(c, ty.elem, at, line, col)
                let r = newCEx(ceCallResolver())
                r.id = id
                r.kids.push(a)
                r.ty = ty.elem
                return r
            }
            ckDiag(c, `'${name}' is not a function`, line, col)
            return newCEx(ceBool())
        }
        ckDiag(c, `'${name}' is not a function`, line, col)
        return newCEx(ceBool())
    }
    ckDiag(c, "this expression is not callable", line, col)
    return newCEx(ceBool())
}

function ckInferPromiseType(c: Ck, declared: Ty, arg: Ty, line: Int32, col: Int32): void {
    if (!c.pinfHas) {
        c.pinfHas = true
        c.pinfTy = arg
        c.pinfFloat = false
        return
    }
    if (tyEq(c.pinfTy, arg)) {
        return
    }
    if ((c.pinfTy.k == tvInt() && arg.k == tvFloat()) || (c.pinfTy.k == tvFloat() && arg.k == tvInt())) {
        c.pinfTy = mkTy(tvFloat())
        c.pinfFloat = true
        return
    }
    ckCoerce(c, arg, declared, line, col)
}

// ---------------------------------------------------------------------------
// Lambdas
// ---------------------------------------------------------------------------

function ckEnterLambdaScope(c: Ck, lidx: Int32): void {
    c.lambdaBase.push(c.scopes.length)
    c.lambdaIdx.push(lidx)
    c.curCaps.push(newCapt())
    c.lamRetOk.push(false)
    c.scopes.push(newScope())
}

function ckExitLambdaScope(c: Ck): Capt {
    c.scopes.pop()
    c.lambdaBase.pop()
    c.lambdaIdx.pop()
    let caps = c.curCaps[c.curCaps.length - 1]
    c.curCaps.pop()
    c.lamRetOk.pop()
    return caps
}

// setTimeout callback: no params, must return void
function ckPlainLambda(c: Ck, l: Lambda): void {
    let idx = c.lambdas.length
    c.lambdas.push(newCLam(abPlain(), false, l.isAsync))
    ckEnterLambdaScope(c, idx)
    c.hasRet = false
    c.retTy = mkTy(tvVoid())
    c.sawFloatRet = false
    let body = ckCheckStmts(c, l.body)
    let r = c.retTy
    if (!c.hasRet) {
        r = mkTy(tvVoid())
    }
    if (r.k != tvVoid()) {
        ckDiag(c, "setTimeout callbacks cannot return a value", l.line, l.col)
    }
    let caps = ckExitLambdaScope(c)
    let lam = c.lambdas[idx]
    lam.body = body
    let i = 0
    while (i < caps.ids.length) {
        lam.cids.push(caps.ids[i])
        lam.ctys.push(caps.tys[i])
        i = i + 1
    }
    c.cbIdx = idx
}

// new Promise((resolve) => { ... }): infer T from resolve(...) calls
function ckExecutorLambda(c: Ck, l: Lambda): void {
    if (l.params.length == 0 || l.params.length > 2) {
        ckDiag(c, "a promise executor takes (resolve) or (resolve, reject)", l.line, l.col)
        let idx = c.lambdas.length
        c.lambdas.push(newCLam(abPlain(), true, l.isAsync))
        c.cbIdx = idx
        return
    }
    let idx = c.lambdas.length
    c.lambdas.push(newCLam(abPlain(), true, l.isAsync))
    ckEnterLambdaScope(c, idx)

    let prevHas = c.pinfHas
    let prevTy = c.pinfTy
    let prevFloat = c.pinfFloat
    c.pinfHas = false
    c.pinfTy = mkTy(tvVoid())
    c.pinfFloat = false

    let pids = mast.emptyInts()
    let ptys = emptyTys()
    let rejectId = -1
    let i = 0
    while (i < l.params.length) {
        let p = l.params[i]
        let id = ckDeclare(c, p.name, mkResolverTy(mkTy(tvVoid())), true, p.line, p.col)
        if (i == 1) {
            rejectId = id
        }
        pids.push(id)
        ptys.push(mkResolverTy(mkTy(tvVoid())))
        i = i + 1
    }
    let savedRejects = mast.emptyInts()
    let ri = 0
    while (ri < c.rejectIds.length) {
        savedRejects.push(c.rejectIds[ri])
        ri = ri + 1
    }
    if (rejectId >= 0) {
        c.rejectIds.push(rejectId)
    }

    c.hasRet = false
    c.retTy = mkTy(tvVoid())
    c.sawFloatRet = false
    let body = ckCheckStmts(c, l.body)
    let r = c.retTy
    if (!c.hasRet) {
        r = mkTy(tvVoid())
    }
    if (r.k != tvVoid()) {
        ckDiag(c, "a promise executor cannot return a value", l.line, l.col)
    }

    let t = mkTy(tvVoid())
    if (!c.pinfHas) {
        ckDiag(c, "cannot infer the promise value type: the executor never calls resolve (write `resolve(<value>)` inside)", l.line, l.col)
    } else {
        t = c.pinfTy
        if (c.pinfFloat && t.k == tvInt()) {
            t = mkTy(tvFloat())
        }
    }
    c.pinfHas = prevHas
    c.pinfTy = prevTy
    c.pinfFloat = prevFloat
    c.rejectIds = savedRejects

    let lam = c.lambdas[idx]
    let j = 0
    while (j < pids.length) {
        let vt2 = c.varTypes
        vt2[pids[j]] = mkResolverTy(t)
        lam.pids.push(pids[j])
        lam.ptys.push(mkResolverTy(t))
        j = j + 1
    }
    let caps = ckExitLambdaScope(c)
    let k = 0
    while (k < caps.ids.length) {
        lam.cids.push(caps.ids[k])
        lam.ctys.push(caps.tys[k])
        k = k + 1
    }
    lam.body = body
    c.cbIdx = idx
}

// callback lambda for array higher-order methods; result in c.cbIdx / c.cbRet
function ckCallbackLambda(c: Ck, l: Lambda, paramTys: Array<Ty>, hasExpect: bool, expectRet: Ty, abi: Int32): void {
    if (l.params.length != paramTys.length) {
        ckDiag(c, `this callback takes ${paramTys.length} parameter(s), got ${l.params.length}`, l.line, l.col)
    }
    let idx = c.lambdas.length
    c.lambdas.push(newCLam(abi, false, l.isAsync))
    ckEnterLambdaScope(c, idx)
    let lro = c.lamRetOk
    lro[lro.length - 1] = true
    let lam = c.lambdas[idx]
    let i = 0
    while (i < l.params.length && i < paramTys.length) {
        let p = l.params[i]
        let ty = paramTys[i]
        if (p.hasAnn) {
            let at = ckTyOf(c, p.ann)
            ckCoerce(c, ty, at, p.line, p.col)
        }
        let id = ckDeclare(c, p.name, ty, true, p.line, p.col)
        lam.pids.push(id)
        lam.ptys.push(ty)
        i = i + 1
    }
    c.hasRet = false
    c.retTy = mkTy(tvVoid())
    c.sawFloatRet = false
    let savedAsync = c.isAsync
    c.isAsync = l.isAsync
    let body = ckCheckStmts(c, l.body)
    c.isAsync = savedAsync
    let ret = c.retTy
    if (!c.hasRet) {
        ret = mkTy(tvVoid())
    }
    if (c.sawFloatRet && ret.k == tvInt()) {
        ret = mkTy(tvFloat())
    }
    if (hasExpect) {
        ckCoerce(c, ret, expectRet, l.line, l.col)
        ret = expectRet
    }
    let caps = ckExitLambdaScope(c)
    let j = 0
    while (j < caps.ids.length) {
        lam.cids.push(caps.ids[j])
        lam.ctys.push(caps.tys[j])
        j = j + 1
    }
    lam.body = body
    lam.ret = ret
    c.cbIdx = idx
    c.cbRet = ret
}

// ---------------------------------------------------------------------------
// Object / array literals
// ---------------------------------------------------------------------------

// { field: expr, ... }: with a target class id the literal must match
// field-for-field; otherwise a ghost class `Class_{var}_{NNNN}` is created
function ckObjectLit(c: Ck, e: Expr, hasTarget: bool, targetId: Int32, varName: string): CEx {
    let fields = e.names
    let values = e.args
    let line = e.line
    let col = e.col
    if (fields.length == 0) {
        ckDiag(c, "cannot infer the shape of an empty object literal (use `new ClassName()` or annotate a class)", line, col)
        return newCEx(ceBool())
    }
    // check values + duplicate names
    let csNames = mast.emptyStrs()
    let csVals = emptyCExs()
    let i = 0
    while (i < fields.length) {
        let fname = fields[i]
        let dup = false
        let j = 0
        while (j < csNames.length) {
            if (csNames[j] == fname) {
                dup = true
                j = csNames.length
            } else {
                j = j + 1
            }
        }
        let skipO = dup
        let cv = newCEx(ceBool())
        let t = mkTy(tvVoid())
        if (!skipO) {
            cv = ckCheckExpr(c, values[i])
            t = ckExprTy(c, cv)
            if (t.k == tvVoid() || t.k == tvPromise() || t.k == tvResolver()) {
                ckDiag(c, `object fields cannot be ${tyName(t)}`, line, col)
                skipO = true
            }
        }
        if (!skipO) {
            csNames.push(fname)
            csVals.push(cv)
        }
        i = i + 1
    }
    let classId = -1
    if (hasTarget) {
        let def = c.classes[targetId]
        let k = 0
        while (k < def.fnames.length) {
            let fname = def.fnames[k]
            let fty = def.ftys[k]
            let found = false
            let m = 0
            while (m < csNames.length) {
                if (csNames[m] == fname) {
                    ckCoerce(c, ckExprTy(c, csVals[m]), fty, line, col)
                    found = true
                    m = csNames.length
                } else {
                    m = m + 1
                }
            }
            if (!found) {
                ckDiag(c, `missing field '${fname}' for class '${def.name}'`, line, col)
            }
            k = k + 1
        }
        let n = 0
        while (n < csNames.length) {
            let has = false
            let k2 = 0
            while (k2 < def.fnames.length) {
                if (def.fnames[k2] == csNames[n]) {
                    has = true
                    k2 = def.fnames.length
                } else {
                    k2 = k2 + 1
                }
            }
            if (!has) {
                ckDiag(c, `class '${def.name}' has no field '${csNames[n]}'`, line, col)
            }
            n = n + 1
        }
        classId = targetId
    } else {
        let base = varName
        if (base == "") {
            base = "anon"
        }
        let num = c.ghostCount + 1
        let nums = `${num}`
        if (num < 10) { nums = `000${num}` } else if (num < 100) { nums = `00${num}` } else if (num < 1000) { nums = `0${num}` }
        let name = `Class_${base}_${nums}`
        c.ghostCount = num
        let def = new ClassDef()
        def.name = name
        def.fnames = mast.emptyStrs()
        def.ftys = emptyTys()
        def.isGhost = true
        let g = 0
        while (g < csNames.length) {
            def.fnames.push(csNames[g])
            def.ftys.push(ckExprTy(c, csVals[g]))
            g = g + 1
        }
        classId = c.classes.length
        c.classes.push(def)
        c.cbNames.push(name)
        c.cbIds.push(classId)
    }
    // initializers in class-field order (codegen writes by index)
    let def2 = c.classes[classId]
    let r = newCEx(ceObjectLit())
    r.id = classId
    let k3 = 0
    while (k3 < def2.fnames.length) {
        let m3 = 0
        while (m3 < csNames.length) {
            if (csNames[m3] == def2.fnames[k3]) {
                r.iidx.push(k3)
                r.args.push(csVals[m3])
                m3 = csNames.length
            } else {
                m3 = m3 + 1
            }
        }
        k3 = k3 + 1
    }
    return r
}

// [e1, e2, ...]: infer the element type or use the expected element type
function ckArrayLit(c: Ck, elems: Array<Expr>, line: Int32, col: Int32, hasExpected: bool, expected: Ty): CEx {
    if (hasExpected) {
        let cs = emptyCExs()
        let i = 0
        while (i < elems.length) {
            let el = elems[i]
            let cv = ckCheckExpr(c, el)
            let t = ckExprTy(c, cv)
            if (t.k != tvVoid()) {
                ckCoerce(c, t, expected, el.line, el.col)
            }
            cs.push(cv)
            i = i + 1
        }
        let r = newCEx(ceArrayLit())
        r.args = cs
        r.ty = expected
        return r
    }
    let cs = emptyCExs()
    let i = 0
    while (i < elems.length) {
        cs.push(ckCheckExpr(c, elems[i]))
        i = i + 1
    }
    let hasTy = false
    let ty = mkTy(tvInt())
    let sawFloat = false
    let j = 0
    while (j < cs.length) {
        let t = ckExprTy(c, cs[j])
        if (t.k == tvFloat()) {
            sawFloat = true
        }
        let skipA = t.k == tvVoid() || t.k == tvPromise() || t.k == tvResolver()
        if (skipA) {
            ckDiag(c, `arrays cannot contain ${tyName(t)}`, line, col)
        }
        if (!skipA) {
        if (!hasTy) {
            ty = t
            hasTy = true
        } else if (tyEq(ty, t)) {
            ty = t
        } else if (ty.k == tvInt() && t.k == tvFloat()) {
            ty = mkTy(tvFloat())
        } else if (ty.k == tvFloat() && t.k == tvInt()) {
            ty = mkTy(tvFloat())
        } else {
            ckDiag(c, `inconsistent array element types: ${tyName(ty)} and ${tyName(t)}`, line, col)
        }
        }
        j = j + 1
    }
    let elemTy = ty
    if (!hasTy) {
        if (hasExpected) {
            elemTy = expected
        } else {
            ckDiag(c, "cannot infer the element type of an empty array literal (annotate the variable, e.g. `let a: Array<Int32> = []`)", line, col)
            elemTy = mkTy(tvInt())
        }
    } else if (sawFloat && elemTy.k == tvInt()) {
        elemTy = mkTy(tvFloat())
    }
    let r = newCEx(ceArrayLit())
    r.args = cs
    r.ty = elemTy
    return r
}

// ---------------------------------------------------------------------------
// Array / string methods
// ---------------------------------------------------------------------------

function ckStrMethod(c: Ck, s: CEx, name: string, args: Array<Expr>, line: Int32, col: Int32): CEx {
    if (name == "charAt") {
        if (args.length != 1) {
            ckDiag(c, "string.charAt takes (index)", line, col)
            return newCEx(ceBool())
        }
        let i = ckCheckExpr(c, args[0])
        if (ckExprTy(c, i).k != tvInt()) {
            ckDiag(c, "string.charAt index must be Int32", line, col)
        }
        let r = newCEx(ceStrMethod())
        r.opv = smCharAt()
        r.kids.push(s)
        r.args.push(i)
        r.ty = mkTy(tvInt())
        return r
    }
    if (name == "substring") {
        if (args.length != 2) {
            ckDiag(c, "string.substring takes (start, end)", line, col)
            return newCEx(ceBool())
        }
        let r = newCEx(ceStrMethod())
        r.opv = smSubstring()
        r.kids.push(s)
        r.ty = mkTy(tvStr())
        let i = 0
        while (i < args.length) {
            let a = ckCheckExpr(c, args[i])
            if (ckExprTy(c, a).k != tvInt()) {
                ckDiag(c, "string.substring indices must be Int32", line, col)
            }
            r.args.push(a)
            i = i + 1
        }
        return r
    }
    ckDiag(c, `strings have no method '${name}' (available: length, charAt, substring)`, line, col)
    return newCEx(ceBool())
}

function ckArrayMethod(c: Ck, arr: CEx, elem: Ty, name: string, args: Array<Expr>, line: Int32, col: Int32): CEx {
    let bad = name == "push" || name == "unshift" || name == "concat" || name == "join"
    if (bad && args.length != 1) {
        ckDiag(c, `array.${name} takes 1 argument(s), got ${args.length}`, line, col)
    }
    if ((name == "pop" || name == "shift" || name == "reverse" || name == "sort" || name == "length") && args.length != 0) {
        ckDiag(c, `array.${name} takes 0 argument(s), got ${args.length}`, line, col)
    }
    if ((name == "splice" || name == "slice") && args.length != 2) {
        ckDiag(c, `array.${name} takes 2 argument(s), got ${args.length}`, line, col)
    }
    if (name == "push" || name == "unshift") {
        let a = ckCheckExpr(c, args[0])
        ckCoerce(c, ckExprTy(c, a), elem, line, col)
        let r = newCEx(ceArrayOp())
        if (name == "push") {
            r.opv = aoPush()
        } else {
            r.opv = aoUnshift()
        }
        r.kids.push(arr)
        r.args.push(a)
        r.ty = mkTy(tvInt())
        return r
    }
    if (name == "pop" || name == "shift") {
        let r = newCEx(ceArrayOp())
        if (name == "pop") {
            r.opv = aoPop()
        } else {
            r.opv = aoShift()
        }
        r.kids.push(arr)
        r.ty = elem
        return r
    }
    if (name == "splice" || name == "slice") {
        let r = newCEx(ceArrayOp())
        if (name == "splice") {
            r.opv = aoSplice()
        } else {
            r.opv = aoSlice()
        }
        r.kids.push(arr)
        r.ty = mkArrayTy(elem)
        let i = 0
        while (i < args.length) {
            let a = ckCheckExpr(c, args[i])
            if (ckExprTy(c, a).k != tvInt()) {
                ckDiag(c, `array.${name} indices must be Int32`, line, col)
            }
            r.args.push(a)
            i = i + 1
        }
        return r
    }
    if (name == "concat") {
        let a = ckCheckExpr(c, args[0])
        let at = ckExprTy(c, a)
        if (!tyEq(at, mkArrayTy(elem))) {
            ckDiag(c, `concat requires Array<${tyName(elem)}>, found ${tyName(at)}`, line, col)
        }
        let r = newCEx(ceArrayOp())
        r.opv = aoConcat()
        r.kids.push(arr)
        r.args.push(a)
        r.ty = mkArrayTy(elem)
        return r
    }
    if (name == "join") {
        let a = ckCheckExpr(c, args[0])
        ckCoerce(c, ckExprTy(c, a), mkTy(tvStr()), line, col)
        let r = newCEx(ceArrayOp())
        r.opv = aoJoin()
        r.kids.push(arr)
        r.args.push(a)
        r.ty = mkTy(tvStr())
        return r
    }
    if (name == "reverse" || name == "sort") {
        let r = newCEx(ceArrayOp())
        if (name == "reverse") {
            r.opv = aoReverse()
        } else {
            r.opv = aoSort()
        }
        r.kids.push(arr)
        r.ty = mkArrayTy(elem)
        return r
    }
    if (name == "length") {
        let r = newCEx(ceArrayOp())
        r.opv = aoLen()
        r.kids.push(arr)
        r.ty = mkTy(tvInt())
        return r
    }
    if (name == "forEach" || name == "map" || name == "filter" || name == "reduce") {
        let want = 1
        if (name == "reduce") {
            want = 2
        }
        if (args.length != want) {
            ckDiag(c, `array.${name} takes ${want} argument(s), got ${args.length}`, line, col)
            return newCEx(ceBool())
        }
        if (args[0].kind != mast.ekLambda()) {
            ckDiag(c, `${name} takes a callback lambda`, line, col)
            return newCEx(ceBool())
        }
        let l = args[0].lam
        let abi = abForEach()
        let hasExpect = false
        let expectRet = mkTy(tvVoid())
        let ptys = emptyTys()
        if (name == "forEach") {
            abi = abForEach()
            ptys.push(elem)
        } else if (name == "map") {
            abi = abMapFilter()
            ptys.push(elem)
        } else if (name == "filter") {
            abi = abMapFilter()
            ptys.push(elem)
            hasExpect = true
            expectRet = mkTy(tvBool())
        } else {
            let init = ckCheckExpr(c, args[1])
            let uty = ckExprTy(c, init)
            if (uty.k == tvVoid() || uty.k == tvPromise() || uty.k == tvResolver()) {
                ckDiag(c, "reduce initial value must be a plain value", line, col)
                return newCEx(ceBool())
            }
            abi = abReduce()
            ptys.push(uty)
            ptys.push(elem)
            hasExpect = true
            expectRet = uty
            ckCallbackLambda(c, l, ptys, hasExpect, expectRet, abi)
            let idx = c.cbIdx
            let uret = c.cbRet
            let cb = newCEx(ceLambdaVal())
            cb.id = idx
            cb.ty = uret
            let r = newCEx(ceArrayHof())
            r.opv = hofReduce()
            r.kids.push(arr)
            r.kids.push(cb)
            r.args.push(init)
            r.ty = uret
            return r
        }
        ckCallbackLambda(c, l, ptys, hasExpect, expectRet, abi)
        let idx = c.cbIdx
        let uret = c.cbRet
        let cb = newCEx(ceLambdaVal())
        cb.id = idx
        cb.ty = uret
        let r = newCEx(ceArrayHof())
        if (name == "forEach") {
            r.opv = hofForEach()
            cb.ty = mkTy(tvVoid())
            r.ty = mkTy(tvVoid())
        } else if (name == "map") {
            r.opv = hofMap()
            r.ty = mkArrayTy(uret)
        } else {
            r.opv = hofFilter()
            cb.ty = mkTy(tvBool())
            r.ty = mkArrayTy(elem)
        }
        r.kids.push(arr)
        r.kids.push(cb)
        return r
    }
    ckDiag(c, `'${name}' is not supported on arrays (available: push, pop, shift, unshift, splice, slice, concat, join, reverse, sort, length, forEach, map, filter, reduce)`, line, col)
    return newCEx(ceBool())
}

// ---------------------------------------------------------------------------
// Generic call-gen + monomorphization
// ---------------------------------------------------------------------------

function ckCheckCallGen(c: Ck, callee: Expr, typeArgs: Array<TyAnn>, args: Array<Expr>, line: Int32, col: Int32): CEx {
    if (callee.kind != mast.ekIdent()) {
        ckDiag(c, "type arguments are only supported on direct function calls", line, col)
        return newCEx(ceBool())
    }
    let name = callee.sval
    if (ckGenFnIdx(c, name) >= 0) {
        return ckGenericCall(c, name, true, typeArgs, args, line, col)
    }
    if (ckHasSig(c, name)) {
        ckDiag(c, `function '${name}' does not take type parameters`, line, col)
        return newCEx(ceBool())
    }
    ckDiag(c, `unknown function '${name}'`, line, col)
    return newCEx(ceBool())
}

// mangle a concrete type for mono'd names
function ckMangleTy(t: Ty): string {
    if (t.k == tvVoid()) { return "Void" }
    if (t.k == tvInt()) { return "Int32" }
    if (t.k == tvFloat()) { return "Float64" }
    if (t.k == tvBool()) { return "Bool" }
    if (t.k == tvStr()) { return "string" }
    if (t.k == tvStream()) { return "Stream" }
    if (t.k == tvPromise()) { return `Promise$${ckMangleTy(t.elem)}` }
    if (t.k == tvArray()) { return `Array$${ckMangleTy(t.elem)}` }
    if (t.k == tvObject()) {
        let s = t.oname
        let out = ""
        let i = 0
        while (i < s.length) {
            if (s.charAt(i) == 46) {
                out = `${out}$`
            } else {
                out = `${out}${s.substring(i, i + 1)}`
            }
            i = i + 1
        }
        return out
    }
    if (t.k == tvIface()) { return `Iface$${t.iname}` }
    return "Resolver"
}

// build a source annotation from a concrete type (for subst)
function ckToAnn(c: Ck, t: Ty, line: Int32, col: Int32): TyAnn {
    let name = "void"
    let a = mast.newTyAnn(name, line, col)
    if (t.k == tvInt()) { a.name = "Int32" }
    else if (t.k == tvFloat()) { a.name = "Float64" }
    else if (t.k == tvBool()) { a.name = "bool" }
    else if (t.k == tvStr()) { a.name = "string" }
    else if (t.k == tvStream()) { a.name = "Stream" }
    else if (t.k == tvPromise()) {
        a.name = "Promise"
        a.args.push(ckToAnn(c, t.elem, line, col))
    } else if (t.k == tvArray()) {
        a.name = "Array"
        a.args.push(ckToAnn(c, t.elem, line, col))
    } else if (t.k == tvObject()) {
        a.name = t.oname
    } else if (t.k == tvIface()) {
        a.name = t.iname
    }
    return a
}

// replace type-parameter annotations with concrete bindings
function ckSubstAnn(c: Ck, a: TyAnn, bindings: Bindings): void {
    if (a.args.length == 0) {
        let i = 0
        while (i < bindings.names.length) {
            if (bindings.names[i] == a.name) {
                let na = ckToAnn(c, bindings.tys[i], a.line, a.col)
                a.name = na.name
                a.args = na.args
                return
            }
            i = i + 1
        }
        return
    }
    let i = 0
    while (i < a.args.length) {
        ckSubstAnn(c, a.args[i], bindings)
        i = i + 1
    }
}

class Bindings {
    names: Array<string>
    tys: Array<Ty>
    has: Array<bool>
}

function newBindings(): Bindings {
    let b = new Bindings()
    b.names = mast.emptyStrs()
    b.tys = emptyTys()
    let hs: Array<bool> = []
    b.has = hs
    return b
}

// deep-copy helpers for monomorphization (pure clones, then annotation
// substitution over the copies)

function ckCloneAnn(a: TyAnn): TyAnn {
    let n = mast.newTyAnn(a.name, a.line, a.col)
    let i = 0
    while (i < a.args.length) {
        n.args.push(ckCloneAnn(a.args[i]))
        i = i + 1
    }
    return n
}

function ckCloneExpr(e: Expr): Expr {
    let n = mast.newExpr(e.kind, e.line, e.col)
    n.opv = e.opv
    n.ival = e.ival
    n.fval = e.fval
    n.bval = e.bval
    n.sval = e.sval
    let i = 0
    while (i < e.kids.length) {
        n.kids.push(ckCloneExpr(e.kids[i]))
        i = i + 1
    }
    i = 0
    while (i < e.args.length) {
        n.args.push(ckCloneExpr(e.args[i]))
        i = i + 1
    }
    i = 0
    while (i < e.names.length) {
        n.names.push(e.names[i])
        i = i + 1
    }
    i = 0
    while (i < e.targs.length) {
        n.targs.push(ckCloneAnn(e.targs[i]))
        i = i + 1
    }
    i = 0
    while (i < e.parts.length) {
        let src = e.parts[i]
        if (src.isExpr) {
            n.parts.push(mast.newTPartExpr(src.t, ckCloneExpr(src.e), src.line, src.col))
        } else {
            n.parts.push(mast.newTPartStr(src.t))
        }
        i = i + 1
    }
    if (e.kind == mast.ekLambda()) {
        let l = mast.newLambda(e.lam.line, e.lam.col)
        l.isAsync = e.lam.isAsync
        let j = 0
        while (j < e.lam.params.length) {
            let lp = e.lam.params[j]
            let np = mast.newParam(lp.name, lp.line, lp.col)
            np.hasAnn = lp.hasAnn
            if (lp.hasAnn) {
                np.ann = ckCloneAnn(lp.ann)
            }
            l.params.push(np)
            j = j + 1
        }
        let k = 0
        while (k < e.lam.body.length) {
            l.body.push(ckCloneStmt(e.lam.body[k]))
            k = k + 1
        }
        n.lam = l
    }
    return n
}

function ckCloneStmt(s: Stmt): Stmt {
    let n = mast.newStmt(s.kind, s.line, s.col)
    n.name = s.name
    n.field = s.field
    n.isConst = s.isConst
    n.hasE1 = s.hasE1
    n.hasE2 = s.hasE2
    n.hasS1 = s.hasS1
    n.hasS2 = s.hasS2
    n.hasAnn = s.hasAnn
    if (s.hasAnn) {
        n.ann = ckCloneAnn(s.ann)
    }
    if (s.hasE1) {
        n.e1 = ckCloneExpr(s.e1)
    }
    if (s.hasE2) {
        n.e2 = ckCloneExpr(s.e2)
    }
    if (s.hasS1) {
        n.s1 = ckCloneStmt(s.s1)
    }
    if (s.hasS2) {
        n.s2 = ckCloneStmt(s.s2)
    }
    let i = 0
    while (i < s.body.length) {
        n.body.push(ckCloneStmt(s.body[i]))
        i = i + 1
    }
    i = 0
    while (i < s.els.length) {
        n.els.push(ckCloneStmt(s.els[i]))
        i = i + 1
    }
    return n
}

// substitute type-parameter annotations through a cloned tree
function ckSubstAnnDeep(c: Ck, e: Expr, b: Bindings): void {
    let i = 0
    while (i < e.targs.length) {
        ckSubstAnn(c, e.targs[i], b)
        i = i + 1
    }
    i = 0
    while (i < e.kids.length) {
        ckSubstAnnDeep(c, e.kids[i], b)
        i = i + 1
    }
    i = 0
    while (i < e.args.length) {
        ckSubstAnnDeep(c, e.args[i], b)
        i = i + 1
    }
    if (e.kind == mast.ekLambda()) {
        let j = 0
        while (j < e.lam.params.length) {
            if (e.lam.params[j].hasAnn) {
                ckSubstAnn(c, e.lam.params[j].ann, b)
            }
            j = j + 1
        }
        let k = 0
        while (k < e.lam.body.length) {
            ckSubstStmtDeep(c, e.lam.body[k], b)
            k = k + 1
        }
    }
}

function ckSubstStmtDeep(c: Ck, s: Stmt, b: Bindings): void {
    if (s.hasAnn) {
        ckSubstAnn(c, s.ann, b)
    }
    if (s.hasE1) {
        ckSubstAnnDeep(c, s.e1, b)
    }
    if (s.hasE2) {
        ckSubstAnnDeep(c, s.e2, b)
    }
    if (s.hasS1) {
        ckSubstStmtDeep(c, s.s1, b)
    }
    if (s.hasS2) {
        ckSubstStmtDeep(c, s.s2, b)
    }
    let i = 0
    while (i < s.body.length) {
        ckSubstStmtDeep(c, s.body[i], b)
        i = i + 1
    }
    i = 0
    while (i < s.els.length) {
        ckSubstStmtDeep(c, s.els[i], b)
        i = i + 1
    }
}

// clone a generic fn declaration and substitute its annotations
function ckSubstFnDecl(c: Ck, f: FnDecl, b: Bindings): FnDecl {
    let n = mast.newFnDecl(f.name, f.line, f.col)
    n.isAsync = f.isAsync
    let i = 0
    while (i < f.typeParams.length) {
        n.typeParams.push(f.typeParams[i])
        i = i + 1
    }
    i = 0
    while (i < f.params.length) {
        let p = f.params[i]
        let np = mast.newParam(p.name, p.line, p.col)
        np.hasAnn = p.hasAnn
        if (p.hasAnn) {
            np.ann = ckCloneAnn(p.ann)
            ckSubstAnn(c, np.ann, b)
        }
        n.params.push(np)
        i = i + 1
    }
    if (f.hasRet) {
        n.retAnn = ckCloneAnn(f.retAnn)
        ckSubstAnn(c, n.retAnn, b)
        n.hasRet = true
    }
    let j = 0
    while (j < f.body.length) {
        let bs = ckCloneStmt(f.body[j])
        ckSubstStmtDeep(c, bs, b)
        n.body.push(bs)
        j = j + 1
    }
    return n
}

// monomorphize a generic class instantiation; returns the object type
function ckMonoClass(c: Ck, name: string, args: Array<TyAnn>, line: Int32, col: Int32): Ty {
    let gi = ckGenClsIdx(c, name)
    let decl = c.genClsDecls[gi]
    if (args.length != decl.typeParams.length) {
        ckDiag(c, `generic class '${name}' takes ${decl.typeParams.length} type parameter(s), got ${args.length}`, line, col)
        return mkTy(tvVoid())
    }
    let b = newBindings()
    let i = 0
    while (i < decl.typeParams.length) {
        b.names.push(decl.typeParams[i])
        b.tys.push(ckTyOf(c, args[i]))
        b.has.push(true)
        i = i + 1
    }
    let mangled = `${decl.name}$`
    let j = 0
    while (j < b.tys.length) {
        if (j > 0) { mangled = `${mangled}$` }
        mangled = `${mangled}${ckMangleTy(b.tys[j])}`
        j = j + 1
    }
    let existing = ckClassIdOf(c, mangled)
    if (existing >= 0) {
        return mkObjectTy(existing, mangled)
    }
    let def = new ClassDef()
    def.name = mangled
    def.fnames = mast.emptyStrs()
    def.ftys = emptyTys()
    def.isGhost = false
    let k = 0
    while (k < decl.fields.length) {
        let fd = decl.fields[k]
        let dup = false
        let m = 0
        while (m < def.fnames.length) {
            if (def.fnames[m] == fd.name) {
                dup = true
                m = def.fnames.length
            } else {
                m = m + 1
            }
        }
        if (!dup) {
            let a2 = ckCloneAnn(fd.ann)
            ckSubstAnn(c, a2, b)
            def.fnames.push(fd.name)
            def.ftys.push(ckTyOf(c, a2))
        }
        k = k + 1
    }
    let id = c.classes.length
    c.classes.push(def)
    c.cbNames.push(mangled)
    c.cbIds.push(id)
    return mkObjectTy(id, mangled)
}

// check a call to a generic function: infer bindings, mono the body, and
// lower to a call of the mono'd name
function ckGenericCall(c: Ck, name: string, hasTypeArgs: bool, typeArgs: Array<TyAnn>, args: Array<Expr>, line: Int32, col: Int32): CEx {
    let gi = ckGenFnIdx(c, name)
    let decl = c.genFnDecls[gi]
    if (args.length != decl.params.length) {
        ckDiag(c, `function '${name}' takes ${decl.params.length} argument(s), got ${args.length}`, line, col)
        return newCEx(ceBool())
    }
    if (hasTypeArgs && typeArgs.length != decl.typeParams.length) {
        ckDiag(c, `function '${name}' takes ${decl.typeParams.length} type parameter(s), got ${typeArgs.length} type argument(s)`, line, col)
        return newCEx(ceBool())
    }
    let cargs = emptyCExs()
    let argTys = emptyTys()
    let i = 0
    while (i < args.length) {
        let a = ckCheckExpr(c, args[i])
        argTys.push(ckExprTy(c, a))
        cargs.push(a)
        i = i + 1
    }
    // infer bindings from arguments
    let b = newBindings()
    let pi = 0
    while (pi < decl.typeParams.length) {
        b.names.push(decl.typeParams[pi])
        b.tys.push(mkTy(tvVoid()))
        b.has.push(false)
        pi = pi + 1
    }
    let pj = 0
    while (pj < decl.params.length && pj < argTys.length) {
        let p = decl.params[pj]
        if (!p.hasAnn) {
            ckDiag(c, `parameter '${p.name}' of generic function '${name}' needs a type annotation`, p.line, p.col)
        } else {
            ckUnifyAnn(c, p.ann, argTys[pj], b, p.line, p.col)
        }
        pj = pj + 1
    }
    if (hasTypeArgs) {
        let ti = 0
        while (ti < typeArgs.length) {
            let bt = b.tys
            bt[ti] = ckTyOf(c, typeArgs[ti])
            let bh = b.has
            bh[ti] = true
            ti = ti + 1
        }
    }
    let unbound = ""
    let ui = 0
    while (ui < b.has.length) {
        if (!b.has[ui]) {
            if (unbound != "") { unbound = `${unbound}, ` }
            unbound = `${unbound}'${b.names[ui]}'`
        }
        ui = ui + 1
    }
    if (unbound != "") {
        ckDiag(c, `cannot infer type parameter(s) ${unbound} of generic function '${name}' from the call arguments`, line, col)
        return newCEx(ceBool())
    }
    let mangled = `${decl.name}__`
    let mi = 0
    while (mi < b.tys.length) {
        if (mi > 0) { mangled = `${mangled}__` }
        mangled = `${mangled}${ckMangleTy(b.tys[mi])}`
        mi = mi + 1
    }
    // re-check arguments against the substituted parameter types
    if (ckHasSig(c, mangled)) {
        let sig = ckSigOf(c, mangled)
        let ai = 0
        while (ai < cargs.length) {
            if (ai < sig.params.length) {
                ckCoerce(c, argTys[ai], sig.params[ai], args[ai].line, args[ai].col)
            }
            ai = ai + 1
        }
        let r = newCEx(ceCallFn())
        r.sval = mangled
        r.args = cargs
        if (sig.hasRet) {
            r.ty = sig.ret
        } else {
            r.ty = mkTy(tvVoid())
        }
        r.ex = sig.isAsync
        return r
    }
    let subst = ckSubstFnDecl(c, decl, b)
    subst.name = mangled
    // register the signature first when the return is annotated, so
    // recursive generic calls resolve
    let sig2 = new Sig()
    sig2.params = emptyTys()
    sig2.isAsync = subst.isAsync
    sig2.hasRet = false
    sig2.ret = mkTy(tvVoid())
    let k = 0
    while (k < subst.params.length) {
        let p = subst.params[k]
        if (p.hasAnn) {
            sig2.params.push(ckTyOf(c, p.ann))
        } else {
            ckDiag(c, `parameter '${p.name}' of generic function '${subst.name}' needs a type annotation (strict mode)`, p.line, p.col)
            sig2.params.push(mkTy(tvVoid()))
        }
        k = k + 1
    }
    let preHasRet = false
    if (subst.hasRet) {
        sig2.ret = ckTyOf(c, subst.retAnn)
        sig2.hasRet = true
        preHasRet = true
    }
    ckInsertSig(c, mangled, sig2)
    // check_fn mid-function: save + restore the in-progress fn context
    let savedHasRet = c.hasRet
    let savedRetTy = c.retTy
    let savedFloat = c.sawFloatRet
    let savedAsync = c.isAsync
    let savedToplevel = c.inToplevel
    let savedPinfHas = c.pinfHas
    let savedPinfTy = c.pinfTy
    let savedPinfFloat = c.pinfFloat
    let cf = ckCheckFn(c, subst)
    c.hasRet = savedHasRet
    c.retTy = savedRetTy
    c.sawFloatRet = savedFloat
    c.isAsync = savedAsync
    c.inToplevel = savedToplevel
    c.pinfHas = savedPinfHas
    c.pinfTy = savedPinfTy
    c.pinfFloat = savedPinfFloat
    let ret = cf.ret
    c.monoFns.push(cf)
    if (!preHasRet) {
        let sig3 = new Sig()
        sig3.params = sig2.params
        sig3.ret = ret
        sig3.hasRet = true
        sig3.isAsync = subst.isAsync
        ckInsertSig(c, mangled, sig3)
    }
    let r = newCEx(ceCallFn())
    r.sval = mangled
    r.args = cargs
    r.ty = ret
    r.ex = subst.isAsync
    return r
}

// unify a parameter annotation against an argument type, binding type params
function ckUnifyAnn(c: Ck, ann: TyAnn, actual: Ty, b: Bindings, line: Int32, col: Int32): void {
    if (ann.args.length == 0) {
        let i = 0
        while (i < b.names.length) {
            if (b.names[i] == ann.name) {
                if (!b.has[i]) {
                    let bt2 = b.tys
                    bt2[i] = actual
                    let bh2 = b.has
                    bh2[i] = true
                } else {
                    let prev = b.tys[i]
                    if (!tyEq(prev, actual) && !(prev.k == tvInt() && actual.k == tvFloat())) {
                        ckDiag(c, `type parameter '${b.names[i]}' is bound to ${tyName(actual)} here but ${tyName(prev)} elsewhere`, line, col)
                    }
                }
                return
            }
            i = i + 1
        }
        return
    }
    if (ann.name == "Array" && ann.args.length > 0 && actual.k == tvArray()) {
        ckUnifyAnn(c, ann.args[0], actual.elem, b, line, col)
        return
    }
    if (ann.name == "Promise" && ann.args.length > 0 && actual.k == tvPromise()) {
        ckUnifyAnn(c, ann.args[0], actual.elem, b, line, col)
        return
    }
    let expected = ckTyOf(c, ann)
    ckCoerce(c, actual, expected, line, col)
} 
