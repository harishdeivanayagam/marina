// comp.tsm — self-hosted marina compiler driver.
//
// Usage: comp <file.tsm>
// Lexes, parses, checks and generates LLVM IR for the given source file,
// writing the result to ./out.ll (diff against the Rust compiler's .ll).
//
//   WAVE_REGISTRY=selfhost/registry cargo run -q -p wave -- build selfhost/comp.tsm
//   ./.marina/comp examples/hello-world.tsm
//   diff out.ll .marina/hello-world.ll

use malex
use mpars
use mchek
use mgen
use fs

async function main() {
    let a = fs.args()
    if (a.length < 2) {
        console.log(`usage: comp <file.tsm>`)
        return
    }
    let src = await fs.readFile(a[1])
    let lr = malex.lex(src)
    if (!lr.ok) {
        console.log(`LEXERR ${lr.msg} @${lr.line}:${lr.col}`)
        return
    }
    let pr = mpars.parse(lr.toks)
    if (!pr.ok) {
        console.log(`PARSEERR ${pr.msg} @${pr.line}:${pr.col}`)
        return
    }
    let r = mchek.ckCheck(pr.prog)
    if (!r.ok) {
        let i = 0
        while (i < r.msgs.length) {
            console.log(`DIAG ${r.msgs[i]} @${r.dlines[i]}:${r.dcols[i]}`)
            i = i + 1
        }
        return
    }
    let ll = mgen.generate(r)
    await fs.writeFile("./out.ll", ll)
}