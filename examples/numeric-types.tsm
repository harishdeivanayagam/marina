function add8(x: Int8, y: Int8): Int8 {
    return x + y
}

function main() {
    let a = 10
    let b: Int8 = -12
    let c: Int16 = 300
    let d: Int64 = 3000000000
    let e: UInt8 = 255
    let f: UInt16 = 65535
    let g: UInt32 = 4000000000
    let h: UInt64 = 18446744073709551615
    let lo: Int64 = -9223372036854775808
    let x: Float32 = 1.5
    let y = 2.5

    console.log(a)
    console.log(b)
    console.log(c)
    console.log(d)
    console.log(e)
    console.log(f)
    console.log(g)
    console.log(h)
    console.log(lo)
    console.log(x)
    console.log(y)
    console.log(add8(b, 3))
    console.log(e + 1)
    console.log(x + 1.0)
    console.log(a + y)

    let xs: Array<Int8> = [1, -3, 2]
    console.log(xs)
    let big: Array<UInt64> = [18446744073709551615, 1]
    big.sort()
    console.log(big)
}
