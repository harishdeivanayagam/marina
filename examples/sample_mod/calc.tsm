export class Calc {

    private a: Int32
    private b: Int32

    constructor(a: Int32, b: Int32) {
        this.a = a
        this.b = b
    }

    add(): Int32 {
        return this.a + this.b
    }

    sub(): Int32 {
        return this.a - this.b
    }

    mul(): Int32 {
        return this.a * this.b
    }

    div(): Float64 {
        return this.a / this.b
    }
}
