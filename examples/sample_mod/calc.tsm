export class Calc {
    
    private a: Int32
    private b: Int32

    constructor(a: Int32, b: Int32) {
        this.a = a
        this.b = b
    }

    add() {
        return this.a + this.b
    }

    sub() {
        return this.a - this.b
    }

    mul() {
        return this.a * this.b
    }
    
    div() {
        return this.a / this.b
    }
}
