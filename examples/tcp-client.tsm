use net

// Raw TCP: connect, write, read the reply back, close.
// Try it against anything that echoes: `nc -l 8080` in another terminal.
async function main() {
    let s = await net.connect("localhost", 8080)
    await s.write("ping")
    let reply = await s.read_all()
    console.log(reply)
    await s.close()
}
