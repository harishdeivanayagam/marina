// Interfaces: structural data contracts, checked at compile time.
// Field access is resolved by name at runtime so any conforming object works.

interface Point {
    x: Int32,
    y: Int32,
    name: string,
}

interface Named {
    name: string,
}

// Ghost classes (object literals) conform structurally.
let p = { x: 1, y: 2, name: "origin" };

// A method on the interface: any conforming class must have a public method
// with the same name and signature. Calls dispatch on the runtime class.
interface Titled {
    title(): string,
}

// Declared classes conform too: extra fields are allowed.
class Vehicle {
    name: string,
    wheels: Int32,

    private secret(): string {
        return "hidden"
    }

    title(): string {
        return `${this.secret()}:${this.name}`
    }
}

class Place {
    name: string,

    title(): string {
        return `place ${this.name}`
    }
}

function describe(pt: Point): string {
    return `${pt.name}: ${pt.x}, ${pt.y}`;
}

function label(n: Named): string {
    return `called ${n.name}`;
}

function show(t: Titled): string {
    return t.title();
}

function main() {
    console.log(describe(p));

    let car = new Vehicle();
    car.name = "bolt";
    car.wheels = 4;
    console.log(label(car));

    // write through an interface
    let q = { x: 5, y: 6, name: "q" };
    q.name = "point-q";
    console.log(describe(q));

    // interface values can be collected in arrays of a shared interface type
    let shapes: Array<Named> = [p, q, car];
    for (let i = 0; i < shapes.length; i++) {
        console.log(label(shapes[i]));
    }

    console.log(show(car));
    let dock = new Place();
    dock.name = "harbor";
    console.log(show(dock));
    let titled: Array<Titled> = [car, dock];
    for (let i = 0; i < titled.length; i++) {
        console.log(show(titled[i]));
    }
}