// The fs and crypto standard libraries.
// fs calls are async now: `await` them (main is async).
import fs
import crypto

async function main() {
    // --- filesystem ---
    let path = "/tmp/marina-fs-demo.txt";
    await fs.writeFile(path, "hello from marina");
    let exists = await fs.exists(path);
    console.log(exists);

    let data = await fs.readFile(path);
    console.log(data);

    await fs.mkdir("/tmp/marina-fs-demo-dir");
    await fs.writeFile("/tmp/marina-fs-demo-dir/nested.txt", "nested");
    let entries = await fs.readDir("/tmp/marina-fs-demo-dir");
    console.log(entries.length);
    console.log(entries[0]);

    await fs.remove(path);
    let gone = await fs.exists(path);
    console.log(gone);
    await fs.remove("/tmp/marina-fs-demo-dir");

    // --- crypto (pure computation, still synchronous) ---
    console.log(crypto.sha256("hello"));
    console.log(crypto.base64Encode("marina"));
    console.log(crypto.base64Decode("bWFyaW5h"));

    let key = crypto.randomHex(8);
    console.log(key.length);

    let id = crypto.uuid();
    console.log(id.length);
}
